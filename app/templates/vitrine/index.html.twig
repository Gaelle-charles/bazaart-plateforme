{#
    Le JS hamburger mobile est maintenant géré par base.html.twig (script IIFE).
    Ce bloc n'a plus de script propre — {{ parent() }} suffit pour hériter
    des scripts nav (hamburger + dropdown avatar) déclarés dans base.html.twig.
#}
{% block javascripts %}
{{ parent() }}
{#
    SCRIPT SCROLL-EXPAND DU HERO
    ============================
    Technique non-bloquante : la section .lp-hero fait 200vh.
    A l'interieur, .lp-hero__sticky est en position:sticky; top:0; height:100vh.
    Le JS calcule progress = scroll relatif dans la section (0 -> 1) et
    interpole opacity/scale/translateX en consequence.
    L'utilisateur scrolle NORMALEMENT — aucun hijacking de la molette.
    Performances :
    - requestAnimationFrame : calculs cales sur le refresh navigateur (60fps max)
    - scroll listener passive:true : scroll natif non bloque
    - On n'anime QUE transform et opacity (zero reflow, couches GPU pre-allouees)

    Accessibilite :
    - prefers-reduced-motion : on sort immediatement, le CSS @media gere l'etat fixe

    Mobile :
    - amplitudes reduites sur mobile (< 768px) pour eviter saccades iOS
    - la section hero fait 180vh sur mobile (vs 200vh desktop)
#}
<script>
(function () {
    'use strict';

    /* ── 1. ACCESSIBILITE : prefers-reduced-motion ──────────────────────────
       Si l'utilisateur a active "Reduire les animations" dans son OS,
       on sort immediatement. Le CSS @media (prefers-reduced-motion) gere
       l'affichage statique (video visible, titre immobile, CTAs accessibles). */
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return;
    }

    /* ── 2. REFERENCES DOM ──────────────────────────────────────────────────
       On recupere une seule fois tous les elements qu'on va animer.
       Si l'un d'eux est absent (page sans hero), on sort proprement. */
    var section    = document.querySelector('.lp-hero');
    var sticky     = document.querySelector('.lp-hero__sticky');
    var bg         = document.querySelector('.lp-hero__bg');
    var videoWrap  = document.querySelector('.lp-hero__video-wrap');
    var titleLeft  = document.querySelector('.lp-hero__title-left');
    var titleRight = document.querySelector('.lp-hero__title-right');
    var desc       = document.querySelector('.lp-hero__desc');
    var ctasReveal = document.querySelector('.lp-hero__ctas-reveal');

    /* Sortie propre si un element est manquant */
    if (!section || !sticky || !bg || !videoWrap || !titleLeft || !titleRight) {
        return;
    }

    /* ── 3. PARAMETRES DE L'ANIMATION ──────────────────────────────────────
       Tous les parametres sont centralises ici pour faciliter les reglages.

       ECHELLE VIDEO :
       - scaleStart : taille initiale de la video (28% de l'espace sticky)
         Visuellement : un petit rectangle arrondi au centre de l'ecran.
       - scaleEnd   : taille finale (110% = legerement plus grand que l'ecran,
         overflow:hidden sur .lp-hero__sticky coupe les bords). */
    var SCALE_START  = 0.28;
    var SCALE_END    = 1.10;

    /* ECARTEMENT DU TITRE (pixels) :
       - titleSpread : de combien de pixels chaque partie du titre s'ecarte
         (gauche vers la gauche, droite vers la droite).
       - Sur mobile (<= 768px), amplitude reduite de moitie pour eviter
         que le titre sorte de l'ecran sur les petits viewports. */
    var TITLE_SPREAD_DESKTOP = 180; /* pixels */
    var TITLE_SPREAD_MOBILE  = 80;  /* pixels */

    /* SEUIL D'APPARITION DES CTAS :
       Les CTAs commencent a apparaitre quand progress atteint ce seuil
       et sont completement visibles a progress = 1. */
    var CTA_FADE_START = 0.75;

    /* ── 4. UTILITAIRES ─────────────────────────────────────────────────────

       clamp(val, min, max) : borne une valeur entre min et max.
       Equivalent de Math.min(max, Math.max(min, val)).
       On l'ecrit a la main pour compatibilite max sans polyfill. */
    function clamp(val, min, max) {
        return val < min ? min : (val > max ? max : val);
    }

    /* lerp(a, b, t) : interpolation lineaire entre a et b pour t dans [0,1].
       A t=0 retourne a, a t=1 retourne b, a t=0.5 retourne le milieu.
       Utilise pour toutes les transitions de l'animation. */
    function lerp(a, b, t) {
        return a + (b - a) * t;
    }

    /* ── 5. VARIABLES D'ETAT (boucle rAF) ──────────────────────────────────
       rafId : identifiant rAF en cours (null = pas de requete en attente).
       lastScrollY : derniere position traitee (optimisation : evite les
       recalculs si le scroll n'a pas change depuis la derniere frame). */
    var rafId    = null;
    var lastY    = -1;
    var isMobile = window.innerWidth <= 768;

    /* ── 6. FONCTION DE MISE A JOUR ─────────────────────────────────────────
       Calcule la progression (0 -> 1) et applique les transformations.
       Appelee via requestAnimationFrame -> toujours synchronisee avec
       le refresh du navigateur (jamais entre deux frames). */
    function update() {
        rafId = null; /* libere le slot rAF pour la prochaine requete */

        var scrollY = window.scrollY || window.pageYOffset;

        /* Optimisation : si la position n'a pas change, rien a faire */
        if (scrollY === lastY) { return; }
        lastY = scrollY;

        /* CALCUL DE LA PROGRESSION ─────────────────────────────────────────
           La section fait 200vh (180vh sur mobile).
           sectionTop    : position Y du haut de la section dans la page
           sectionHeight : hauteur totale de la section (200vh ou 180vh)
           trackLength   : distance de scroll utile = sectionHeight - viewportHeight
                           (quand on a scroll de trackLength pixels depuis sectionTop,
                            on est a la fin de la piste, progress = 1)

           progress = (scrollY - sectionTop) / trackLength
           clampee entre 0 et 1 pour eviter les valeurs negatives ou > 1. */
        var rect        = section.getBoundingClientRect();
        /* getBoundingClientRect().top est relatif au viewport.
           Pour avoir la position absolue dans la page, on ajoute scrollY. */
        var sectionTop  = rect.top + scrollY;
        var trackLength = section.offsetHeight - window.innerHeight;

        /* Protection contre une hauteur de section incorrecte (valeur aberrante) */
        if (trackLength <= 0) { return; }

        var raw      = (scrollY - sectionTop) / trackLength;
        var progress = clamp(raw, 0, 1);

        /* AMPLITUDE DU TITRE selon la taille d'ecran */
        var spread = isMobile ? TITLE_SPREAD_MOBILE : TITLE_SPREAD_DESKTOP;

        /* ── APPLICATION DES TRANSFORMATIONS ──────────────────────────────
           On n'ecrit dans le DOM QUE si la section est visible
           (progress entre 0 et 1) pour eviter des ecritures inutiles
           quand on est tres loin de la section. */

        /* 1. Image de fond : opacity 1 -> 0
              Elle disparait completement sur la premiere moitie du scroll.
              On multiplie progress par 2 et on clampe pour accelerer la disparition. */
        var bgOpacity = clamp(1 - progress * 2, 0, 1);
        bg.style.opacity = bgOpacity;

        /* 2. Video : scale(SCALE_START) -> scale(SCALE_END)
              Le scale est interpole lineairement avec progress. */
        var scale = lerp(SCALE_START, SCALE_END, progress);
        videoWrap.style.transform = 'scale(' + scale + ')';

        /* 3. Titre gauche : translateX(0) -> translateX(-spread px)
              La partie gauche du titre part vers la GAUCHE. */
        var txLeft = lerp(0, -spread, progress);
        titleLeft.style.transform = 'translateX(' + txLeft + 'px)';

        /* 4. Titre droit + sous-titre : translateX(0) -> translateX(+spread px)
              La partie droite et le sous-titre partent vers la DROITE. */
        var txRight = lerp(0, spread, progress);
        titleRight.style.transform = 'translateX(' + txRight + 'px)';
        if (desc) { desc.style.transform = 'translateX(' + txRight + 'px)'; }

        /* 5. CTAs : opacity 0 -> 1 quand progress > CTA_FADE_START
              On normalise progress sur la plage [CTA_FADE_START, 1]. */
        if (ctasReveal) {
            var ctaProgress = clamp((progress - CTA_FADE_START) / (1 - CTA_FADE_START), 0, 1);
            ctasReveal.style.opacity = ctaProgress;
            /* pointer-events : active les clics uniquement quand partiellement visible */
            ctasReveal.style.pointerEvents = ctaProgress > 0.1 ? 'auto' : 'none';
        }
    }

    /* ── 7. LISTENER SCROLL ─────────────────────────────────────────────────
       On ne calcule PAS directement dans le listener scroll (peut se declencher
       des dizaines de fois par seconde). On planifie un rAF a la place :
       - si un rAF est deja en attente (rafId !== null), on l'ignore
         (une seule mise a jour par frame de rendu).
       - passive:true -> le navigateur sait qu'on ne bloquera jamais le scroll. */
    function onScroll() {
        if (rafId === null) {
            rafId = window.requestAnimationFrame(update);
        }
    }

    /* Mise a jour de isMobile si la fenetre est redimensionnee */
    function onResize() {
        isMobile = window.innerWidth <= 768;
        onScroll(); /* recalculer immediatement */
    }

    /* ── 8. INITIALISATION ──────────────────────────────────────────────────
       On branche les listeners et on calcule l'etat initial.
       (scrollY peut deja etre > 0 si la page est rechargee avec une ancre
        ou via Turbo — on doit appliquer l'animation immediatement). */
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize, { passive: true });

    /* Calcul initial */
    onScroll();

    /* ── 9. NETTOYAGE TURBO ─────────────────────────────────────────────────
       Si Symfony UX Turbo est actif (navigation SPA-like), les scripts ne
       se re-executent pas mais le DOM change. On retire les listeners
       avant chaque navigation pour eviter les fuites memoire. */
    document.addEventListener('turbo:before-visit', function () {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        if (rafId !== null) { window.cancelAnimationFrame(rafId); }
    }, { once: true });

}()); /* IIFE : portee locale -> pas de variable globale */
</script>
{% endblock %}
