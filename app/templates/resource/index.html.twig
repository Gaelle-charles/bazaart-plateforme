{% extends 'base_app.html.twig' %}

{#
 # resource/index.html.twig — Catalogue des ressources / opportunités
 #
 # Thème : Street (app connectée)
 # Refonte : double vue Liste + Grille, switcher JS, header géant, filtres inline
 #
 # Polices :
 #   var(--display) = Archivo Black  → titres, eyebrow, grands formats
 #   var(--body)    = Space Grotesk  → texte courant
 #   var(--mono)    = JetBrains Mono → labels, badges, méta
 #
 # Palette :
 #   var(--bg)      = #F2EFE6  fond sable
 #   var(--ink)     = #0D0D0D  quasi-noir principal
 #   var(--accent)  = #C6F24E  lime
 #   var(--accent-2)= #FF6B2C  orange (urgence)
 #
 # Design : border-radius 0 partout, pas d'ombres, bordures 1px solid var(--ink)
 #
 # Variables Twig disponibles :
 #   resources           — tableau de Resource (uniquement la page courante, 12 max)
 #   types               — tableau de ResourceType pour le select
 #   disciplines         — tableau de Discipline pour le select
 #   currentSearch       — string (filtre texte actif, paramètre URL "q")
 #   currentTypeId       — int|null (filtre type actif)
 #   currentDisciplineId — int|null (filtre discipline actif)
 #   currentPage         — int (page courante, 1-based)
 #   totalPages          — int (nombre total de pages)
 #   total               — int (nombre total de résultats tous filtres confondus)
 #
 # Chaque resource expose :
 #   .id, .title, .deadline (DateTimeInterface|null — utilisé avec |date('d M Y'))
 #   .resourceType (nullable, .name), .disciplines (Collection, .name)
 #   .organization (nullable, .name), .location (string|null)
 #}

{% block title %}Opportunites — Bazaart{% endblock %}
{% block page_title %}Opportunites{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* =====================================================================
       CATALOGUE OPPORTUNITES — styles thème Street
       Toutes les valeurs passent par les variables CSS du design-tokens.css.
       Aucune couleur ni police en dur : on utilise var(--...) pour que le
       design system puisse évoluer sans toucher aux templates.
    ===================================================================== */

    /* ── En-tête de section ──────────────────────────────────────────── */

    /* Zone d'en-tête principale : titre géant + compteur + contrôles vue */
    .opp-header {
        padding-top: 32px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--ink);
    }

    /* Ligne flex : gauche = eyebrow + titre géant, droite = bouton alerte + switcher */
    .opp-header__row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: var(--space-lg);
        flex-wrap: wrap;
    }

    /* Colonne droite : regroupe le bouton alerte et le switcher de vue */
    .opp-header__controls {
        display: flex;
        align-items: center;
        gap: var(--space-md);
        flex-shrink: 0;
    }

    /* Sur-titre eyebrow : ■ mono uppercase, compteur intégré */
    .opp-eyebrow {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-bottom: 8px;
    }

    /* Titre principal : clamp fluid typography
       Valeurs demandées dans le prototype : 64px min, 9vw idéal, 132px max */
    .opp-title {
        font-family: var(--display);
        font-size: clamp(64px, 9vw, 132px);
        line-height: 0.88;
        text-transform: uppercase;
        color: var(--ink);
        margin: 8px 0 0;
    }

    /* ── Switcher vue Liste / Grille ─────────────────────────────────── */

    /* Les deux boutons collés côte à côte, bordure commune */
    .view-switcher {
        display: inline-flex;
        border: 1px solid var(--ink);
    }

    /* Chaque bouton du switcher : fond transparent par défaut */
    .view-switcher__btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 8px 14px;
        background: transparent;
        color: var(--ink);
        border: none;
        border-right: 1px solid var(--ink);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background var(--transition-fast), color var(--transition-fast);
    }

    /* Supprime la bordure droite du dernier bouton (sinon double bordure) */
    .view-switcher__btn:last-child {
        border-right: none;
    }

    /* Survol : fond lime = signal interactif Street */
    .view-switcher__btn:hover {
        background: var(--accent);
        color: var(--ink);
    }

    /* ── Barre de filtres ────────────────────────────────────────────── */

    /* Fond légèrement différent + bordure basse = zone fonctionnelle distincte de la page */
    .filter-bar {
        background: var(--bg-alt);
        border-bottom: 1px solid var(--ink);
        display: flex;
        align-items: stretch;
        flex-wrap: wrap;
        gap: 0;
        margin-bottom: 0;
    }

    /* Champ recherche : flex:1 pour prendre le maximum d'espace */
    .filter-bar__search {
        flex: 1;
        min-width: 200px;
        padding: 12px 16px;
        background: transparent;
        border: none;
        border-right: 1px solid var(--line-soft);
        font-family: var(--body);
        font-size: 14px;
        color: var(--ink);
        outline: none;
    }

    .filter-bar__search::placeholder {
        color: var(--ink-mute);
    }

    /* Selects disciplines et types : même padding que le champ recherche, fond transparent */
    .filter-bar__select {
        padding: 12px 16px;
        background: transparent;
        border: none;
        border-right: 1px solid var(--line-soft);
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink);
        outline: none;
        cursor: pointer;
    }

    /* Bouton FILTRER : fond encre, texte accent = style CTA primaire Street */
    .filter-bar__submit {
        padding: 12px 24px;
        background: var(--ink);
        color: var(--accent);
        border: none;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background var(--transition-fast), color var(--transition-fast);
        white-space: nowrap;
    }

    .filter-bar__submit:hover {
        background: var(--accent);
        color: var(--ink);
    }

    /* ── Compteur de résultats ───────────────────────────────────────── */

    .results-count {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: .08em;
        color: var(--ink-mute);
        text-transform: uppercase;
        padding: var(--space-md) 0;
        border-bottom: 1px solid var(--line-soft);
        margin-bottom: var(--space-md);
    }

    /* ── VUE LISTE ───────────────────────────────────────────────────── */

    /* Conteneur liste : sans fond propre, bordure top = démarcation avec les filtres */
    .view-list {
        border-top: 1px solid var(--ink);
    }

    /* Chaque ligne de liste : lien cliquable sur toute la surface */
    .list-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 24px;
        border-bottom: 1px solid var(--ink);
        background: transparent;
        color: var(--ink);
        text-decoration: none;
        transition: background var(--transition-fast);
        gap: var(--space-lg);
    }

    /* Survol : fond bg-alt (gris sable léger) = feedback interactif discret */
    .list-card:hover {
        background: var(--bg-alt);
    }

    /* Colonne gauche : contient badges + titre + méta organisateur/lieu */
    .list-card__left {
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
        min-width: 0; /* nécessaire pour que l'ellipse de titre fonctionne */
    }

    /* Ligne de badges (type + disciplines) */
    .list-card__badges {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
    }

    /* Badge type : fond accent lime + texte encre = chip principal visible */
    .badge-type {
        display: inline-block;
        padding: 3px 8px;
        background: var(--accent);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    /* Badge discipline : bordure légère, transparent */
    .badge-disc {
        display: inline-block;
        padding: 3px 8px;
        background: transparent;
        border: 1px solid var(--ink-mute);
        color: var(--ink-mute);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .04em;
    }

    /* Titre de la card liste : display, taille h2 réduite pour la vue compacte */
    .list-card__title {
        font-family: var(--display);
        font-size: 22px;
        line-height: 1.1;
        color: var(--ink);
        /* Ellipse sur 2 lignes max pour les titres très longs */
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
    }

    /* Méta : organisation + lieu séparés par un point médian */
    .list-card__meta {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-mute);
        letter-spacing: .04em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Colonne droite : deadline (badge urgent ou texte simple) */
    .list-card__right {
        text-align: right;
        flex-shrink: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 6px;
    }

    /* Badge URGENT : fond orange, texte encre = alerte visuelle forte */
    .badge-urgent {
        display: inline-block;
        padding: 3px 8px;
        background: var(--accent-2);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    /* Texte deadline en mono discret */
    .deadline-text {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-mute);
        white-space: nowrap;
    }

    /* Deadline sur une card urgente passe en orange pour cohérence */
    .deadline-text--urgent {
        color: var(--accent-2);
        font-weight: 700;
    }

    /* ── VUE GRILLE ──────────────────────────────────────────────────── */

    /* Grille 3 colonnes, bordures partagées = style tableau éditorial */
    .view-grid {
        display: none; /* masquée par défaut, activée par JS */
        grid-template-columns: 1fr 1fr 1fr;
        border: 1px solid var(--ink);
    }

    /* Sur tablette : 2 colonnes */
    @media (max-width: 900px) {
        .view-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* Sur mobile : 1 colonne */
    @media (max-width: 580px) {
        .view-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Card grille : flex colonne, bordures droite + bas partagées */
    .grid-card {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 24px 20px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        background: transparent;
        color: var(--ink);
        text-decoration: none;
        transition: background var(--transition-fast);
    }

    /* Survol grille : lime = signal fort, cohérent avec la grille de la page vitrine */
    .grid-card:hover {
        background: var(--accent);
    }

    /* Titre dans la grille : taille réduite vs header mais toujours display */
    .grid-card__title {
        font-family: var(--display);
        font-size: 20px;
        line-height: 1.1;
        color: var(--ink);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0;
        flex: 1;
    }

    /* Deadline dans la card grille */
    .grid-card__deadline {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-mute);
        margin-top: auto;
    }

    /* ── Etat vide ───────────────────────────────────────────────────── */

    /* Zone vide encadrée style éditorial : encre, fond sable, centré */
    .empty-state {
        border: 1px solid var(--ink);
        padding: var(--space-3xl) var(--space-2xl);
        text-align: center;
        background: var(--bg);
    }

    /* Grand numéro décoratif grisé = esthétique caractéristique du thème Street */
    .empty-state__icon {
        font-family: var(--display);
        font-size: 80px;
        color: var(--ink-mute);
        opacity: .2;
        line-height: 1;
        margin-bottom: var(--space-md);
    }

    .empty-state__title {
        font-family: var(--display);
        font-size: 24px;
        text-transform: uppercase;
        color: var(--ink);
        margin-bottom: var(--space-sm);
    }

    .empty-state__text {
        font-family: var(--body);
        font-size: 14px;
        color: var(--ink-mute);
        line-height: 1.6;
        margin-bottom: var(--space-lg);
    }

    /* CTA état vide : bouton accent plein */
    .empty-state__cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: var(--btn-padding);
        background: var(--accent);
        color: var(--ink);
        border: 2px solid var(--ink);
        font-family: var(--body);
        font-size: var(--btn-font-size);
        font-weight: var(--btn-font-weight);
        letter-spacing: var(--btn-letter-spacing);
        text-transform: uppercase;
        text-decoration: none;
        transition: background var(--transition-fast), color var(--transition-fast);
    }

    .empty-state__cta:hover {
        background: var(--ink);
        color: var(--accent);
    }

    /* ── Pagination ──────────────────────────────────────────────────── */

    /* Centrage et espacement vertical du bloc de pagination */
    .pagination-wrap {
        margin-top: var(--space-xl);
        display: flex;
        justify-content: center;
    }

    /* Ligne de boutons sans gap (bordures partagées = style Street) */
    .pagination-wrap .pagination {
        display: inline-flex;
        border: 1px solid var(--ink);
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 0;
    }

    .pagination-wrap .page-item .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 var(--space-sm);
        border-right: 1px solid var(--ink);
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 700;
        color: var(--ink);
        text-decoration: none;
        background: transparent;
        transition: background var(--transition-fast), color var(--transition-fast);
    }

    /* Supprime la bordure droite en double sur le dernier élément */
    .pagination-wrap .page-item:last-child .page-link {
        border-right: none;
    }

    /* Page active : fond encre + texte accent = item sélectionné */
    .pagination-wrap .page-item.active .page-link {
        background: var(--ink);
        color: var(--accent);
    }

    /* Survol pagination : fond lime */
    .pagination-wrap .page-item .page-link:hover {
        background: var(--accent);
        color: var(--ink);
    }

    /* Page désactivée (prev sur page 1, next sur dernière page) */
    .pagination-wrap .page-item.disabled .page-link {
        opacity: .35;
        pointer-events: none;
    }

    /* ── Logo miniature dans les cartes (liste et grille) ──────────────────
       .card-logo         : conteneur carré à taille FIXE — l'image source peut
                           avoir n'importe quel ratio, elle sera contenue dedans
                           (object-fit: contain) sans jamais être déformée.
       .card-logo img     : règle de rendu de l'image à l'intérieur.
       .card-logo--bazaart: variante utilisée quand logoUrl est absent ou cassé —
                           on affiche le favicon Bazaart avec un fond légèrement
                           différent pour signaler le repli. */

    /* Conteneur logo : 48×48 px, fond blanc neutre, bordure douce, coins francs
       (border-radius: 0 → cohérence thème Street "zéro radius") */
    .card-logo {
        width: 48px;
        height: 48px;
        min-width: 48px; /* évite que flexbox rétrécisse le carré */
        background: #ffffff;
        border: 1px solid var(--line-soft);
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Image à l'intérieur : object-fit: contain = l'image est réduite pour
       tenir dans le carré, jamais rognée, jamais étirée. display:block élimine
       le gap de ligne induit par inline-block. */
    .card-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    /* Variante "repli Bazaart" : fond légèrement plus sombre pour distinguer
       visuellement le logo Bazaart d'un logo d'organisme réel */
    .card-logo--bazaart {
        background: var(--bg-alt, #E8E5DC);
        border-color: var(--line-soft);
    }

    /* ── Chips compacts (ADR-0016 Lot 3 — pays et niveau) ───────────────────
       Utilisés dans les cartes liste ET grille pour afficher des métadonnées
       supplémentaires sans surcharger visuellement.
       Taille légèrement plus petite que les chips hero (.hero-badge-disc)
       pour rester discrets en contexte catalogue. */

    /* Chip pays : fond sable, bordure encre douce, texte gris */
    .badge-country {
        display: inline-block;
        padding: 2px 7px;
        background: transparent;
        border: 1px solid var(--line-soft);
        color: var(--ink-mute);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    /* Chip niveau : variante subtile — fond lime très atténué = info positive */
    .badge-level {
        display: inline-block;
        padding: 2px 7px;
        background: transparent;
        border: 1px solid var(--line-soft);
        color: var(--ink-mute);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
</style>
{% endblock %}

{% block content %}

{# ── En-tête de section ───────────────────────────────────────────────────── #}
{#
   Header style prototype Street :
   - Gauche  : eyebrow "■ OPPORTUNITES · N ACTIVES" + titre géant fluide
   - Droite  : bouton alerte + switcher vue liste/grille
#}
<div class="opp-header">
    <div class="opp-header__row">

        {# ── Colonne gauche : eyebrow + titre ── #}
        <div>
            {#
                Eyebrow : le caractère "■" est un carré Unicode standard (U+25A0).
                On affiche le compteur total GLOBAL (variable `total`),
                pas le nombre d'items sur la page courante.
                Exemple pagination : "■ OPPORTUNITES · 47 ACTIVES" même si on n'en affiche que 12.
            #}
            <div class="opp-eyebrow">
                &#9632; OPPORTUNITES
                {%- if total is defined and total > 0 %} &middot; {{ total }} ACTIVE{{ total > 1 ? 'S' : '' }}{% endif %}
            </div>

            {#
                Titre géant en deux lignes, uppercase, Archivo Black.
                clamp(64px, 9vw, 132px) : typographie fluide selon le CDC.
                line-height 0.88 = serré, style affiche / poster.
            #}
            <h1 class="opp-title">
                CE QUI EST<br>
                OUVERT.
            </h1>
        </div>

        {# ── Colonne droite : bouton alerte + switcher ── #}
        <div class="opp-header__controls">

            {#
                Bouton "Creer une alerte" : visible pour tout utilisateur connecté.
                Les alertes permettent de recevoir des notifs email quand une
                nouvelle opportunité matche ses préférences (discipline, type…).
                Route : app_resource_alerts
            #}
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_resource_alerts') }}"
                   class="btn btn-ghost btn-sm">
                    &#128276; Creer une alerte
                </a>
            {% endif %}

            {#
                Switcher vue : deux boutons côte à côte avec border 1px solid var(--ink).
                Identifiants id="btn-list" et id="btn-grid" utilisés par le JS ci-dessous.
                L'état actif est géré dynamiquement par setView() — pas de classe CSS statique.
            #}
            <div class="view-switcher" role="group" aria-label="Choisir le mode d'affichage">
                <button id="btn-list"
                        class="view-switcher__btn"
                        type="button"
                        aria-pressed="true"
                        title="Vue liste">
                    &#9632; Liste
                </button>
                <button id="btn-grid"
                        class="view-switcher__btn"
                        type="button"
                        aria-pressed="false"
                        title="Vue grille">
                    &#8862; Grille
                </button>
            </div>

        </div>
    </div>
</div>

{# ── Barre de filtres ─────────────────────────────────────────────────────── #}
{#
   Formulaire GET (pas POST) : les filtres vivent dans l'URL → partage de lien,
   bouton retour navigateur, et pas besoin de token CSRF (lecture seule).
   Champ caché page=1 : force un retour à la page 1 à chaque nouveau filtrage.
#}
<form method="get"
      action="{{ path('app_resource_index') }}"
      class="filter-bar"
      role="search"
      aria-label="Filtrer les opportunites">

    {# Retour systématique à la page 1 quand les filtres changent #}
    <input type="hidden" name="page" value="1">

    {#
        Champ de recherche textuelle — flex:1 pour prendre le maximum d'espace.
        name="q" : le contrôleur ResourceController::index() lit $request->query->get('q').
        La variable Twig currentSearch reflète la valeur lue (initialisée à '' si absente).
    #}
    <input class="filter-bar__search"
           type="text"
           name="q"
           value="{{ currentSearch }}"
           placeholder="Rechercher une opportunite..."
           autocomplete="off"
           aria-label="Rechercher par mot-cle">

    {# Select discipline artistique #}
    <select class="filter-bar__select" name="discipline" aria-label="Filtrer par discipline">
        <option value="">Toutes les disciplines</option>
        {% for disc in disciplines %}
            <option value="{{ disc.id }}"
                    {% if currentDisciplineId == disc.id %}selected{% endif %}>
                {{ disc.name }}
            </option>
        {% endfor %}
    </select>

    {# Select type de ressource (appel d'offres, résidence, bourse...) #}
    <select class="filter-bar__select" name="type" aria-label="Filtrer par type">
        <option value="">Tous les types</option>
        {% for type in types %}
            <option value="{{ type.id }}"
                    {% if currentTypeId == type.id %}selected{% endif %}>
                {{ type.name }}
            </option>
        {% endfor %}
    </select>

    {# Bouton de soumission : fond encre + texte accent lime #}
    <button type="submit" class="filter-bar__submit">
        FILTRER
    </button>

</form>

{# ── Contenu principal : résultats ou état vide ───────────────────────────── #}
{% if resources is empty %}

    {# ── Etat vide ── #}
    {# Deux cas distincts : filtre sans résultat, ou catalogue vraiment vide #}
    <div class="empty-state">

        {# Numéro décoratif style éditorial = esthétique caractéristique du thème Street #}
        <div class="empty-state__icon">00</div>

        {% if currentSearch or currentTypeId or currentDisciplineId %}
            <div class="empty-state__title">Aucun résultat</div>
            <p class="empty-state__text">
                Aucune ressource ne correspond a vos critères de recherche.<br>
                Essayez avec des mots-clés différents ou élargissez les filtres.
            </p>
            <a href="{{ path('app_resource_index') }}" class="empty-state__cta">
                Voir toutes les ressources
            </a>
        {% else %}
            <div class="empty-state__title">Pas encore de ressources</div>
            {#
                Les structures voient un CTA pour soumettre la première ressource.
                Les artistes et visiteurs voient un message d'attente.
                Décision produit V1 : seules les structures soumettent des opportunités.
            #}
            {% if is_granted('ROLE_STRUCTURE') %}
                <p class="empty-state__text">
                    Le catalogue est vide pour l'instant.<br>
                    Soyez la première structure a partager une opportunité avec la communauté.
                </p>
                <a href="{{ path('app_resource_submit') }}" class="empty-state__cta">
                    Soumettre une ressource
                </a>
            {% else %}
                <p class="empty-state__text">
                    Le catalogue est vide pour l'instant.<br>
                    Les opportunités proposées par les structures partenaires apparaîtront ici.
                </p>
            {% endif %}
        {% endif %}
    </div>

{% else %}

    {#
        Compteur de résultats actifs.
        On affiche le total global, pas juste les items de la page courante.
        Indication de pagination si on est au-dela de la page 1.
    #}
    <p class="results-count">
        &#8594; {{ total }} résultat{{ total > 1 ? 's' : '' }}
        {% if currentSearch %} · "{{ currentSearch }}"{% endif %}
        {% if totalPages > 1 %} · page {{ currentPage }}/{{ totalPages }}{% endif %}
    </p>

    {# ──────────────────────────────────────────────────────────────────────── #}
    {# VUE LISTE (id="view-list") — affichée par défaut                        #}
    {#                                                                          #}
    {# Chaque ligne = lien cliquable sur toute la surface, avec :              #}
    {#   - Gauche : badges (type + disciplines) + titre + méta (org · lieu)    #}
    {#   - Droite : badge URGENT + deadline, ou juste la deadline              #}
    {# ──────────────────────────────────────────────────────────────────────── #}
    <div id="view-list" class="view-list">
        {% for resource in resources %}
            <a href="{{ path('app_resource_show', {id: resource.id}) }}"
               class="list-card"
               aria-label="Voir l'opportunité : {{ resource.title }}">

                {# ── Colonne gauche ── #}
                <div class="list-card__left">

                    {# Ligne de badges : type (accent lime) + disciplines (bordure légère) #}
                    <div class="list-card__badges">

                        {# Badge type seulement si renseigné (champ nullable) #}
                        {% if resource.resourceType %}
                            <span class="badge-type">{{ resource.resourceType.name }}</span>
                        {% endif %}

                        {#
                            On affiche au max 2 disciplines pour ne pas surcharger la ligne.
                            Si plus de 2, on affiche "+N" pour signaler qu'il y en a davantage.
                        #}
                        {% for discipline in resource.disciplines|slice(0, 2) %}
                            <span class="badge-disc">{{ discipline.name }}</span>
                        {% endfor %}
                        {% if resource.disciplines|length > 2 %}
                            <span class="badge-disc">+{{ resource.disciplines|length - 2 }}</span>
                        {% endif %}
                    </div>

                    {# Titre de l'opportunité : display Archivo Black, 22px, 2 lignes max #}
                    <h2 class="list-card__title">{{ resource.title }}</h2>

                    {#
                        Méta : organisation + localisation (ADR-0016 Lot 3).
                        Priorité localisation : city+country > city > country > location.
                        On construit `listLocLabel` pour factoriser la logique.
                    #}
                    {% set listLocLabel = '' %}
                    {% if resource.city and resource.country %}
                        {% set listLocLabel = resource.city ~ ', ' ~ resource.country %}
                    {% elseif resource.city %}
                        {% set listLocLabel = resource.city %}
                    {% elseif resource.country %}
                        {% set listLocLabel = resource.country %}
                    {% elseif resource.location %}
                        {% set listLocLabel = resource.location %}
                    {% endif %}

                    {% if resource.organization or listLocLabel %}
                        <div class="list-card__meta">
                            {{ resource.organization ? resource.organization.name : '' }}
                            {%- if resource.organization and listLocLabel %} &middot; {% endif -%}
                            {{ listLocLabel }}
                        </div>
                    {% endif %}

                    {#
                        Chips compacts pays + niveau (ADR-0016 Lot 3).
                        Affichés sur une ligne séparée, sous la méta organisation/lieu,
                        pour ne pas surcharger le texte de la méta existante.
                        On affiche le pays (plus compact que "Ville, Pays") et le niveau.
                        Le pays seul suffit dans un contexte catalogue — la ville s'affiche
                        sur la page de détail où l'espace est plus généreux.
                        Condition : au moins l'un des deux doit exister pour afficher la ligne.
                    #}
                    {% if resource.country or resource.experienceLevel %}
                        <div class="list-card__badges" style="margin-top:2px;">
                            {% if resource.country %}
                                <span class="badge-country">{{ resource.country }}</span>
                            {% endif %}
                            {% if resource.experienceLevel %}
                                <span class="badge-level">{{ resource.experienceLevel.label() }}</span>
                            {% endif %}
                        </div>
                    {% endif %}

                </div>

                {# ── Colonne droite : logo + deadline ── #}
                <div class="list-card__right">

                    {#
                        ADR-0019 : miniature logo de l'organisme.
                        Affiché en haut de la colonne droite pour identifier visuellement
                        l'émetteur de l'opportunité.

                        Comportement :
                          - logoUrl renseigné  → image distante (lazy loading)
                          - logoUrl vide/null  → favicon/logo Bazaart en repli
                          - onerror            → si l'image distante est cassée, on bascule
                                                 vers le favicon Bazaart (this.onerror=null
                                                 évite une boucle infinie si le favicon lui-même
                                                 venait à être inaccessible)

                        Accessibilité :
                          - alt="Logo {{ resource.title }}" pour le logo réel
                          - alt="Bazaart" pour le repli
                          - aria-hidden="true" car l'information est portée par le titre

                        Sécurité : logoUrl est auto-escaped par Twig dans src="{{ }}"
                        (jamais de |raw sur une URL externe).
                    #}
                    {% if resource.logoUrl %}
                        {# Logo réel de l'organisme — chargé depuis l'URL distante #}
                        <div class="card-logo">
                            <img src="{{ resource.logoUrl|e }}"
                                 alt="Logo {{ resource.title|e }}"
                                 loading="lazy"
                                 onerror="this.onerror=null; this.src='{{ asset('images/favicon.png') }}'; this.alt='Bazaart';">
                        </div>
                    {% else %}
                        {# Pas de logo : on affiche le favicon/logo Bazaart en repli #}
                        <div class="card-logo card-logo--bazaart">
                            <img src="{{ asset('images/favicon.png') }}"
                                 alt="Bazaart"
                                 loading="lazy">
                        </div>
                    {% endif %}

                    {#
                        Logique deadline :
                        - Resource.deadline est un ?DateTimeInterface dans l'entité.
                        - On calcule les secondes restantes avec le filtre |date("U")
                          (timestamp Unix) qui accepte nativement les objets DateTime.
                        - Si la deadline est dans moins de 7 jours (604 800 s) : badge URGENT.
                        - Sinon : date sobre en mono gris.
                    #}
                    {% if resource.deadline %}
                        {# Calcul des secondes restantes jusqu'à la deadline #}
                        {% set secondsLeft = resource.deadline|date("U") - "now"|date("U") %}

                        {% if secondsLeft >= 0 and secondsLeft < 604800 %}
                            {# Moins de 7 jours : badge URGENT + date en orange #}
                            <span class="badge-urgent">URGENT</span>
                            <span class="deadline-text deadline-text--urgent">{{ resource.deadline|date('d M Y') }}</span>
                        {% elseif secondsLeft >= 0 %}
                            {# Plus de 7 jours : date simple #}
                            <span class="deadline-text">{{ resource.deadline|date('d M Y') }}</span>
                        {% endif %}
                    {% endif %}
                </div>

            </a>
        {% endfor %}
    </div>
    {# ── Fin vue liste ── #}

    {# ──────────────────────────────────────────────────────────────────────── #}
    {# VUE GRILLE (id="view-grid") — masquée par défaut (display:none)         #}
    {#                                                                          #}
    {# Grille 3 colonnes, bordures partagées = style tableau éditorial.        #}
    {# Le JS ci-dessous switche entre display:none et display:grid.            #}
    {# ──────────────────────────────────────────────────────────────────────── #}
    <div id="view-grid" class="view-grid">
        {% for resource in resources %}
            <a href="{{ path('app_resource_show', {id: resource.id}) }}"
               class="grid-card"
               aria-label="Voir l'opportunité : {{ resource.title }}">

                {#
                    ADR-0019 : logo de l'organisme dans la card grille.
                    Affiché en ligne avec les badges (flex row), ce qui donne
                    un effet "logo + type" sur la même ligne.
                    Même logique que la vue liste : image si logoUrl, favicon Bazaart sinon.
                    Les dimensions sont identiques à la vue liste (48×48 px via .card-logo).
                #}
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:4px;">
                    {# Miniature logo grille — même comportement que la vue liste #}
                    {% if resource.logoUrl %}
                        {# Logo réel de l'organisme #}
                        <div class="card-logo">
                            <img src="{{ resource.logoUrl|e }}"
                                 alt="Logo {{ resource.title|e }}"
                                 loading="lazy"
                                 onerror="this.onerror=null; this.src='{{ asset('images/favicon.png') }}'; this.alt='Bazaart';">
                        </div>
                    {% else %}
                        {# Repli favicon Bazaart #}
                        <div class="card-logo card-logo--bazaart">
                            <img src="{{ asset('images/favicon.png') }}"
                                 alt="Bazaart"
                                 loading="lazy">
                        </div>
                    {% endif %}

                    {# Badges type + disciplines sur la même ligne que le logo #}
                    <div class="list-card__badges" style="flex:1; margin-bottom:0;">
                        {% if resource.resourceType %}
                            <span class="badge-type">{{ resource.resourceType.name }}</span>
                        {% endif %}
                        {% for discipline in resource.disciplines|slice(0, 2) %}
                            <span class="badge-disc">{{ discipline.name }}</span>
                        {% endfor %}
                        {% if resource.disciplines|length > 2 %}
                            <span class="badge-disc">+{{ resource.disciplines|length - 2 }}</span>
                        {% endif %}
                    </div>
                </div>

                {# Titre : display Archivo Black, 3 lignes max, prend l'espace disponible #}
                <h2 class="grid-card__title">{{ resource.title }}</h2>

                {#
                    Chips compacts pays + niveau (ADR-0016 Lot 3) dans la vue grille.
                    Mêmes chips que dans la vue liste mais sans la méta organisation
                    (pas assez de place en grille pour tout afficher).
                    Condition : au moins l'un des deux doit être renseigné.
                #}
                {% if resource.country or resource.experienceLevel %}
                    <div class="list-card__badges" style="margin-top:auto; padding-top:4px;">
                        {% if resource.country %}
                            <span class="badge-country">{{ resource.country }}</span>
                        {% endif %}
                        {% if resource.experienceLevel %}
                            <span class="badge-level">{{ resource.experienceLevel.label() }}</span>
                        {% endif %}
                    </div>
                {% endif %}

                {# Deadline en bas de card, mono discret. |date() formate le DateTimeInterface. #}
                {% if resource.deadline %}
                    <div class="grid-card__deadline">{{ resource.deadline|date('d M Y') }}</div>
                {% endif %}

            </a>
        {% endfor %}
    </div>
    {# ── Fin vue grille ── #}

    {#
        ── Pagination ──────────────────────────────────────────────────────────
        Affichée uniquement quand il y a plus d'une page (totalPages > 1).
        Chaque lien PRESERVE les filtres actifs (type, discipline, search) pour
        que naviguer entre les pages ne réinitialise pas la recherche.

        Architecture des URLs générées (exemple avec filtres) :
          /resources?type=2&discipline=4&search=musique&page=3

        Fenetre de 5 pages max autour de la page courante (2 avant + 2 après).
        Algorithme borné entre 1 et totalPages.
    #}
    {% if totalPages > 1 %}

        {#
            Calcul de la fenêtre de pagination.
            max() et min() sont des filtres Twig natifs — pas de dépendance supplémentaire.
        #}
        {% set windowStart = max(1, currentPage - 2) %}
        {% set windowEnd   = min(totalPages, currentPage + 2) %}

        {#
            Construction des paramètres de base (filtres actifs).
            On n'inclut un paramètre que s'il a une valeur non-vide → URLs propres.
        #}
        {% set baseParams = {} %}
        {% if currentTypeId %}
            {% set baseParams = baseParams|merge({ type: currentTypeId }) %}
        {% endif %}
        {% if currentDisciplineId %}
            {% set baseParams = baseParams|merge({ discipline: currentDisciplineId }) %}
        {% endif %}
        {% if currentSearch %}
            {% set baseParams = baseParams|merge({ q: currentSearch }) %}
        {% endif %}

        <nav class="pagination-wrap" aria-label="Navigation entre les pages de ressources">
            <ul class="pagination">

                {# Lien "Precedent" : désactivé sur la page 1 #}
                <li class="page-item {% if currentPage <= 1 %}disabled{% endif %}">
                    {% if currentPage > 1 %}
                        <a class="page-link"
                           href="{{ path('app_resource_index', baseParams|merge({ page: currentPage - 1 })) }}"
                           aria-label="Page précédente">
                            &larr; Prec.
                        </a>
                    {% else %}
                        <span class="page-link" aria-hidden="true">&larr; Prec.</span>
                    {% endif %}
                </li>

                {# Points de suspension au début si la fenêtre ne commence pas à 1 #}
                {% if windowStart > 1 %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_resource_index', baseParams|merge({ page: 1 })) }}"
                           aria-label="Page 1">1</a>
                    </li>
                    {% if windowStart > 2 %}
                        <li class="page-item disabled" aria-hidden="true">
                            <span class="page-link">&hellip;</span>
                        </li>
                    {% endif %}
                {% endif %}

                {# Numéros de page dans la fenêtre #}
                {% for p in windowStart..windowEnd %}
                    <li class="page-item {% if p == currentPage %}active{% endif %}">
                        {% if p == currentPage %}
                            {# Page courante : non-cliquable, aria-current pour l'accessibilité #}
                            <span class="page-link" aria-current="page">{{ p }}</span>
                        {% else %}
                            <a class="page-link"
                               href="{{ path('app_resource_index', baseParams|merge({ page: p })) }}"
                               aria-label="Page {{ p }}">{{ p }}</a>
                        {% endif %}
                    </li>
                {% endfor %}

                {# Points de suspension à la fin si la fenêtre ne finit pas à totalPages #}
                {% if windowEnd < totalPages %}
                    {% if windowEnd < totalPages - 1 %}
                        <li class="page-item disabled" aria-hidden="true">
                            <span class="page-link">&hellip;</span>
                        </li>
                    {% endif %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_resource_index', baseParams|merge({ page: totalPages })) }}"
                           aria-label="Page {{ totalPages }}">{{ totalPages }}</a>
                    </li>
                {% endif %}

                {# Lien "Suivant" : désactivé sur la dernière page #}
                <li class="page-item {% if currentPage >= totalPages %}disabled{% endif %}">
                    {% if currentPage < totalPages %}
                        <a class="page-link"
                           href="{{ path('app_resource_index', baseParams|merge({ page: currentPage + 1 })) }}"
                           aria-label="Page suivante">
                            Suiv. &rarr;
                        </a>
                    {% else %}
                        <span class="page-link" aria-hidden="true">Suiv. &rarr;</span>
                    {% endif %}
                </li>

            </ul>
        </nav>

    {% endif %}
    {# ── Fin pagination ── #}

{% endif %}
{# ── Fin bloc résultats ── #}

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
/**
 * Switcher vue Liste / Grille — JS vanilla, sans dépendance externe
 *
 * Principe :
 * - Deux conteneurs avec id="view-list" et id="view-grid" sont dans le DOM
 * - La fonction setView(v) affiche l'un et masque l'autre
 * - Les boutons #btn-list et #btn-grid déclenchent le changement
 * - setView('list') est appelé immédiatement au chargement pour initialiser
 *
 * L'état actif du bouton est signalé visuellement par background/color
 * (fond encre + texte accent lime = identité graphique Street).
 */
(function () {
    // Récupération des éléments du DOM
    var btnList  = document.getElementById('btn-list');
    var btnGrid  = document.getElementById('btn-grid');
    var viewList = document.getElementById('view-list');
    var viewGrid = document.getElementById('view-grid');

    // Sécurité : on ne fait rien si un des éléments est absent
    // (ex : état vide où les conteneurs de vue ne sont pas rendus)
    if (!btnList || !btnGrid || !viewList || !viewGrid) {
        return;
    }

    /**
     * setView(v) — affiche la vue demandée, masque l'autre, met à jour les boutons
     * @param {string} v — 'list' ou 'grid'
     */
    function setView(v) {
        // Affichage des conteneurs
        // La vue grille doit être display:grid (pas display:block) pour que la grille CSS fonctionne
        viewList.style.display = v === 'list' ? 'block' : 'none';
        viewGrid.style.display = v === 'grid'  ? 'grid'  : 'none';

        // Etat actif du bouton Liste : fond encre + texte accent lime
        btnList.style.background = v === 'list' ? 'var(--ink)'    : '';
        btnList.style.color      = v === 'list' ? 'var(--accent)' : '';

        // Etat actif du bouton Grille
        btnGrid.style.background = v === 'grid' ? 'var(--ink)'    : '';
        btnGrid.style.color      = v === 'grid' ? 'var(--accent)' : '';

        // Accessibilité : mise à jour de aria-pressed sur les boutons
        btnList.setAttribute('aria-pressed', v === 'list' ? 'true' : 'false');
        btnGrid.setAttribute('aria-pressed', v === 'grid' ? 'true' : 'false');
    }

    // Ecouteurs de clic sur les boutons du switcher
    btnList.addEventListener('click', function () { setView('list'); });
    btnGrid.addEventListener('click', function () { setView('grid'); });

    // Initialisation : vue liste par défaut au chargement de la page
    setView('list');
}());
</script>
{% endblock %}
