{% extends 'base_app.html.twig' %}

{#
 # resource/index.html.twig — Catalogue des ressources / opportunités
 #
 # Thème : Street (app connectée)
 # Refonte : vue GRILLE UNIQUEMENT (suppression vue liste + switcher), filtres enrichis
 #           (ajout année deadline et pays), tri au choix, cartes enrichies.
 #
 # Polices :
 #   var(--display) = Archivo Black  → titres, eyebrow, grands formats
 #   var(--body)    = Space Grotesk  → texte courant
 #   var(--mono)    = JetBrains Mono → labels, badges, meta
 #
 # Palette :
 #   var(--bg)      = #F2EFE6  fond sable
 #   var(--ink)     = #0D0D0D  quasi-noir principal
 #   var(--accent)  = #C6F24E  lime (badge Type)
 #   var(--accent-2)= #FF6B2C  orange (badge Discipline + urgence)
 #
 # Design : border-radius 0 partout, pas d'ombres, bordures 1px solid var(--ink)
 #
 # Variables Twig disponibles :
 #   resources           — tableau de Resource (uniquement la page courante, 12 max)
 #   types               — tableau de ResourceType pour le select
 #   disciplines         — tableau de Discipline pour le select
 #   availableYears      — int[]  années de deadline distinctes en base (ordre DESC)
 #   availableCountries  — string[] pays distincts en base (ordre ABC)
 #   currentSearch       — string (filtre texte actif, parametre URL "q")
 #   currentTypeId       — int|null (filtre type actif)
 #   currentDisciplineId — int|null (filtre discipline actif)
 #   currentYear         — int|null (filtre annee actif)
 #   currentCountry      — string (filtre pays actif, '' si absent)
 #   currentSort         — string 'recent'|'deadline'
 #   currentPage         — int (page courante, 1-based)
 #   totalPages          — int (nombre total de pages)
 #   total               — int (nombre total de resultats tous filtres confondus)
 #
 # Chaque resource expose :
 #   .id, .title, .publishedAt (DateTimeInterface|null)
 #   .deadline (DateTimeInterface|null), .resourceType (nullable, .name)
 #   .disciplines (Collection, .name), .organization (nullable, .name)
 #   .country (string|null), .city (string|null), .location (string|null)
 #   .fundingAmount (string|null), .fundingType (string|null)
 #   .logoUrl (string|null)
 #}

{% block title %}Opportunites — Bazaart{% endblock %}
{% block page_title %}Opportunites{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* =====================================================================
       CATALOGUE OPPORTUNITES — styles theme Street
       Vue GRILLE uniquement (la vue liste et le switcher ont ete supprimes).
       Toutes les valeurs passent par les variables CSS du design-tokens.css.
    ===================================================================== */

    /* ── Barre de filtres ────────────────────────────────────────────── */

    /* Fond legèrement different + bordure basse = zone fonctionnelle distincte */
    .filter-bar {
        background: var(--bg-alt);
        border-bottom: 1px solid var(--ink);
    }

    /* Premiere ligne : recherche + type + discipline + bouton */
    .filter-bar__row {
        display: flex;
        align-items: stretch;
        flex-wrap: wrap;
        gap: 0;
    }

    /* Deuxième ligne : filtres secondaires (annee, pays, tri) */
    .filter-bar__row2 {
        display: flex;
        align-items: stretch;
        flex-wrap: wrap;
        gap: 0;
        border-top: 1px solid var(--line-soft);
    }

    /* Champ recherche : flex:1 pour prendre le maximum d'espace */
    .filter-bar__search {
        flex: 1;
        min-width: 180px;
        padding: 12px 16px;
        background: transparent;
        border: none;
        border-right: 1px solid var(--line-soft);
        font-family: var(--body);
        font-size: 14px;
        color: var(--ink);
        outline: none;
    }

    .filter-bar__search::placeholder {
        color: var(--ink-mute);
    }

    /* Selects : meme padding que le champ recherche, fond transparent */
    .filter-bar__select {
        padding: 12px 16px;
        background: transparent;
        border: none;
        border-right: 1px solid var(--line-soft);
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink);
        outline: none;
        cursor: pointer;
        min-width: 130px;
    }

    /* Bouton FILTRER : fond encre, texte accent = CTA primaire Street */
    .filter-bar__submit {
        padding: 12px 24px;
        background: var(--ink);
        color: var(--accent);
        border: none;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background var(--transition-fast), color var(--transition-fast);
        white-space: nowrap;
    }

    .filter-bar__submit:hover {
        background: var(--accent);
        color: var(--ink);
    }

    /* Label "TRIER PAR" dans la barre secondaire */
    .filter-bar__label {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-mute);
        border-right: 1px solid var(--line-soft);
        white-space: nowrap;
    }

    /* Bouton de reinitialisation des filtres : discret, lien mono */
    .filter-bar__reset {
        display: flex;
        align-items: center;
        padding: 8px 16px;
        margin-left: auto;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ink-mute);
        text-decoration: none;
        border-left: 1px solid var(--line-soft);
        white-space: nowrap;
        transition: color var(--transition-fast);
    }

    .filter-bar__reset:hover {
        color: var(--ink);
    }

    /* ── Compteur de resultats ───────────────────────────────────────── */

    .results-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-md);
        flex-wrap: wrap;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: .08em;
        color: var(--ink-mute);
        text-transform: uppercase;
        padding: var(--space-md) 0;
        border-bottom: 1px solid var(--line-soft);
        margin-bottom: var(--space-md);
    }

    /* ── VUE GRILLE ──────────────────────────────────────────────────── */

    /* Grille 3 colonnes, bordures partagees = style tableau editorial */
    .view-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        border: 1px solid var(--ink);
    }

    /* Sur tablette : 2 colonnes */
    @media (max-width: 900px) {
        .view-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    /* Sur mobile : 1 colonne */
    @media (max-width: 580px) {
        .view-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Card grille : flex colonne, bordures droite + bas partagees */
    .grid-card {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding: 20px 18px;
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
        background: transparent;
        color: var(--ink);
        text-decoration: none;
        transition: background var(--transition-fast);
    }

    /* Survol : lime = signal fort */
    .grid-card:hover {
        background: var(--accent);
    }

    /* Ligne superieure : logo + badges type/discipline */
    .grid-card__top {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 12px;
    }

    /* Colonne droite de la ligne sup : badges empiles */
    .grid-card__badges {
        display: flex;
        flex-direction: column;
        gap: 4px;
        flex: 1;
        min-width: 0;
    }

    /* Badge Type : fond lime --accent (vert acide), texte encre */
    .badge-type {
        display: inline-block;
        padding: 3px 8px;
        background: var(--accent);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        align-self: flex-start;
    }

    /* Badge Discipline : fond orange --accent-2 distinct du badge Type */
    .badge-disc {
        display: inline-block;
        padding: 3px 8px;
        background: var(--accent-2);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .04em;
        align-self: flex-start;
    }

    /* Badge discipline surplus (+N) : meme style que badge-disc */
    .badge-disc-more {
        display: inline-block;
        padding: 3px 8px;
        border: 1px solid var(--ink-mute);
        color: var(--ink-mute);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .04em;
        align-self: flex-start;
    }

    /* Titre dans la grille : display Archivo Black, 3 lignes max */
    .grid-card__title {
        font-family: var(--display);
        font-size: 18px;
        line-height: 1.1;
        color: var(--ink);
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin: 0 0 12px;
        flex: 1;
    }

    /* Zone meta : date de publication + deadline */
    .grid-card__dates {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-bottom: 10px;
    }

    /* Ligne de date individuelle */
    .grid-card__date-line {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: var(--mono);
        font-size: 10px;
        color: var(--ink-mute);
        letter-spacing: .03em;
    }

    /* Label de la date (ex: "PUBLIE" ou "LIMITE") */
    .grid-card__date-label {
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        font-size: 9px;
        color: var(--ink-mute);
        flex-shrink: 0;
    }

    /* Valeur de date */
    .grid-card__date-val {
        color: var(--ink);
    }

    /* Deadline urgente (moins de 7 jours) : orange */
    .grid-card__date-val--urgent {
        color: var(--accent-2);
        font-weight: 700;
    }

    /* Badge URGENT : fond orange, texte encre */
    .badge-urgent {
        display: inline-block;
        padding: 2px 6px;
        background: var(--accent-2);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    /* Zone montant : affichee si fundingAmount ou fundingType renseignes */
    .grid-card__funding {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink);
        font-weight: 700;
        letter-spacing: .03em;
        margin-bottom: 6px;
    }

    .grid-card__funding-sub {
        font-family: var(--mono);
        font-size: 10px;
        color: var(--ink-mute);
        font-weight: 400;
        letter-spacing: .02em;
    }

    /* Zone territoire/pays en bas de card */
    .grid-card__territory {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: auto;
        padding-top: 8px;
    }

    /* Chip pays : contour leger, texte gris */
    .badge-country {
        display: inline-block;
        padding: 2px 7px;
        background: transparent;
        border: 1px solid var(--line-soft);
        color: var(--ink-mute);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    /* Logo miniature */
    .card-logo {
        width: 40px;
        height: 40px;
        min-width: 40px;
        background: #ffffff;
        border: 1px solid var(--line-soft);
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .card-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    /* Repli Bazaart quand logoUrl est absent ou cassé */
    .card-logo--bazaart {
        background: var(--bg-alt, #E8E5DC);
        border-color: var(--line-soft);
    }

    /* ── Etat vide ───────────────────────────────────────────────────── */

    .empty-state {
        border: 1px solid var(--ink);
        padding: var(--space-3xl) var(--space-2xl);
        text-align: center;
        background: var(--bg);
    }

    .empty-state__icon {
        font-family: var(--display);
        font-size: 80px;
        color: var(--ink-mute);
        opacity: .2;
        line-height: 1;
        margin-bottom: var(--space-md);
    }

    .empty-state__title {
        font-family: var(--display);
        font-size: 24px;
        text-transform: uppercase;
        color: var(--ink);
        margin-bottom: var(--space-sm);
    }

    .empty-state__text {
        font-family: var(--body);
        font-size: 14px;
        color: var(--ink-mute);
        line-height: 1.6;
        margin-bottom: var(--space-lg);
    }

    .empty-state__cta {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: var(--btn-padding);
        background: var(--accent);
        color: var(--ink);
        border: 2px solid var(--ink);
        font-family: var(--body);
        font-size: var(--btn-font-size);
        font-weight: var(--btn-font-weight);
        letter-spacing: var(--btn-letter-spacing);
        text-transform: uppercase;
        text-decoration: none;
        transition: background var(--transition-fast), color var(--transition-fast);
    }

    .empty-state__cta:hover {
        background: var(--ink);
        color: var(--accent);
    }

    /* ── Pagination ──────────────────────────────────────────────────── */

    .pagination-wrap {
        margin-top: var(--space-xl);
        display: flex;
        justify-content: center;
    }

    .pagination-wrap .pagination {
        display: inline-flex;
        border: 1px solid var(--ink);
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 0;
    }

    .pagination-wrap .page-item .page-link {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 40px;
        height: 40px;
        padding: 0 var(--space-sm);
        border-right: 1px solid var(--ink);
        font-family: var(--mono);
        font-size: 12px;
        font-weight: 700;
        color: var(--ink);
        text-decoration: none;
        background: transparent;
        transition: background var(--transition-fast), color var(--transition-fast);
    }

    .pagination-wrap .page-item:last-child .page-link {
        border-right: none;
    }

    .pagination-wrap .page-item.active .page-link {
        background: var(--ink);
        color: var(--accent);
    }

    .pagination-wrap .page-item .page-link:hover {
        background: var(--accent);
        color: var(--ink);
    }

    .pagination-wrap .page-item.disabled .page-link {
        opacity: .35;
        pointer-events: none;
    }
</style>
{% endblock %}

{% block content %}

{# ── En-tete de section ───────────────────────────────────────────────────── #}
{#
   Header style prototype Street :
   - Gauche  : eyebrow "OPPORTUNITES + compteur" + titre geant fluide
   - Droite  : bouton "Creer une alerte" bien visible
#}
{#
   ── HERO PHOTO ─────────────────────────────────────────────────────────────
   Remplace l'ancien .opp-header (eyebrow + titre geant + bouton alerte en ligne).
   Le titre "CE QUI EST OUVERT." est conserve tel quel (texte existant).
   Le sous-titre decrit en une phrase le catalogue d'opportunites.
   Le bouton "Creer une alerte" est repositionne juste apres le hero.
#}
{% include '_page_hero.html.twig' with {
    image:    'images/hero-opportunites.jpg',
    title:    'CE QUI EST OUVERT.',
    subtitle: 'Bourses, résidences et appels à projets pour les artistes de la diaspora afro-atlantique.'
} only %}

{# ── Bouton alerte (anciennement a droite du titre) ──────────────────────── #}
{#
   Repositionne en dessous du hero. Aligne a droite pour conserver
   le lien visuel avec les actions sans perturber le flux de lecture.
#}
{% if is_granted('ROLE_USER') %}
{# Barre d'action sous le hero : CTA aligné à droite via .hero-action-bar (page-hero.css) #}
<div class="hero-action-bar">
    <a href="{{ path('app_resource_alert_edit') }}"
       class="btn btn-primary"
       style="display:inline-flex; align-items:center; gap:6px; white-space:nowrap;">
        {# Icone cloche SVG accessible (aria-hidden car le texte suffit) #}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round"
             aria-hidden="true">
            <path d="M6 8a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6"/>
            <path d="M10 18a2 2 0 0 0 4 0"/>
        </svg>
        Créer une alerte
    </a>
</div>
{% endif %}

{# ── Barre de filtres ─────────────────────────────────────────────────────── #}
{#
   Formulaire GET (pas POST) : les filtres vivent dans l'URL pour partage de lien
   et navigation arriere navigateur. Pas de token CSRF (lecture seule).

   Organisation en deux lignes :
     Ligne 1 : recherche + type + discipline + bouton FILTRER
     Ligne 2 : annee deadline + pays/territoire + tri + (reset si filtres actifs)
#}
<form method="get"
      action="{{ path('app_resource_index') }}"
      class="filter-bar"
      role="search"
      aria-label="Filtrer les opportunites">

    {# Retour systematique a la page 1 quand les filtres changent #}
    <input type="hidden" name="page" value="1">

    {# ── Ligne 1 : filtres principaux ── #}
    <div class="filter-bar__row">

        {#
            Champ de recherche textuelle.
            name="q" : ResourceController::index() lit $request->query->get('q').
        #}
        <input class="filter-bar__search"
               type="text"
               name="q"
               value="{{ currentSearch }}"
               placeholder="Rechercher une opportunite..."
               autocomplete="off"
               aria-label="Rechercher par mot-cle">

        {# Select type de ressource (appel d'offres, residence, bourse...) #}
        <select class="filter-bar__select" name="type" aria-label="Filtrer par type">
            <option value="">Tous les types</option>
            {% for type in types %}
                <option value="{{ type.id }}"
                        {% if currentTypeId == type.id %}selected{% endif %}>
                    {{ type.name }}
                </option>
            {% endfor %}
        </select>

        {# Select discipline artistique #}
        <select class="filter-bar__select" name="discipline" aria-label="Filtrer par discipline">
            <option value="">Toutes les disciplines</option>
            {% for disc in disciplines %}
                <option value="{{ disc.id }}"
                        {% if currentDisciplineId == disc.id %}selected{% endif %}>
                    {{ disc.name }}
                </option>
            {% endfor %}
        </select>

        {# Bouton de soumission : fond encre + texte accent lime #}
        <button type="submit" class="filter-bar__submit">
            FILTRER
        </button>

    </div>

    {# ── Ligne 2 : filtres secondaires (annee, pays, tri) ── #}
    {#
       On affiche cette ligne seulement si des donnees de filtrage sont disponibles
       (des annees OU des pays en base) ou si un tri non-defaut est actif.
       Cela evite une barre vide sur un catalogue neuf sans ressources.
    #}
    {% if availableYears is not empty or availableCountries is not empty or currentSort != 'recent' %}
    <div class="filter-bar__row2">

        {# Label visuel pour la serie de filtres secondaires #}
        <span class="filter-bar__label">Affiner</span>

        {# Select annee de deadline #}
        {#
            Affiche uniquement les annees pour lesquelles des ressources publiees
            ont une deadline — peuples par ResourceRepository::findAvailableDeadlineYears().
            Si aucune annee disponible, le select est masque.
        #}
        {% if availableYears is not empty %}
            <select class="filter-bar__select" name="year" aria-label="Filtrer par annee de deadline">
                <option value="">Toutes les annees</option>
                {% for yr in availableYears %}
                    <option value="{{ yr }}"
                            {% if currentYear == yr %}selected{% endif %}>
                        {{ yr }}
                    </option>
                {% endfor %}
            </select>
        {% endif %}

        {# Select pays / territoire #}
        {#
            Affiche uniquement les pays reellement presents dans le catalogue
            (via ResourceRepository::findAvailableCountries()).
        #}
        {% if availableCountries is not empty %}
            <select class="filter-bar__select" name="country" aria-label="Filtrer par pays ou territoire">
                <option value="">Tous les pays</option>
                {% for c in availableCountries %}
                    <option value="{{ c }}"
                            {% if currentCountry == c %}selected{% endif %}>
                        {{ c }}
                    </option>
                {% endfor %}
            </select>
        {% endif %}

        {# Select tri : recemment publiees (defaut) ou par deadline #}
        <select class="filter-bar__select" name="sort" aria-label="Trier les resultats">
            <option value="recent"   {% if currentSort == 'recent' %}selected{% endif %}>
                Recemment publiees
            </option>
            <option value="deadline" {% if currentSort == 'deadline' %}selected{% endif %}>
                Par date limite
            </option>
        </select>

        {# Lien de reinitialisation si au moins un filtre est actif #}
        {#
            On verifie l'ensemble des filtres actifs.
            currentSearch est '' (chaine vide) quand absent, les autres sont null.
        #}
        {% if currentSearch or currentTypeId or currentDisciplineId or currentYear or currentCountry or currentSort != 'recent' %}
            <a href="{{ path('app_resource_index') }}"
               class="filter-bar__reset"
               aria-label="Reinitialiser tous les filtres">
                &#215; Reinitialiser
            </a>
        {% endif %}

    </div>
    {% endif %}

</form>

{# ── Contenu principal : resultats ou etat vide ───────────────────────────── #}
{% if resources is empty %}

    {# ── Etat vide ── #}
    {# Deux cas : filtre sans resultat, ou catalogue vraiment vide #}
    <div class="empty-state">

        <div class="empty-state__icon">00</div>

        {% if currentSearch or currentTypeId or currentDisciplineId or currentYear or currentCountry %}
            <div class="empty-state__title">Aucun resultat</div>
            <p class="empty-state__text">
                Aucune opportunite ne correspond a vos criteres de recherche.<br>
                Essayez avec des mots-cles differents ou elargissez les filtres.
            </p>
            <a href="{{ path('app_resource_index') }}" class="empty-state__cta">
                Voir toutes les opportunites
            </a>
        {% else %}
            <div class="empty-state__title">Pas encore d'opportunites</div>
            {% if is_granted('ROLE_STRUCTURE') %}
                <p class="empty-state__text">
                    Le catalogue est vide pour l'instant.<br>
                    Soyez la premiere structure a partager une opportunite avec la communaute.
                </p>
                <a href="{{ path('app_resource_submit') }}" class="empty-state__cta">
                    Soumettre une ressource
                </a>
            {% else %}
                <p class="empty-state__text">
                    Le catalogue est vide pour l'instant.<br>
                    Les opportunites proposees par les structures partenaires apparaitront ici.
                </p>
            {% endif %}
        {% endif %}
    </div>

{% else %}

    {# ── Meta : compteur de resultats + tri actif ─────────────────────────── #}
    <p class="results-meta">
        <span>
            &#8594; {{ total }} resultat{{ total > 1 ? 's' : '' }}
            {% if currentSearch %} &middot; "{{ currentSearch|e }}"{% endif %}
            {% if currentYear %} &middot; {{ currentYear }}{% endif %}
            {% if currentCountry %} &middot; {{ currentCountry|e }}{% endif %}
            {% if totalPages > 1 %} &middot; page {{ currentPage }}/{{ totalPages }}{% endif %}
        </span>
        <span>
            {% if currentSort == 'deadline' %}
                Triees par date limite
            {% else %}
                Recemment publiees
            {% endif %}
        </span>
    </p>

    {# ──────────────────────────────────────────────────────────────────────── #}
    {# VUE GRILLE — seule vue disponible (la vue liste a ete supprimee)         #}
    {#                                                                          #}
    {# Grille 3 colonnes desktop / 2 tablette / 1 mobile.                      #}
    {# Cartes enrichies avec : logo, tags Type (lime) + Discipline (orange),   #}
    {# date de publication, deadline, montant financement, territoire/pays.     #}
    {# ──────────────────────────────────────────────────────────────────────── #}
    <div class="view-grid">
        {% for resource in resources %}
            <a href="{{ path('app_resource_show', {id: resource.id}) }}"
               class="grid-card"
               aria-label="Voir l'opportunite : {{ resource.title|e }}">

                {# ── Ligne superieure : logo + badges ── #}
                {#
                    Affichage cote a cote du logo et des badges type/discipline.
                    Les badges sont empiles verticalement a cote du logo.
                    Type → fond lime --accent (vert) = classification principale
                    Disciplines → fond orange --accent-2 = categories artistiques
                    (couleurs intentionnellement distinctes pour identifier rapidement
                    le type d'opportunite vs le domaine artistique cible)
                #}
                <div class="grid-card__top">

                    {# Logo de l'organisme : image distante ou repli Bazaart #}
                    {% if resource.logoUrl %}
                        <div class="card-logo">
                            <img src="{{ resource.logoUrl|e }}"
                                 alt="Logo {{ resource.title|e }}"
                                 loading="lazy"
                                 onerror="this.onerror=null; this.src='{{ asset('images/favicon.png') }}'; this.alt='Bazaart';">
                        </div>
                    {% else %}
                        <div class="card-logo card-logo--bazaart">
                            <img src="{{ asset('images/favicon.png') }}"
                                 alt="Bazaart"
                                 loading="lazy">
                        </div>
                    {% endif %}

                    {# Badges : Type (lime) puis Disciplines (orange) #}
                    <div class="grid-card__badges">

                        {# Badge type : fond lime --accent, texte encre #}
                        {# Affiche uniquement si le type est renseigne (champ nullable) #}
                        {% if resource.resourceType %}
                            <span class="badge-type">{{ resource.resourceType.name|e }}</span>
                        {% endif %}

                        {#
                            Disciplines : fond orange --accent-2 pour les distinguer visuellement du Type.
                            On affiche max 2 disciplines, puis "+N" si d'autres.
                            Cela evite de surcharger la carte dans les cas multi-disciplines.
                        #}
                        {% for discipline in resource.disciplines|slice(0, 2) %}
                            <span class="badge-disc">{{ discipline.name|e }}</span>
                        {% endfor %}
                        {% if resource.disciplines|length > 2 %}
                            <span class="badge-disc-more">+{{ resource.disciplines|length - 2 }}</span>
                        {% endif %}

                    </div>
                </div>

                {# ── Titre de l'opportunite ── #}
                <h2 class="grid-card__title">{{ resource.title|e }}</h2>

                {# ── Dates : publication + deadline ── #}
                {#
                    On affiche deux lignes si les deux informations sont presentes :
                      - PUBLIE le xx/xx/xxxx (publishedAt)
                      - LIMITE le xx/xx/xxxx (deadline)
                    Pour la deadline, on calcule si elle est urgente (moins de 7 jours).
                    Une deadline urgente s'affiche en orange avec badge "URGENT".
                #}
                <div class="grid-card__dates">

                    {# Date de publication (publishedAt) #}
                    {% if resource.publishedAt %}
                        <div class="grid-card__date-line">
                            <span class="grid-card__date-label">Publie</span>
                            <span class="grid-card__date-val">
                                {{ resource.publishedAt|date('d M Y') }}
                            </span>
                        </div>
                    {% endif %}

                    {# Deadline avec detection d'urgence #}
                    {% if resource.deadline %}
                        {#
                            Calcul du nombre de secondes entre maintenant et la deadline.
                            |date("U") retourne le timestamp Unix d'un DateTimeInterface.
                            604800 = 7 * 24 * 3600 = nombre de secondes dans 7 jours.
                        #}
                        {% set secondsLeft = resource.deadline|date("U") - "now"|date("U") %}

                        <div class="grid-card__date-line">
                            <span class="grid-card__date-label">Limite</span>
                            {% if secondsLeft >= 0 and secondsLeft < 604800 %}
                                {# Deadline dans moins de 7 jours : urgence visuelle #}
                                <span class="grid-card__date-val grid-card__date-val--urgent">
                                    {{ resource.deadline|date('d M Y') }}
                                </span>
                                <span class="badge-urgent">URGENT</span>
                            {% elseif secondsLeft >= 0 %}
                                {# Deadline future non urgente #}
                                <span class="grid-card__date-val">
                                    {{ resource.deadline|date('d M Y') }}
                                </span>
                            {% endif %}
                        </div>
                    {% endif %}

                </div>

                {# ── Montant de financement ── #}
                {#
                    Affiche si fundingAmount OU fundingType est renseigne.
                    fundingAmount : valeur lisible (ex: "5 000 EUR", "jusqu'a 10 000 EUR")
                    fundingType   : nature du financement (ex: "Bourse en argent", "Prise en charge")
                    Ces deux champs sont independants : l'un peut etre renseigne sans l'autre.
                #}
                {% if resource.fundingAmount or resource.fundingType %}
                    <div class="grid-card__funding">
                        {% if resource.fundingAmount %}
                            {{ resource.fundingAmount|e }}
                        {% endif %}
                        {% if resource.fundingType %}
                            <span class="grid-card__funding-sub">
                                {{ resource.fundingType|e }}
                            </span>
                        {% endif %}
                    </div>
                {% endif %}

                {# ── Territoire / Pays ── #}
                {#
                    Priorite d'affichage : city + country > city > country > location.
                    On construit un libelle de localisation en Twig, puis on l'affiche
                    comme chip de pays pour coherence visuelle avec les filtres.

                    Pourquoi un seul chip et pas deux ?
                    En contexte catalogue (vue grille), l'espace est reduit.
                    La page de detail (show.html.twig) peut afficher les deux.
                #}
                {% set locLabel = '' %}
                {% if resource.city and resource.country %}
                    {% set locLabel = resource.city ~ ', ' ~ resource.country %}
                {% elseif resource.city %}
                    {% set locLabel = resource.city %}
                {% elseif resource.country %}
                    {% set locLabel = resource.country %}
                {% elseif resource.location %}
                    {% set locLabel = resource.location %}
                {% endif %}

                {% if locLabel %}
                    <div class="grid-card__territory">
                        <span class="badge-country">{{ locLabel|e }}</span>
                    </div>
                {% endif %}

            </a>
        {% endfor %}
    </div>
    {# ── Fin vue grille ── #}

    {# ── Pagination ──────────────────────────────────────────────────────── #}
    {#
       Affichee uniquement quand il y a plus d'une page.
       Chaque lien PRESERVE les filtres actifs (type, discipline, search, year,
       country, sort) pour que la navigation entre pages ne reinitialise pas
       la recherche.

       Fenetre de 5 pages max autour de la page courante (2 avant + 2 apres).
    #}
    {% if totalPages > 1 %}

        {# Calcul de la fenetre de pagination #}
        {% set windowStart = max(1, currentPage - 2) %}
        {% set windowEnd   = min(totalPages, currentPage + 2) %}

        {#
            Parametres de base : on n'inclut un parametre que s'il a une valeur
            non-vide pour garder des URLs propres.
        #}
        {% set baseParams = {} %}
        {% if currentTypeId %}
            {% set baseParams = baseParams|merge({ type: currentTypeId }) %}
        {% endif %}
        {% if currentDisciplineId %}
            {% set baseParams = baseParams|merge({ discipline: currentDisciplineId }) %}
        {% endif %}
        {% if currentSearch %}
            {% set baseParams = baseParams|merge({ q: currentSearch }) %}
        {% endif %}
        {% if currentYear %}
            {% set baseParams = baseParams|merge({ year: currentYear }) %}
        {% endif %}
        {% if currentCountry %}
            {% set baseParams = baseParams|merge({ country: currentCountry }) %}
        {% endif %}
        {% if currentSort != 'recent' %}
            {% set baseParams = baseParams|merge({ sort: currentSort }) %}
        {% endif %}

        <nav class="pagination-wrap" aria-label="Navigation entre les pages de ressources">
            <ul class="pagination">

                {# Lien "Precedent" : desactive sur la page 1 #}
                <li class="page-item {% if currentPage <= 1 %}disabled{% endif %}">
                    {% if currentPage > 1 %}
                        <a class="page-link"
                           href="{{ path('app_resource_index', baseParams|merge({ page: currentPage - 1 })) }}"
                           aria-label="Page precedente">
                            &larr; Prec.
                        </a>
                    {% else %}
                        <span class="page-link" aria-hidden="true">&larr; Prec.</span>
                    {% endif %}
                </li>

                {# Points de suspension au debut si la fenetre ne commence pas a 1 #}
                {% if windowStart > 1 %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_resource_index', baseParams|merge({ page: 1 })) }}"
                           aria-label="Page 1">1</a>
                    </li>
                    {% if windowStart > 2 %}
                        <li class="page-item disabled" aria-hidden="true">
                            <span class="page-link">&hellip;</span>
                        </li>
                    {% endif %}
                {% endif %}

                {# Numeros de page dans la fenetre #}
                {% for p in windowStart..windowEnd %}
                    <li class="page-item {% if p == currentPage %}active{% endif %}">
                        {% if p == currentPage %}
                            <span class="page-link" aria-current="page">{{ p }}</span>
                        {% else %}
                            <a class="page-link"
                               href="{{ path('app_resource_index', baseParams|merge({ page: p })) }}"
                               aria-label="Page {{ p }}">{{ p }}</a>
                        {% endif %}
                    </li>
                {% endfor %}

                {# Points de suspension a la fin #}
                {% if windowEnd < totalPages %}
                    {% if windowEnd < totalPages - 1 %}
                        <li class="page-item disabled" aria-hidden="true">
                            <span class="page-link">&hellip;</span>
                        </li>
                    {% endif %}
                    <li class="page-item">
                        <a class="page-link"
                           href="{{ path('app_resource_index', baseParams|merge({ page: totalPages })) }}"
                           aria-label="Page {{ totalPages }}">{{ totalPages }}</a>
                    </li>
                {% endif %}

                {# Lien "Suivant" : desactive sur la derniere page #}
                <li class="page-item {% if currentPage >= totalPages %}disabled{% endif %}">
                    {% if currentPage < totalPages %}
                        <a class="page-link"
                           href="{{ path('app_resource_index', baseParams|merge({ page: currentPage + 1 })) }}"
                           aria-label="Page suivante">
                            Suiv. &rarr;
                        </a>
                    {% else %}
                        <span class="page-link" aria-hidden="true">Suiv. &rarr;</span>
                    {% endif %}
                </li>

            </ul>
        </nav>

    {% endif %}
    {# ── Fin pagination ── #}

{% endif %}
{# ── Fin bloc resultats ── #}

{% endblock %}
