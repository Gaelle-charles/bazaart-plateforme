{% extends 'base_app.html.twig' %}

{#
 # resource/show.html.twig — Détail d'une ressource / opportunité
 #
 # Thème : Street (app connectée)
 # Layout : 2 colonnes (70% contenu principal / 30% sidebar)
 # Référence prototype : ScreenOpportunity dans screens-opps.jsx
 #
 # Variables Twig disponibles :
 #   resource      — entité Resource (avec resourceType, disciplines, organization, etc.)
 #   isFavorited   — bool, si l'utilisateur connecté a mis cette ressource en favori
 #   favoriteCount — int, nombre total de personnes ayant mis en favori
 #   user          — app.user (peut être null si non connecté)
 #}

{% block title %}{{ resource.title }} — Bazaart{% endblock %}
{% block page_title %}Ressources{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ═══════════════════════════════════════════════════════════════════════
       DÉTAIL RESSOURCE — styles thème Street
       Layout 2 colonnes à partir de 900px, colonne unique sur mobile.
    ═══════════════════════════════════════════════════════════════════════ */

    /* ── Fil d'Ariane (breadcrumb) ─────────────────────────────────────── */

    /* Style mono discret — informationnel, pas décoratif */
    .breadcrumb {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-bottom: var(--space-lg);
        flex-wrap: wrap;
    }

    .breadcrumb a {
        color: var(--ink-mute);
        text-decoration: none;
        transition: color var(--transition-fast);
    }
    .breadcrumb a:hover { color: var(--ink); }

    /* Séparateur entre les items du fil d'Ariane */
    .breadcrumb__sep { opacity: .4; }

    /* Item courant : encre foncée, pas de lien */
    .breadcrumb__current { color: var(--ink); }

    /* ── Bande héro (en-tête foncée, style prototype) ─────────────────── */

    /* Fond encre sombre : contraste fort — met en valeur le titre de la ressource.
       C'est le pattern "hero band" du ScreenOpportunity dans screens-opps.jsx. */
    .resource-hero {
        background: var(--ink);
        color: var(--bg);
        border: 1px solid var(--ink);
        padding: var(--space-xl) var(--space-xl) var(--space-2xl);
        margin-bottom: var(--space-xl);
        position: relative;
    }

    /* Ligne des badges en haut du héro : type + disciplines */
    .resource-hero__badges {
        display: flex;
        gap: var(--space-sm);
        flex-wrap: wrap;
        margin-bottom: var(--space-lg);
    }

    /* Badge type principal : fond accent vert acide sur fond sombre = très lisible */
    .hero-badge-type {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: var(--chip-padding);
        background: var(--accent);
        color: var(--ink);
        font-family: var(--mono);
        font-size: var(--chip-font-size);
        font-weight: var(--chip-font-weight);
        letter-spacing: var(--chip-letter-spacing);
        text-transform: uppercase;
        border-radius: var(--chip-radius);
    }

    /* Badge discipline : transparent avec bordure crème — subtil */
    .hero-badge-disc {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: var(--chip-padding);
        background: transparent;
        color: var(--bg);
        border: 1px solid rgba(242, 239, 230, .3);
        font-family: var(--mono);
        font-size: var(--chip-font-size);
        font-weight: var(--chip-font-weight);
        letter-spacing: var(--chip-letter-spacing);
        text-transform: uppercase;
        border-radius: var(--chip-radius);
    }

    /* Badge "Deadline proche" : orange intense sur fond sombre = alerte visuelle */
    .hero-badge-urgent {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: var(--chip-padding);
        background: var(--accent-2);
        color: var(--ink);
        font-family: var(--mono);
        font-size: var(--chip-font-size);
        font-weight: var(--chip-font-weight);
        letter-spacing: var(--chip-letter-spacing);
        text-transform: uppercase;
        border-radius: var(--chip-radius);
    }

    /* Titre H1 : très grand, Archivo Black, fond sombre — impact maximum */
    .resource-hero__title {
        font-family: var(--display);
        font-size: clamp(36px, 5vw, 72px);
        line-height: .92;
        color: var(--bg);
        text-transform: uppercase;
        margin: 0 0 var(--space-xl);
    }

    /* Ligne méta sous le titre : organisation + lieu + date #}
       Reprend la ligne "méta" du prototype (avatar org + séparateurs) */
    .resource-hero__meta {
        display: flex;
        align-items: center;
        gap: var(--space-lg);
        flex-wrap: wrap;
        font-size: 13px;
        color: rgba(242, 239, 230, .75);
    }

    .resource-hero__meta-item {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
    }

    /* Séparateur vertical entre les infos méta */
    .resource-hero__meta-sep {
        width: 1px;
        height: 24px;
        background: rgba(242, 239, 230, .2);
    }

    /* Bloc deadline en haut à droite du héro (style "countdown" du prototype) */
    .resource-hero__deadline {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: var(--space-sm);
        margin-left: auto;
        flex-shrink: 0;
    }

    /* Grille countdown J/H/M — carreaux accent sur fond sombre */
    .deadline-grid {
        display: flex;
        gap: 0;
    }

    /* Chaque case : un chiffre + label — style affiche très structuré */
    .deadline-cell {
        background: var(--accent);
        color: var(--ink);
        padding: var(--space-md) var(--space-md);
        text-align: center;
        min-width: 56px;
        border-right: 1px solid var(--ink);
    }
    .deadline-cell:last-child { border-right: none; }

    .deadline-cell__num {
        font-family: var(--display);
        font-size: 32px;
        line-height: 1;
    }

    .deadline-cell__label {
        font-family: var(--mono);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        margin-top: 4px;
    }

    /* ── Layout 2 colonnes ─────────────────────────────────────────────── */

    /* Colonne unique sur mobile, 2 colonnes à partir de 900px
       70/30 pour donner la priorité au contenu */
    .resource-layout {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--space-xl);
        align-items: start;
    }

    @media (min-width: 900px) {
        .resource-layout {
            grid-template-columns: 2fr 1fr;
        }
    }

    /* ── Colonne principale ────────────────────────────────────────────── */

    .resource-main { display: flex; flex-direction: column; gap: var(--space-xl); }

    /* ── Bloc financement + candidature (ADR-0018) ───────────────────────── */

    /*
     * Ce bloc « En un coup d'oeil » apparaît EN TÊTE de la colonne principale,
     * avant la description, pour que l'artiste sache immédiatement le montant
     * et comment candidater sans avoir à lire tout le texte.
     *
     * Style : fond bg-alt, bordure gauche accent lime épaisse = accent visuel
     * sans être intrusif. Cohérent avec le thème Street (bords francs, mono).
     */
    .funding-candidature-block {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
        border: 1px solid var(--ink);
        border-left: 4px solid var(--accent);
        background: var(--bg-alt);
        padding: var(--space-lg) var(--space-xl);
    }

    /* Ligne titre du bloc (eyebrow style) */
    .funding-candidature-block__eyebrow {
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-bottom: var(--space-xs);
    }

    /* Grille interne : montant à gauche, type à droite (si les deux existent) */
    .funding-grid {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-md) var(--space-xl);
        align-items: flex-start;
    }

    /* Bloc d'un champ financement : label + valeur */
    .funding-item {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    /* Label de champ (clé) */
    .funding-item__label {
        font-family: var(--mono);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-mute);
    }

    /* Valeur du champ financement : grande, affichée en display font */
    .funding-item__value {
        font-family: var(--display);
        font-size: 20px;
        line-height: 1.1;
        color: var(--ink);
    }

    /* Valeur secondaire (fundingType) : plus petite, serif */
    .funding-item__value--secondary {
        font-family: var(--body);
        font-size: 14px;
        font-weight: 600;
        color: var(--ink);
    }

    /* Section "Comment candidater" : séparée du financement */
    .how-to-apply {
        border-top: 1px solid var(--line-soft);
        padding-top: var(--space-md);
        margin-top: var(--space-xs);
    }

    /* Contenu howToApply : préserve les sauts de ligne via white-space */
    .how-to-apply__content {
        font-family: var(--body);
        font-size: 14px;
        line-height: 1.65;
        color: var(--ink);
        /* white-space: pre-line interprète les \n comme des sauts de ligne HTML.
           Le filtre nl2br Twig sera utilisé en fallback si le contenu vient du LLM
           sans balises HTML — voir le bloc de rendu Twig ci-dessous. */
        white-space: pre-line;
    }

    /* Bouton CTA externe "Candidater" — plein accent lime, pleine largeur sur mobile */
    .btn-candidater {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-sm);
        padding: var(--btn-padding);
        background: var(--accent);
        color: var(--ink);
        border: 2px solid var(--ink);
        font-family: var(--body);
        font-size: var(--btn-font-size);
        font-weight: var(--btn-font-weight);
        letter-spacing: var(--btn-letter-spacing);
        text-transform: uppercase;
        text-decoration: none;
        border-radius: var(--btn-radius);
        transition: background var(--transition-fast), color var(--transition-fast);
        align-self: flex-start;
    }
    .btn-candidater:hover {
        background: var(--ink);
        color: var(--accent);
    }

    /* ── ADR-0019 : bouton secondaire "En savoir plus" ──────────────────────
       Variante outline du bouton CTA — utilisé quand applicationUrl est présent
       et que externalUrl joue le rôle de page de présentation uniquement. */
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-sm);
        padding: var(--btn-padding);
        background: transparent;
        color: var(--ink);
        border: 2px solid var(--ink);
        font-family: var(--body);
        font-size: var(--btn-font-size);
        font-weight: var(--btn-font-weight);
        letter-spacing: var(--btn-letter-spacing);
        text-transform: uppercase;
        text-decoration: none;
        border-radius: var(--btn-radius);
        transition: background var(--transition-fast), color var(--transition-fast);
        align-self: flex-start;
    }
    .btn-secondary:hover {
        background: var(--ink);
        color: var(--bg);
    }

    /* ── ADR-0019 : groupe de boutons CTA ───────────────────────────────────
       Contient le bouton primaire (applicationUrl) et le bouton secondaire
       (externalUrl) côte à côte, avec wrap mobile automatique. */
    .cta-group {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-md);
        align-items: center;
    }

    /* ── ADR-0019 : logo de l'organisme dans le hero ────────────────────────
       Affiché en coin haut-droit du hero (position absolute dans le hero
       qui est déjà position:relative).
       Sur mobile : position statique dans le flux des badges pour ne pas
       chevaucher le titre.

       Taille : 56×56 px (idem que les cartes de la vue liste/grille mais
       légèrement mis en valeur par la position hero et le fond blanc tranchant
       sur le fond sombre de la hero band).
       object-fit: contain → le logo est contenu dans le carré sans déformation. */
    .resource-hero__logo {
        position: absolute;
        top: var(--space-xl);
        right: var(--space-xl);
        width: 56px;
        height: 56px;
        min-width: 56px; /* évite le rétrécissement flexbox si jamais utilisé en flex */
        background: #ffffff; /* fond blanc neutre : le logo se détache sur fond clair */
        border: 1px solid rgba(242,239,230,.3);
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Image du logo dans le hero : contenue sans déformation */
    .resource-hero__logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }

    /* Variante repli Bazaart : fond légèrement teinté pour distinguer visuellement
       le favicon Bazaart d'un vrai logo d'organisme (pas de fond lime qui était
       le badge "B" — remplacé par une image réelle). */
    .resource-hero__logo--bazaart {
        background: var(--bg-alt, #E8E5DC);
        border: 1px solid rgba(242,239,230,.5);
    }

    /* Sur mobile : logo dans le flux (pas en absolu), pour éviter le chevauchement */
    @media (max-width: 640px) {
        .resource-hero__logo {
            position: static;
            margin-bottom: var(--space-sm);
        }
    }

    /* ── ADR-0019 : miniature logo dans les cartes de la liste ──────────────
       Ce fichier (show.html.twig) est la référence des styles logo, même si les
       cartes sont rendues dans index.html.twig. Les classes .card-logo sont
       redéfinies dans index.html.twig avec les mêmes valeurs pour portabilité. */
    .card-logo {
        width: 48px;
        height: 48px;
        min-width: 48px;
        background: #ffffff;
        border: 1px solid var(--line-soft);
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .card-logo img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }
    /* Variante repli : fond bg-alt pour distinguer du logo réel */
    .card-logo--bazaart {
        background: var(--bg-alt, #E8E5DC);
        border-color: var(--line-soft);
    }

    /* Corps de description : on utilise le serif pour donner un caractère
       éditorial à la description (conforme au prototype "En bref / summary") */
    .resource-desc {
        font-family: var(--serif);
        font-size: 16px;
        line-height: 1.75;
        color: var(--ink-mute);
    }

    /* Section disciplines : titre label + chips */
    .resource-disciplines {
        border-top: 1px solid var(--line-soft);
        padding-top: var(--space-lg);
    }

    /* Label de section : mono uppercase très petit = style "eyebrow" */
    .section-label {
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-bottom: var(--space-sm);
    }

    /* Liste de chips discipline */
    .disciplines-list {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-sm);
    }

    /* Chip discipline : fond bg-alt, bordure soft, mono */
    .discipline-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: var(--chip-padding);
        background: var(--bg-alt);
        border: 1px solid var(--line-soft);
        font-family: var(--mono);
        font-size: var(--chip-font-size);
        font-weight: var(--chip-font-weight);
        letter-spacing: var(--chip-letter-spacing);
        text-transform: uppercase;
        color: var(--ink-mute);
        border-radius: var(--chip-radius);
    }

    /* ── Chip niveau d'expérience (ADR-0016 Lot 3) ───────────────────────────
       Utilisé dans le tableau "Détails" de la sidebar.
       Style mono uppercase cohérent avec les autres chips Street.
       Variante par défaut (niveau précis) : fond bg-alt, encre douce.
       Variante "tous niveaux" : fond accent lime discret = indication positive
       (accès ouvert, pas de restriction). */
    .chip-level {
        display: inline-block;
        padding: var(--chip-padding);
        background: var(--bg-alt);
        border: 1px solid var(--line-soft);
        font-family: var(--mono);
        font-size: var(--chip-font-size);
        font-weight: var(--chip-font-weight);
        letter-spacing: var(--chip-letter-spacing);
        text-transform: uppercase;
        color: var(--ink);
        border-radius: var(--chip-radius);
    }

    /* Variante "Tous niveaux" : petite touche lime pour signaler l'ouverture */
    .chip-level--all {
        background: rgba(198, 242, 78, .18); /* accent lime atténué */
        border-color: rgba(198, 242, 78, .5);
        color: var(--ink);
    }

    /* ── Sidebar (colonne droite) ──────────────────────────────────────── */

    .resource-sidebar {
        display: flex;
        flex-direction: column;
        gap: var(--space-md);
    }

    /* Encadré générique de la sidebar : bordure ink, bords francs */
    .side-block {
        border: 1px solid var(--ink);
        padding: var(--space-lg);
        background: var(--bg);
    }

    /* En-tête de bloc sidebar = eyebrow formaté */
    .side-block__eyebrow {
        display: inline-flex;
        align-items: center;
        gap: var(--space-sm);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-bottom: var(--space-md);
    }
    .side-block__eyebrow::before {
        content: '';
        display: inline-block;
        width: 8px;
        height: 8px;
        background: var(--accent);
        flex-shrink: 0;
    }

    /* Tableau de détails (type, deadline, niveau…) dans la sidebar */
    .details-table {
        display: flex;
        flex-direction: column;
        gap: 0;
        border: 1px solid var(--line-soft);
    }

    .details-row {
        display: grid;
        grid-template-columns: 110px 1fr;
        gap: 0;
        border-bottom: 1px solid var(--line-soft);
    }
    .details-row:last-child { border-bottom: none; }

    /* Clé de la ligne (gauche) */
    .details-key {
        padding: var(--space-sm) var(--space-md);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ink-mute);
        background: var(--bg-alt);
        border-right: 1px solid var(--line-soft);
    }

    /* Valeur de la ligne (droite) */
    .details-val {
        padding: var(--space-sm) var(--space-md);
        font-family: var(--body);
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
    }

    /* Bloc organisation : avatar initiales + nom + badge vérifié */
    .org-block {
        display: flex;
        gap: var(--space-md);
        align-items: center;
        margin-bottom: var(--space-md);
    }

    /* Avatar organisation carré style Street (bords francs) */
    .org-avatar {
        width: 44px;
        height: 44px;
        background: var(--ink);
        color: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--display);
        font-size: 20px;
        font-weight: 700;
        flex-shrink: 0;
        border: 1px solid var(--ink);
    }

    .org-name {
        font-family: var(--body);
        font-size: 14px;
        font-weight: 700;
        color: var(--ink);
    }

    /* Badge "Vérifiée" : petit, vert discret */
    .org-verified {
        display: inline-block;
        margin-left: 6px;
        padding: 1px 5px;
        background: rgba(31, 138, 91, .12);
        color: var(--ok);
        font-family: var(--mono);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        border-radius: var(--radius-sm);
    }

    .org-location {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-mute);
        margin-top: 2px;
    }

    /* ── Bouton favori ─────────────────────────────────────────────────── */
    {#
       Ce bouton utilise les attributs data-* prévus pour Stimulus.
       Voir le commentaire dans le template original pour l'architecture AJAX.
       On conserve TOUS les attributs data-* existants — règle impérative #7.
    #}

    /* Formulaire favori : pleine largeur dans la sidebar */
    .favorite-form { margin-top: var(--space-md); }

    .btn-favorite {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-sm);
        width: 100%;
        padding: var(--btn-padding);
        background: transparent;
        color: var(--ink);
        border: 2px solid var(--ink);
        font-family: var(--body);
        font-size: var(--btn-font-size);
        font-weight: var(--btn-font-weight);
        letter-spacing: var(--btn-letter-spacing);
        text-transform: uppercase;
        cursor: pointer;
        border-radius: var(--btn-radius);
        transition: background var(--transition-fast), color var(--transition-fast);
    }
    .btn-favorite:hover {
        background: var(--ink);
        color: var(--bg);
    }

    /* État actif favori : fond encre = confirmé */
    .btn-favorite--active {
        background: var(--ink);
        color: var(--accent);
    }
    .btn-favorite--active:hover {
        background: var(--accent);
        color: var(--ink);
    }

    .favorite-count {
        font-family: var(--mono);
        font-size: 10px;
        opacity: .65;
    }

    /* ── Bloc "Soumettre similaire" — CTA accent dans la sidebar ── */
    .side-block--accent {
        background: var(--accent);
        border-color: var(--ink);
    }

    .side-block--accent .side-block__eyebrow::before {
        background: var(--ink);
    }

    .side-block--accent .side-block__eyebrow {
        color: var(--ink);
    }

    /* Lien interne dans le bloc accent */
    .btn-side-cta {
        display: inline-flex;
        align-items: center;
        gap: var(--space-sm);
        margin-top: var(--space-md);
        padding: var(--btn-padding-sm);
        background: var(--ink);
        color: var(--accent);
        border: 2px solid var(--ink);
        font-family: var(--body);
        font-size: var(--btn-font-size);
        font-weight: var(--btn-font-weight);
        letter-spacing: var(--btn-letter-spacing);
        text-transform: uppercase;
        text-decoration: none;
        border-radius: var(--btn-radius);
        transition: background var(--transition-fast), color var(--transition-fast);
    }
    .btn-side-cta:hover {
        background: var(--accent);
        color: var(--ink);
    }
</style>
{% endblock %}

{% block content %}

{# ── Fil d'Ariane ─────────────────────────────────────────────────────────── #}
{#
   Breadcrumb simple : Accueil > Ressources > Titre tronqué
   Pas de composant Twig dédié — on le construit directement.
   Le titre est tronqué à 40 caractères pour éviter un débordement.
#}
<nav class="breadcrumb" aria-label="Fil d'Ariane">
    <a href="{{ path('app_dashboard') }}">Accueil</a>
    <span class="breadcrumb__sep" aria-hidden="true">›</span>
    <a href="{{ path('app_resource_index') }}">Ressources</a>
    <span class="breadcrumb__sep" aria-hidden="true">›</span>
    <span class="breadcrumb__current" aria-current="page">
        {{ resource.title|slice(0, 40) }}{{ resource.title|length > 40 ? '…' : '' }}
    </span>
</nav>

{# ── Bande héro (fond encre, titre + badges) ──────────────────────────────── #}
{#
   Cette section reprend la "hero band" du prototype ScreenOpportunity :
   fond var(--ink) quasi-noir, titre géant en blanc/crème, countdown deadline.
   Elle sort du flux des 2 colonnes pour occuper toute la largeur.
#}
<div class="resource-hero">

    {#
       ADR-0019 : Logo de l'organisme émetteur de la ressource.
       Positionné en absolu dans le coin haut-droit du hero (voir CSS .resource-hero__logo).
       Sur mobile il revient dans le flux naturel (media query).

       Comportement :
         - Si resource.logoUrl est renseigné  → on affiche l'image (lazy loading, alt descriptif)
         - Si resource.logoUrl est vide/null  → badge "B" fond lime (fallback visuel cohérent)

       Sécurité anti-XSS :
         - logoUrl est affiché via |e (auto-escape Twig) — JAMAIS |raw
         - L'attribut onerror en JavaScript est minimaliste : il remplace l'img
           par le contenu HTML du badge si le chargement de l'image échoue.
           On ne peut pas faire de |raw côté serveur ici, donc on gère côté client.

       NB : on ne vérifie pas si l'image charge réellement depuis le serveur ;
            le navigateur gère le cas d'erreur réseau via l'attribut onerror.
    #}
    {% if resource.logoUrl %}
        {#
            Logo réel de l'organisme.
            En cas d'échec de chargement (onerror) :
              1. this.onerror=null   → désactive le handler pour éviter une boucle
                                       si favicon.png lui-même était inaccessible.
              2. this.src=...        → bascule vers le favicon Bazaart.
              3. this.alt='Bazaart'  → met à jour le texte alternatif.
            On ajoute aussi la classe --bazaart sur le conteneur pour le fond différencié.
        #}
        <div class="resource-hero__logo">
            <img src="{{ resource.logoUrl|e }}"
                 alt="Logo {{ resource.title|e }}"
                 loading="lazy"
                 onerror="this.onerror=null; this.src='{{ asset('images/favicon.png') }}'; this.alt='Bazaart'; this.parentElement.classList.add('resource-hero__logo--bazaart');">
        </div>
    {% else %}
        {#
            Pas de logo : on affiche le favicon/logo Bazaart dans le même emplacement
            56×56 px, avec la variante de fond --bazaart pour le différencier visuellement
            d'un logo d'organisme réel.
        #}
        <div class="resource-hero__logo resource-hero__logo--bazaart">
            <img src="{{ asset('images/favicon.png') }}"
                 alt="Bazaart"
                 loading="lazy">
        </div>
    {% endif %}

    {# Badges : type de ressource + disciplines + "Deadline proche" si urgente #}
    <div class="resource-hero__badges">

        {# Badge type principal — accent sur fond sombre #}
        <span class="hero-badge-type">
            {{ resource.resourceType.icon ? resource.resourceType.icon ~ ' ' : '' }}{{ resource.resourceType.name }}
        </span>

        {# Badges disciplines — transparents avec bordure crème #}
        {% for discipline in resource.disciplines %}
            <span class="hero-badge-disc">
                {{ discipline.icon ? discipline.icon ~ ' ' : '' }}{{ discipline.name }}
            </span>
        {% endfor %}

        {# Badge urgence deadline : visible si moins de 7 jours avant la deadline #}
        {% if resource.deadline %}
            {% set daysLeft = (resource.deadline.timestamp - "now"|date('U')) // 86400 %}
            {% if daysLeft >= 0 and daysLeft < 7 %}
                <span class="hero-badge-urgent">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                        <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                    Deadline proche
                </span>
            {% endif %}
        {% endif %}
    </div>

    {# Ligne titre + countdown deadline côte à côte #}
    <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:var(--space-xl); flex-wrap:wrap;">

        {# Titre H1 : grand, uppercase, Archivo Black sur fond sombre #}
        <h1 class="resource-hero__title">{{ resource.title }}</h1>

        {# Countdown deadline (style "cases" du prototype) — visible si deadline future #}
        {% if resource.deadline %}
            {% set daysLeft = (resource.deadline.timestamp - "now"|date('U')) // 86400 %}
            {% if daysLeft >= 0 %}
                <div class="resource-hero__deadline">
                    <div class="section-label" style="color:rgba(242,239,230,.6); margin-bottom:var(--space-xs);">
                        Deadline
                    </div>
                    <div class="deadline-grid">
                        {# Jours restants — la valeur principale #}
                        <div class="deadline-cell">
                            <div class="deadline-cell__num">{{ daysLeft|number_format(0) }}</div>
                            <div class="deadline-cell__label">{{ daysLeft > 1 ? 'Jours' : 'Jour' }}</div>
                        </div>
                        {# Date exacte en 2e case : plus compact qu'afficher h/min #}
                        <div class="deadline-cell" style="min-width:auto; padding:var(--space-md) var(--space-lg);">
                            <div class="deadline-cell__num" style="font-size:18px;">{{ resource.deadline|date('d/m') }}</div>
                            <div class="deadline-cell__label">{{ resource.deadline|date('Y') }}</div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endif %}
    </div>

    {# Méta : organisation + date de publication #}
    <div class="resource-hero__meta">
        {% if resource.organization %}
            <div class="resource-hero__meta-item">
                {# Icône immeuble SVG (organisation) #}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                    <polyline points="9 22 9 12 15 12 15 22"/>
                </svg>
                <strong style="color:var(--bg);">{{ resource.organization.name }}</strong>
                {% if resource.organization.isVerified %}
                    <span style="font-family:var(--mono); font-size:9px; letter-spacing:.06em; opacity:.7;">· VÉRIFIÉ</span>
                {% endif %}
            </div>
            <div class="resource-hero__meta-sep" aria-hidden="true"></div>
        {% endif %}

        <div class="resource-hero__meta-item">
            {# Icône calendrier SVG #}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="16"/><path d="M3 9h18M8 3v4M16 3v4"/>
            </svg>
            Publiée le {{ resource.createdAt|date('d/m/Y') }}
        </div>

        {#
            Localisation — logique de priorité (ADR-0016 Lot 3) :
            1. Si city ET country sont renseignés  → "Ville, Pays"
            2. Si city seule                       → "Ville"
            3. Si country seul                     → "Pays"
            4. Sinon : fallback sur l'ancien champ libre $location
            5. Si tout est vide                    → bloc absent (pas de label vide)

            On construit d'abord une variable Twig `locationLabel` pour éviter
            de dupliquer la condition dans le SVG + le texte.
        #}
        {% set locationLabel = '' %}
        {% if resource.city and resource.country %}
            {% set locationLabel = resource.city ~ ', ' ~ resource.country %}
        {% elseif resource.city %}
            {% set locationLabel = resource.city %}
        {% elseif resource.country %}
            {% set locationLabel = resource.country %}
        {% elseif resource.location %}
            {% set locationLabel = resource.location %}
        {% endif %}

        {% if locationLabel %}
            <div class="resource-hero__meta-sep" aria-hidden="true"></div>
            <div class="resource-hero__meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 22s-7-7-7-12a7 7 0 1 1 14 0c0 5-7 12-7 12z"/>
                    <circle cx="12" cy="10" r="2.5"/>
                </svg>
                {{ locationLabel }}
            </div>
        {% endif %}
    </div>

</div>

{# ── Layout 2 colonnes : contenu + sidebar ────────────────────────────────── #}
<div class="resource-layout">

    {# ═══════ COLONNE PRINCIPALE (gauche, 70%) ═══════ #}
    <div class="resource-main">

        {# ── ADR-0018 : Bloc financement + candidature ── #}
        {#
           Ce bloc est affiché EN TÊTE de la colonne principale, avant tout le reste.
           Il donne à l'artiste l'information la plus actionnable immédiatement :
             - Montant et nature du financement (fundingAmount + fundingType)
             - Modalités de candidature (howToApply)

           RENDU CONDITIONNEL :
             - Le bloc n'est affiché que si AU MOINS l'un des 3 champs est renseigné.
             - Chaque sous-section (financement, candidature) est elle-même conditionnelle.
             - Zéro tiret cadratin ajouté (règle de typographie du projet).

           SÉCURITÉ XSS (important) :
             - resource.howToApply contient du texte produit par le LLM (pas de HTML garanti).
             - On utilise `resource.howToApply|e|nl2br` pour :
                 1. `|e` : échappement HTML automatique (protège contre les injections XSS)
                 2. `|nl2br` : convertit les \n en <br> pour préserver les sauts de ligne
             - On N'UTILISE PAS `|raw` sur ce champ (règle absolue pour le contenu LLM libre).
             - resource.description (champ HTML Mistral avec balises <p><ul><li><strong>)
               continue à utiliser `|raw` car le pipeline d'enrichissement garantit
               que seules ces balises sont présentes (cf. OpportunityEnrichmentService).
             - resource.fundingAmount et resource.fundingType sont de courtes strings texte
               → échappement automatique de Twig (pas de |raw ni de |nl2br nécessaires).
        #}
        {% if resource.fundingAmount or resource.fundingType or resource.howToApply %}
            <div class="funding-candidature-block">
                <div class="funding-candidature-block__eyebrow">En un coup d'oeil</div>

                {# Sous-section financement : affiché uniquement si au moins un des deux champs existe #}
                {% if resource.fundingAmount or resource.fundingType %}
                    <div class="funding-grid">

                        {# Montant : affiché en grand (display font) si renseigné #}
                        {% if resource.fundingAmount %}
                            <div class="funding-item">
                                <span class="funding-item__label">Montant</span>
                                <span class="funding-item__value">{{ resource.fundingAmount }}</span>
                            </div>
                        {% endif %}

                        {# Nature du financement : affiché en plus petit si renseignée #}
                        {% if resource.fundingType %}
                            <div class="funding-item">
                                <span class="funding-item__label">Nature</span>
                                <span class="funding-item__value--secondary">{{ resource.fundingType }}</span>
                            </div>
                        {% endif %}

                    </div>
                {% endif %}

                {# Sous-section "Comment candidater" : affiché uniquement si howToApply est renseigné #}
                {% if resource.howToApply %}
                    <div class="how-to-apply">
                        <div class="funding-candidature-block__eyebrow">Comment candidater</div>
                        {#
                           EXPLICATION DU FILTRE `|e('html')|nl2br` :
                           Le texte de howToApply vient du LLM (texte libre, pas de HTML structuré).
                           On ne peut pas lui faire confiance pour contenir du HTML valide ou sûr.
                           Stratégie :
                             1. `|e('html')` : Twig échappe les caractères HTML spéciaux
                                (< > & " ') → protège contre les injections XSS.
                                On utilise la forme EXPLICITE `|e('html')` plutôt que l'auto-échappement
                                implicite de Twig pour deux raisons :
                                  a) Rendre l'intention de sécurité visible et auditable dans le code.
                                  b) Garantir le bon ordre : l'échappement AVANT nl2br.
                             2. `|nl2br` : après l'échappement, convertit \n en <br>.
                                L'ordre est CRITIQUE : si on faisait nl2br AVANT l'échappement,
                                les <br> injectés seraient à leur tour échappés en &lt;br&gt;
                                et n'auraient aucun effet visuel (texte affiché tel quel).
                                En Twig, |nl2br est appliqué sur le texte DÉJÀ échappé — les <br>
                                qu'il ajoute ne seront donc PAS re-échappés (Twig marque le résultat
                                comme "safe HTML" après nl2br).
                           Résultat : le contenu est sûr (XSS protégé) et les sauts de ligne
                           sont respectés (lisibilité des instructions de candidature).
                           PAS de double-échappement : `|e('html')` → chaîne échappée ;
                           `|nl2br` → Markup (safe) avec <br> — Twig n'échappe pas à nouveau.
                        #}
                        <div class="how-to-apply__content">
                            {{ resource.howToApply|e('html')|nl2br }}
                        </div>
                    </div>
                {% endif %}

            </div>
        {% endif %}

        {#
           ── ADR-0019 : Boutons CTA ────────────────────────────────────────────
           Deux scénarios selon les données disponibles :

           A) applicationUrl présent (lien de candidature DIRECT extrait par LLM) :
              → Bouton PRIMAIRE  : "Candidater" → applicationUrl  (accent lime + encre)
              → Bouton secondaire: "En savoir plus" → externalUrl (outline, si externalUrl existe)
              Logique : l'artiste veut candidater directement — inutile de
              l'envoyer d'abord sur la page de présentation.

           B) Pas d'applicationUrl (ancienne logique) :
              → Bouton PRIMAIRE  : "Candidater / En savoir plus" → externalUrl
              (comportement identique à avant ADR-0019, rétro-compatible)

           Sécurité :
              - applicationUrl est affiché via auto-escape Twig (|e implicite dans href="{{ }}")
              - JAMAIS de |raw sur ces URLs
              - rel="noopener noreferrer" sur tous les liens externes

           Si ni applicationUrl ni externalUrl → aucun bouton affiché.
        #}
        {% if resource.applicationUrl or resource.externalUrl %}
            <div class="cta-group">

                {% if resource.applicationUrl %}
                    {# ── Cas A : bouton primaire "Candidater" vers applicationUrl ── #}
                    {#
                       applicationUrl est l'URL du bouton "Postuler / Déposer / Apply"
                       extrait par le LLM depuis les liens réels de la page source.
                       Garde anti-hallucination validée dans OpportunityEnrichmentService.
                       C'est l'action principale → bouton accent lime.
                    #}
                    <a href="{{ resource.applicationUrl }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn-candidater">
                        Candidater
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M5 12h14M13 5l7 7-7 7"/>
                        </svg>
                    </a>

                    {% if resource.externalUrl %}
                        {# ── Cas A suite : bouton secondaire "En savoir plus" → externalUrl ── #}
                        {#
                           externalUrl = page de présentation de l'opportunité.
                           Action secondaire → bouton outline (transparent + bordure encre).
                        #}
                        <a href="{{ resource.externalUrlNormalized }}"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="btn-secondary">
                            En savoir plus
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                                <path d="M5 12h14M13 5l7 7-7 7"/>
                            </svg>
                        </a>
                    {% endif %}

                {% else %}
                    {# ── Cas B : pas d'applicationUrl → fallback externalUrl seul ── #}
                    {#
                       Comportement rétro-compatible ADR-0018 et avant.
                       externalUrl joue à la fois le rôle de page de présentation
                       et de point d'entrée candidature.
                    #}
                    <a href="{{ resource.externalUrlNormalized }}"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn-candidater">
                        Candidater / En savoir plus
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <path d="M5 12h14M13 5l7 7-7 7"/>
                        </svg>
                    </a>
                {% endif %}

            </div>
        {% endif %}

        {# ── Description complète ── #}
        {#
           La description peut contenir du HTML structuré généré par Mistral
           (balises p, ul, li, strong) via la commande app:enrich-opportunities
           ou lors du scraping LLM (LlmExtractorService / OpportunityEnrichmentService).

           ADR-0018 : la description est maintenant COMPLÈTE et STRUCTURÉE (plusieurs sections).
           Elle peut aussi contenir du texte brut avec sauts de ligne si elle provient du
           scraping liste (LlmExtractorService — pas de HTML garanti dans ce cas).

           STRATÉGIE D'AFFICHAGE :
             - Si la description contient des balises HTML (<p>, <ul>, etc.) : |raw
               permet au navigateur de les interpréter. C'est le cas pour les descriptions
               produites par OpportunityEnrichmentService (format HTML structuré garanti).
             - Si la description est du texte brut (LlmExtractorService sur page-liste) :
               |raw fonctionne aussi (le texte sans balises s'affiche comme texte brut).

           ATTENTION XSS : ce |raw est valide UNIQUEMENT parce que resource.description
           est alimenté exclusivement par le pipeline IA (jamais par saisie artiste libre).
           Le pipeline garantit que seules les balises sûres (<p><ul><li><strong>) sont émises.
           NE PAS utiliser |raw si une soumission artiste ou structure peut écrire
           directement dans ce champ sans sanitisation préalable.

           Pour howToApply (texte LLM libre sans HTML garanti), on utilise |nl2br ci-dessus
           (et NON |raw) — deux stratégies différentes selon la source du contenu.
        #}
        <div class="resource-desc">
            {{ resource.description|raw }}
        </div>

        {# ── Disciplines ── #}
        {% if resource.disciplines|length > 0 %}
            <div class="resource-disciplines">
                <div class="section-label">Disciplines concernées</div>
                <div class="disciplines-list">
                    {% for discipline in resource.disciplines %}
                        <span class="discipline-chip">
                            {{ discipline.icon ? discipline.icon ~ ' ' : '' }}{{ discipline.name }}
                        </span>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

    </div>

    {# ═══════ SIDEBAR (droite, 30%) ═══════ #}
    <aside class="resource-sidebar">

        {# ── Encadré "Détails" ── #}
        {#
           Tableau de méta-données en deux colonnes : clé (gris) / valeur (foncé).
           Reproduit le style grille du prototype (padding, border séparateurs).
        #}
        <div class="side-block">
            <div class="side-block__eyebrow">Détails</div>

            <div class="details-table">

                {# Type de ressource #}
                <div class="details-row">
                    <div class="details-key">Type</div>
                    <div class="details-val">
                        {{ resource.resourceType.icon ? resource.resourceType.icon ~ ' ' : '' }}{{ resource.resourceType.name }}
                    </div>
                </div>

                {# Deadline si disponible #}
                {% if resource.deadline %}
                    {% set daysLeft = (resource.deadline.timestamp - "now"|date('U')) // 86400 %}
                    <div class="details-row">
                        <div class="details-key">Deadline</div>
                        <div class="details-val">
                            {{ resource.deadline|date('d/m/Y') }}
                            {% if daysLeft >= 0 %}
                                <br>
                                <span style="font-family:var(--mono); font-size:10px; color:{{ daysLeft < 7 ? 'var(--accent-2)' : 'var(--ink-mute)' }}; font-weight:700;">
                                    J-{{ daysLeft }}
                                </span>
                            {% elseif daysLeft < 0 %}
                                <br>
                                <span style="font-family:var(--mono); font-size:10px; color:var(--danger); font-weight:700;">Expirée</span>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}

                {# Organisation si disponible #}
                {% if resource.organization %}
                    <div class="details-row">
                        <div class="details-key">Organisation</div>
                        <div class="details-val">{{ resource.organization.name }}</div>
                    </div>
                {% endif %}

                {#
                    Localisation fine (ADR-0016 Lot 3) — même logique de priorité
                    que dans la section héro ci-dessus :
                    city+country > city > country > location > rien affiché.
                    On réutilise la variable `locationLabel` calculée plus haut dans
                    le template. Elle est visible ici car Twig partage le scope entre
                    les blocs d'un même template.
                #}
                {% if locationLabel %}
                    <div class="details-row">
                        <div class="details-key">Lieu</div>
                        <div class="details-val">{{ locationLabel }}</div>
                    </div>
                {% endif %}

                {#
                    Niveau d'expérience (ADR-0016 Lot 3).
                    experienceLevel est un enum nullable :
                      - non null → on affiche son label FR via .label()
                      - null     → l'opportunité s'adresse à tous niveaux : on l'indique
                                   explicitement plutôt que de masquer la ligne, ce qui
                                   est plus informatif pour l'utilisateur.

                    Le chip `.chip-level` est stylisé en mono uppercase comme tous les
                    badges Street, avec fond bg-alt et bordure douce (neutre, pas d'accent)
                    pour ne pas le confondre avec un statut d'urgence.
                #}
                <div class="details-row">
                    <div class="details-key">Niveau</div>
                    <div class="details-val">
                        {% if resource.experienceLevel %}
                            <span class="chip-level">{{ resource.experienceLevel.label() }}</span>
                        {% else %}
                            <span class="chip-level chip-level--all">Tous niveaux</span>
                        {% endif %}
                    </div>
                </div>

                {# Date de publication #}
                <div class="details-row">
                    <div class="details-key">Publiée</div>
                    <div class="details-val">{{ resource.createdAt|date('d/m/Y') }}</div>
                </div>

            </div>
        </div>

        {# ── Bouton Favori ── #}
        {#
           Formulaire POST vers la route toggle favoris.
           On conserve TOUS les attributs data-* existants pour la compatibilité Stimulus.
           data-resource-id, data-token, data-favorited, data-count : utilisés par le
           contrôleur Stimulus future (AJAX) — ne jamais supprimer ces attributs.

           Fallback sans JS : le formulaire POST fonctionne nativement et recharge la page.
        #}
        {% if app.user %}
            <div class="side-block">
                <div class="side-block__eyebrow">Ma bibliothèque</div>

                <form method="post"
                      action="{{ path('app_resource_favorite_toggle', {id: resource.id}) }}"
                      class="favorite-form"
                      data-resource-id="{{ resource.id }}"
                      data-favorited="{{ isFavorited ? 'true' : 'false' }}"
                      data-count="{{ favoriteCount }}">

                    {# Token CSRF caché — protection contre les attaques CSRF #}
                    <input type="hidden" name="_token" value="{{ csrf_token('resource_favorite_' ~ resource.id) }}">

                    <button type="submit"
                            class="btn-favorite {{ isFavorited ? 'btn-favorite--active' : '' }}"
                            aria-pressed="{{ isFavorited ? 'true' : 'false' }}"
                            aria-label="{{ isFavorited ? 'Retirer des favoris' : 'Ajouter aux favoris' }}">

                        {#
                            Stratégie double-SVG : les deux icônes cœur sont toujours dans le DOM.
                            Le JS bascule display:none sur l'une d'elles selon l'état favori.
                            Cela évite de reconstruire le SVG en JS (plus robuste et plus lisible).

                            icon-heart-filled  → cœur PLEIN  (favori actif)
                            icon-heart-outline → cœur CONTOUR (non favori)
                        #}
                        {# Cœur plein — visible si isFavorited, masqué sinon via style inline #}
                        <svg class="icon-heart-filled"
                             width="16" height="16" viewBox="0 0 24 24"
                             fill="var(--accent)" stroke="var(--accent)"
                             stroke-width="1.5" stroke-linecap="round"
                             aria-hidden="true"
                             style="{{ isFavorited ? '' : 'display:none' }}">
                            <path d="M12 21s-7-4.5-9.5-9C.7 8 3 4 6.5 4 9 4 10.5 5.5 12 7.5 13.5 5.5 15 4 17.5 4 21 4 23.3 8 21.5 12 19 16.5 12 21 12 21z"/>
                        </svg>
                        {# Cœur contour — visible si non favori, masqué sinon #}
                        <svg class="icon-heart-outline"
                             width="16" height="16" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor"
                             stroke-width="1.7" stroke-linecap="round"
                             aria-hidden="true"
                             style="{{ isFavorited ? 'display:none' : '' }}">
                            <path d="M12 21s-7-4.5-9.5-9C.7 8 3 4 6.5 4 9 4 10.5 5.5 12 7.5 13.5 5.5 15 4 17.5 4 21 4 23.3 8 21.5 12 19 16.5 12 21 12 21z"/>
                        </svg>

                        {{ isFavorited ? 'Dans mes favoris' : 'Ajouter aux favoris' }}

                        {# Compteur favoris si au moins 1 personne a mis en favori #}
                        {% if favoriteCount > 0 %}
                            <span class="favorite-count">({{ favoriteCount }})</span>
                        {% endif %}
                    </button>
                </form>
            </div>
        {% endif %}

        {#
            Bloc "Contribuer" — visible uniquement pour les structures et admins.
            Décision produit V1 : seules les structures soumettent des ressources.
            Les artistes voient les ressources et candidatent via le lien externe
            (bouton "Candidater / En savoir plus" dans la colonne principale),
            mais ne voient pas ce CTA de soumission.
            is_granted('ROLE_STRUCTURE') couvre aussi ROLE_ADMIN (hiérarchie security.yaml).
        #}
        {% if is_granted('ROLE_STRUCTURE') %}
            <div class="side-block side-block--accent">
                <div class="side-block__eyebrow">Contribuer</div>
                <p style="font-family:var(--body); font-size:13px; color:var(--ink); line-height:1.5; margin:0;">
                    Vous connaissez une opportunité similaire ?<br>
                    Partagez-la avec la communauté Bazaart.
                </p>
                <a href="{{ path('app_resource_submit') }}" class="btn-side-cta">
                    Soumettre une ressource
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M5 12h14M13 5l7 7-7 7"/>
                    </svg>
                </a>
            </div>
        {% endif %}

    </aside>

</div>

{% endblock %}

{#
 # ── Bloc JavaScript — interception du bouton Favori ──────────────────────────
 # On étend le bloc "javascripts" défini dans base_app.html.twig plutôt que de
 # l'écraser. {{ parent() }} garantit que le JS commun (Turbo, Stimulus, etc.)
 # reste chargé.
 #
 # Pourquoi ce JS ici et pas dans un fichier séparé ?
 # Le bouton favori n'existe que sur CETTE page → le script est minimal et
 # n'a pas besoin d'être chargé globalement. C'est la convention du projet
 # (cf. CLAUDE.md §15 : JS inline via {% block javascripts %}).
 #}
{% block javascripts %}
{{ parent() }}
<script>
(function () {
    'use strict';

    // ── Sélection des éléments ──────────────────────────────────────────────
    // On vérifie l'existence de chaque élément avant de l'utiliser (code défensif).
    const form   = document.querySelector('.favorite-form');
    const button = form ? form.querySelector('.btn-favorite') : null;

    // Si le formulaire n'est pas sur la page (utilisateur non connecté ou élément absent),
    // on sort immédiatement pour ne rien casser.
    if (!form || !button) {
        return;
    }

    // ── Stratégie pour basculer l'icône cœur ───────────────────────────────
    // Choix retenu : deux SVG coexistent dans le DOM dès le chargement de la page.
    // L'un porte la classe "icon-heart-filled" (cœur plein = favori actif),
    // l'autre "icon-heart-outline" (cœur contour = non favori).
    // On masque/affiche l'un ou l'autre avec display:none selon l'état.
    //
    // Alternative écartée : remplacer innerHTML du bouton à la volée → plus fragile
    // (risque de perdre d'autres enfants du bouton, plus difficile à relire).
    //
    // Pour que cette approche fonctionne, les deux SVG doivent être présents dans
    // le HTML au chargement. Voir le bloc Twig ci-dessous (ligne ~797) qui est
    // modifié pour rendre les deux SVG présents simultanément.
    const iconFilled  = button.querySelector('.icon-heart-filled');
    const iconOutline = button.querySelector('.icon-heart-outline');

    // Compteur affiché à côté du bouton (optionnel — peut ne pas exister si count=0 au chargement).
    // Déclaré en "let" (pas "const") car la référence peut être réassignée plus bas
    // quand on crée dynamiquement le span au premier ajout de favori.
    let countSpan = button.querySelector('.favorite-count');

    // ── Interception de la soumission ──────────────────────────────────────
    form.addEventListener('submit', function (e) {
        // Empêche la navigation par défaut du formulaire
        e.preventDefault();

        // Lecture de l'état courant depuis l'attribut data-* du formulaire
        // (plus fiable que de lire les classes CSS)
        const isFavorited = form.dataset.favorited === 'true';

        // Construction du corps de la requête :
        // FormData inclut automatiquement le champ <input type="hidden" name="_token">,
        // ce qui satisfait la validation CSRF côté contrôleur Symfony.
        const body = new FormData(form);

        fetch(form.action, {
            method: 'POST',
            // L'en-tête X-Requested-With permet au contrôleur de détecter
            // la requête AJAX via $request->isXmlHttpRequest().
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            body: body,
        })
        .then(function (response) {
            // Si la réponse HTTP n'est pas ok (ex: 403 CSRF, 404, 500),
            // on rejette la promesse pour tomber dans le catch.
            if (!response.ok) {
                return Promise.reject(new Error('Réponse serveur non-ok : ' + response.status));
            }
            return response.json();
        })
        .then(function (data) {
            // ── Mise à jour de l'état du formulaire ────────────────────────
            // On stocke le nouvel état dans data-favorited pour les soumissions
            // ultérieures (toggle successifs sans rechargement).
            form.dataset.favorited = data.favorited ? 'true' : 'false';

            // ── Mise à jour visuelle du bouton ─────────────────────────────
            // 1. Classe CSS active (fond coloré, couleur accent)
            button.classList.toggle('btn-favorite--active', data.favorited);

            // 2. Accessibilité : aria-pressed et aria-label
            button.setAttribute('aria-pressed', data.favorited ? 'true' : 'false');
            button.setAttribute('aria-label', data.favorited ? 'Retirer des favoris' : 'Ajouter aux favoris');

            // 3. Texte du bouton — on cible le nœud texte directement pour ne pas
            //    supprimer les SVG enfants.
            //    Technique : on parcourt les childNodes à la recherche d'un Text node.
            for (const node of button.childNodes) {
                if (node.nodeType === Node.TEXT_NODE && node.textContent.trim() !== '') {
                    node.textContent = data.favorited ? ' Dans mes favoris ' : ' Ajouter aux favoris ';
                    break;
                }
            }

            // 4. Icônes cœur : afficher/masquer selon l'état
            if (iconFilled)  { iconFilled.style.display  = data.favorited ? '' : 'none'; }
            if (iconOutline) { iconOutline.style.display = data.favorited ? 'none' : ''; }

            // 5. Compteur de favoris
            //
            // Trois cas possibles à gérer :
            //
            // A) Le span existait déjà dans le DOM (count était > 0 au chargement
            //    ou on l'a créé lors d'un toggle précédent) → on le met à jour.
            //    Si le nouveau count vaut 0, on masque le span mais on le laisse
            //    dans le DOM pour éviter de le recréer si l'utilisateur re-clique.
            //
            // B) Le span n'existait pas (count était 0 au chargement) et le
            //    serveur renvoie count > 0 → on crée le span UNE SEULE FOIS
            //    puis on réassigne countSpan pour que les toggles suivants
            //    passent par le cas A et ne recréent pas un second span.
            //
            // C) Le span n'existait pas ET le serveur renvoie count = 0
            //    (cohérence impossible en pratique, mais on le gère : rien à faire).
            if (countSpan !== null) {
                // Cas A : span déjà dans le DOM — mise à jour simple
                if (data.count > 0) {
                    countSpan.textContent    = '(' + data.count + ')';
                    countSpan.style.display  = '';
                } else {
                    // count retombé à 0 : on masque le span sans le supprimer
                    countSpan.style.display = 'none';
                }
            } else if (data.count > 0) {
                // Cas B : premier favori → création du span
                const newSpan = document.createElement('span');
                newSpan.className   = 'favorite-count';
                newSpan.textContent = '(' + data.count + ')';
                button.appendChild(newSpan);

                // IMPORTANT : on réassigne countSpan pour que les toggles
                // suivants réutilisent ce span (cas A) plutôt d'en créer un second.
                countSpan = newSpan;
            }
            // Cas C : count = 0 et pas de span → rien à faire
        })
        .catch(function (err) {
            // En cas d'erreur réseau ou de réponse non-ok, on logue discrètement
            // SANS modifier l'UI (l'état visuel reste cohérent avec l'état BDD
            // inconnu — mieux que de basculer à tort).
            console.error('[Bazaart] Erreur toggle favori :', err);
        });
    });
}());
</script>
{% endblock %}
