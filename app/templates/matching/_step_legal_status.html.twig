{#
 # matching/_step_legal_status.html.twig
 #
 # Partial réutilisable : champ "Statut juridique" (LegalStatus, optionnel)
 # Utilisé dans :
 #   - onboarding/step4.html.twig  (onboarding artiste connecté)
 #   - matching/_form_step4.html.twig (formulaire home)
 #
 # Variables attendues :
 #   legal_status_options   : LegalStatus[]    — tous les cas de l'enum (cases())
 #   selected_legal_status  : LegalStatus|null — valeur déjà choisie (pré-remplissage)
 #   field_prefix           : string           — préfixe optionnel pour les ids HTML
 #   show_skip_note         : bool             — afficher la note "Ce champ est optionnel"
 #                                               Défaut : true.
 # DESIGN (ADR-0033 §4) : "tile-grid" posée en plus de "ob-options" (tuiles
 # cliquables du prototype). Scoppé à ".mf-wrap", sans effet sur l'onboarding.
#}

{% set fp = field_prefix is defined ? field_prefix : '' %}
{% set show_skip_note = show_skip_note is defined ? show_skip_note : true %}

<div class="ob-options tile-grid" role="group" aria-label="Ton statut juridique">
    {% for option in legal_status_options %}
        {#
            Pré-sélection si l'artiste avait déjà choisi un statut.
            selected_legal_status est une instance de LegalStatus ou null.
        #}
        {% set isSelected = selected_legal_status is not null and selected_legal_status.value == option.value %}
        {% set radioId = 'ls_' ~ option.value ~ (fp ? '_' ~ fp : '') %}

        <div class="ob-option-item">
            <input
                type="radio"
                id="{{ radioId }}"
                name="legal_status"
                value="{{ option.value }}"
                {% if isSelected %}checked{% endif %}
            >
            <label for="{{ radioId }}">
                <span class="ob-radio-visual" aria-hidden="true">
                    <span class="ob-radio-dot"></span>
                </span>
                {{ option.label()|e }}
            </label>
        </div>
    {% endfor %}
</div>

{% if show_skip_note %}
<p class="ob-hint match-help" style="margin-top:12px;">
    Ce champ est optionnel. Tu pourras le renseigner ou le modifier à tout moment depuis ton profil.
</p>
{% endif %}
