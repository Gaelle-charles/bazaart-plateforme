{#
 # matching/_matching_form.html.twig
 #
 # Section matching home : formulaire multi-étapes (3 étapes) affiché aux
 # UTILISATEURS CONNECTÉS au profil incomplet (artiste ou non).
 #
 # ADR-0033 (2026-07-06) : ce partial n'est PLUS JAMAIS inclus pour un visiteur
 # non connecté — HomeController::index() ne le prépare que si
 # $user instanceof User (cf. $needsMatchingForm). Un visiteur voit désormais
 # matching/_matching_login_wall.html.twig à la place ("se connecter d'abord,
 # remplir ensuite"). L'ancien cas d'usage "visiteur non connecté" (remplissage
 # libre + redirection vers /register au clic "Continuer") a été retiré du
 # markup et de matching-form.js — voir l'historique Git pour l'ancienne version
 # si besoin de retrouver ce comportement.
 #
 # USAGE UNIQUE : Artiste connecté (ou utilisateur connecté pas encore artiste)
 #   avec profil incomplet. La soumission finale appelle POST /matching/form
 #   (action du formulaire) et sauvegarde le profil via OnboardingService.
 #   Redirige ensuite vers la home avec la section swipe.
 #
 # VARIABLES TRANSMISES PAR HomeController :
 #   matchingForm_disciplines    : Discipline[]         — toutes les disciplines
 #   matchingForm_lookingFor     : ArtistLookingFor[]   — tous les cas enum
 #   matchingForm_legalStatuses  : LegalStatus[]        — tous les cas enum
 #   matchingForm_savedData      : array                — données session pré-remplissage
 #                                 {discipline_ids:[], looking_for:[], looking_for_other:'', legal_status:null}
 #   matchingForm_csrfToken      : string               — token CSRF pour le POST
 #
 # ARCHITECTURE JS :
 #   Le JS (matching-form.js) gère la navigation entre étapes sans rechargement.
 #   Sans JS : seule l'étape 1 (disciplines) est visible — les fieldsets des
 #   étapes 2 et 3 portent l'attribut HTML [hidden] et restent masqués.
 #   L'utilisateur peut quand même soumettre le formulaire (étape 1 uniquement).
 #   Le POST final est un formulaire HTML classique (fonctionne sans JS).
 #
 # ACCESSIBILITÉ :
 #   - Chaque étape est un <fieldset> avec <legend> visible
 #   - La barre de progression est aria-live="polite" (mise à jour par JS)
 #   - Focus géré par matching-form.js lors de la navigation entre étapes
 #   - prefers-reduced-motion : transitions JS désactivées (voir matching-form.js)
 #
 # DESIGN (volet frontend ADR-0033 §4) :
 #   Structure reprise du wizard du prototype "BazaArt - Matching Swipe" :
 #   carte .match-card, barre de progression en segments (.progress/.bars),
 #   intro .match-intro, champs .fields-2, aide .match-help, actions
 #   .wiz-actions. Les IDs et classes FONCTIONNELS lus par matching-form.js
 #   (matching-form-wrap, matching-multi-form, mf-progress, mf-btn-prev/next/submit,
 #   .mf-step, .mf-step-dot, .mf-progress__label...) sont CONSERVÉS À L'IDENTIQUE :
 #   les classes de mise en page (.match-card, .progress, .bars, .step,
 #   .match-intro, .fields-2, .field-label, .match-help, .wiz-actions) sont
 #   posées EN PLUS, en habillage visuel pur — voir matching-form.js si un
 #   doute existe sur un sélecteur avant de le renommer.
 #   Couleurs/fonts : charte ACTUELLE du site (var(--accent), var(--display)...),
 #   pas les valeurs codées en dur du prototype.
#}

{# ── Extraction des valeurs pré-remplies depuis la session ─────────────────── #}
{% set saved = matchingForm_savedData is defined ? matchingForm_savedData : {} %}
{% set saved_disc_ids = saved.discipline_ids is defined ? saved.discipline_ids : [] %}
{% set saved_looking_for = saved.looking_for is defined ? saved.looking_for : [] %}
{% set saved_looking_for_other = saved.looking_for_other is defined ? saved.looking_for_other : null %}
{% set saved_legal_status_raw = saved.legal_status is defined ? saved.legal_status : null %}

{# ── Pré-remplissage nom + localisation (étape 1, Option B) ─────────────────
   Priorité : valeur en session (saisie en cours / rechargement) puis valeur du
   profil existant (artiste connecté au profil incomplet), transmise par
   HomeController dans matchingForm_displayName / matchingForm_location. #}
{% set saved_display_name = saved.display_name is defined and saved.display_name is not null
    ? saved.display_name
    : (matchingForm_displayName is defined ? matchingForm_displayName : '') %}
{% set saved_location = saved.location is defined and saved.location is not null
    ? saved.location
    : (matchingForm_location is defined ? matchingForm_location : '') %}

{# ── Résolution du LegalStatus pré-sélectionné (on compare par valeur string) ── #}
{% set saved_legal_status = null %}
{% if saved_legal_status_raw is not null %}
    {% for ls in matchingForm_legalStatuses %}
        {% if ls.value == saved_legal_status_raw %}
            {% set saved_legal_status = ls %}
        {% endif %}
    {% endfor %}
{% endif %}

{# ── Conteneur du formulaire multi-étapes ──────────────────────────────────── #}
{#
    data-step-url : URL de l'endpoint AJAX qui sauvegarde chaque étape en session.
    Le JS lit cette valeur plutôt que de coder l'URL en dur, ce qui est plus robuste
    si la route change (préfixe de sous-dossier, CDN, etc.).
    La route nommée 'app_matching_form_step' pointe vers POST /matching/step.
#}
<div
    class="mf-wrap match-card"
    id="matching-form-wrap"
    data-step-url="{{ path('app_matching_form_step') }}"
    aria-label="Formulaire de matching en plusieurs étapes"
>

    {#
        ── Barre de progression (3 étapes) ──────────────────────────────────
        .progress/.bars/.step : habillage visuel repris du prototype (segments
        + label mono). Les classes fonctionnelles .mf-progress / .mf-step-dot /
        .mf-step-dot--active / .mf-progress__label restent lues telles quelles
        par matching-form.js (updateProgress()) — ne pas les renommer.
    #}
    <div
        class="mf-progress progress"
        role="progressbar"
        aria-valuemin="1"
        aria-valuemax="3"
        aria-valuenow="1"
        aria-live="polite"
        aria-label="Étape 1 sur 3"
        id="mf-progress"
    >
        <div class="bars">
            <div class="mf-step-dot mf-step-dot--active" data-step="1" title="Étape 1 : Toi (nom, localisation, disciplines)"></div>
            <div class="mf-step-dot" data-step="2" title="Étape 2 : Ce que tu recherches"></div>
            <div class="mf-step-dot" data-step="3" title="Étape 3 : Ton statut (optionnel)"></div>
        </div>
        <span class="mf-progress__label step" id="mf-progress-label">Étape 1 / 3</span>
    </div>

    {# ── Formulaire HTML — soumis en POST au controller matching ──────────── #}
    {# action="..." pointera vers POST /matching/form (MatchingFormController::submit) #}
    <form
        method="POST"
        action="{{ path('app_matching_form_submit') }}"
        class="mf-form"
        id="matching-multi-form"
        novalidate
    >
        {# Token CSRF — protège le POST final contre les soumissions croisées #}
        <input type="hidden" name="_csrf_token" value="{{ matchingForm_csrfToken }}">

        {# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
           ÉTAPE 1 : Disciplines artistiques
        ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ #}
        <fieldset
            class="mf-step"
            id="mf-step-1"
            data-step="1"
            aria-labelledby="mf-step1-legend"
        >
            <legend class="mf-step__legend" id="mf-step1-legend">
                Parle-nous de <span class="mf-it">toi</span>
            </legend>
            <p class="mf-step__hint match-intro">
                Ton nom, ta localisation et tes pratiques artistiques : ces informations sont nécessaires pour te proposer des opportunités pertinentes.
            </p>

            {# Bloc erreur (affiché par JS ou par rechargement sans JS) #}
            <div class="mf-error" id="mf-step1-error" role="alert" aria-live="assertive" style="display:none;"></div>

            {# ── Nom + localisation (requis, Option B) ─────────────────────────
               Ces deux champs sont indispensables pour qu'un profil soit
               « complet » et débloque le matching (cf. MatchingProfileChecker).
               POST keys : display_name / location (mêmes clés qu'OnboardingStep2DTO,
               pour que le Flux B et le carryover onboarding fonctionnent sans glue). #}
            <div class="mf-text-fields fields-2">
                <div class="mf-field">
                    <label class="mf-field__label field-label" for="mf-display-name">
                        Ton nom d'artiste
                    </label>
                    <input
                        type="text"
                        class="mf-field__input ob-input input"
                        id="mf-display-name"
                        name="display_name"
                        value="{{ saved_display_name }}"
                        placeholder="Ex : Aïcha Diallo"
                        maxlength="100"
                        autocomplete="name"
                        required
                    >
                </div>
                <div class="mf-field">
                    <label class="mf-field__label field-label" for="mf-location">
                        Ta localisation
                    </label>
                    {#
                        LOCALISATION — menu déroulant de pays européens
                        Remplace l'ancien <input type="text"> par un <select>.

                        LOGIQUE DE PRÉ-SÉLECTION :
                          - saved_location contient la valeur actuelle (session ou profil BDD).
                          - On cherche si cette valeur correspond à une option de l'enum Country.
                          - Si oui → on la marque selected dans la boucle.
                          - Si non (ancienne saisie libre) → on affiche une option supplémentaire
                            en tête, labelisée "(ancienne saisie)", pour ne pas perdre la donnée
                            existante au prochain enregistrement.

                        La variable matchingForm_countries est passée par HomeController.
                        Elle contient le tableau Country::casesSortedFr() = pays triés A→Z en FR.
                    #}

                    {#
                        Détermine si la valeur courante est une ancienne saisie libre (hors liste).
                        Depuis le passage aux optgroups, matchingForm_countries est un tableau
                        associatif de type array<string, list<Country>>.
                        On doit parcourir TOUS les groupes pour vérifier l'appartenance.
                    #}
                    {% set location_in_list = false %}
                    {% if saved_location is not empty %}
                        {% for groupLabel, countriesInGroup in matchingForm_countries %}
                            {% for c in countriesInGroup %}
                                {% if c.value == saved_location %}
                                    {% set location_in_list = true %}
                                {% endif %}
                            {% endfor %}
                        {% endfor %}
                    {% endif %}

                    <select
                        class="mf-field__input ob-input input"
                        id="mf-location"
                        name="location"
                        required
                    >
                        {# Option placeholder — visible uniquement si aucune valeur pré-sélectionnée #}
                        {% if saved_location is empty %}
                            <option value="" disabled selected>Sélectionne ton pays</option>
                        {% else %}
                            <option value="" disabled>Sélectionne ton pays</option>
                        {% endif %}

                        {# Ancienne saisie libre non présente dans la liste → option de secours
                           pour ne pas écraser silencieusement la valeur existante en BDD.
                           Placée AVANT les optgroups pour rester visible en tête de liste. #}
                        {% if saved_location is not empty and not location_in_list %}
                            <option value="{{ saved_location }}" selected>{{ saved_location }} (ancienne saisie)</option>
                        {% endif %}

                        {#
                            Boucle sur les groupes de pays (optgroups).
                            matchingForm_countries = array<string, list<Country>> :
                              Clé = libellé du groupe ("France et Outre-mer", "Europe")
                              Valeur = liste des Country cases dans ce groupe
                        #}
                        {% for groupLabel, countriesInGroup in matchingForm_countries %}
                            <optgroup label="{{ groupLabel }}">
                                {% for c in countriesInGroup %}
                                    <option value="{{ c.value }}" {{ saved_location == c.value ? 'selected' : '' }}>
                                        {{- c.value -}}
                                    </option>
                                {% endfor %}
                            </optgroup>
                        {% endfor %}
                    </select>
                </div>
            </div>

            {# Sous-titre disciplines #}
            <p class="mf-step__sublabel field-label">Tes disciplines artistiques</p>

            {# Champ de filtre pour chercher rapidement dans la liste de disciplines #}
            <div class="mf-disc-filter-wrap">
                <input
                    type="text"
                    class="mf-disc-filter ob-input"
                    id="mf-disc-filter"
                    placeholder="Filtrer les disciplines..."
                    aria-label="Filtrer les disciplines artistiques"
                    autocomplete="off"
                >
            </div>

            {# Inclusion du partial disciplines — field_prefix "mf" pour éviter doublons d'ids #}
            {% include 'matching/_step_disciplines.html.twig' with {
                disciplines:  matchingForm_disciplines,
                selected_ids: saved_disc_ids,
                field_prefix: 'mf',
                show_label:   false
            } %}

        </fieldset>

        {# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
           ÉTAPE 2 : Ce que tu recherches (lookingFor)
        ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ #}
        <fieldset
            class="mf-step"
            id="mf-step-2"
            data-step="2"
            aria-labelledby="mf-step2-legend"
            hidden
        >
            <legend class="mf-step__legend" id="mf-step2-legend">
                Que <span class="mf-it">recherches-tu</span> ?
            </legend>
            <p class="mf-step__hint match-intro">
                Coche tout ce qui correspond à tes besoins. Ces informations permettent de personnaliser les opportunités proposées.
            </p>

            <div class="mf-error" id="mf-step2-error" role="alert" aria-live="assertive" style="display:none;"></div>

            {# Inclusion du partial lookingFor — field_prefix "mf2" #}
            {% include 'matching/_step_looking_for.html.twig' with {
                looking_for_options: matchingForm_lookingFor,
                selected_values:     saved_looking_for,
                looking_for_other:   saved_looking_for_other,
                field_prefix:        'mf2'
            } %}

        </fieldset>

        {# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
           ÉTAPE 3 : Statut juridique (optionnel)
        ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ #}
        <fieldset
            class="mf-step"
            id="mf-step-3"
            data-step="3"
            aria-labelledby="mf-step3-legend"
            hidden
        >
            <legend class="mf-step__legend" id="mf-step3-legend">
                Ton <span class="mf-it">statut</span>
                <span class="mf-optional-badge">optionnel</span>
            </legend>
            <p class="mf-step__hint match-intro">
                Ton statut juridique permet de te proposer les opportunités auxquelles tu es éligible. Tu peux passer cette étape.
            </p>

            {# Inclusion du partial legalStatus — field_prefix "mf3" #}
            {% include 'matching/_step_legal_status.html.twig' with {
                legal_status_options:  matchingForm_legalStatuses,
                selected_legal_status: saved_legal_status,
                field_prefix:          'mf3',
                show_skip_note:        false
            } %}

        </fieldset>

        {# ── Navigation entre étapes ─────────────────────────────────────── #}
        {# Ces boutons sont gérés par matching-form.js.
           Sans JS : seul le bouton de soumission finale est visible.
           Le bouton "Suivant" est type="button" (n'envoie PAS le formulaire).

           .grow : espaceur repris du prototype (wiz-actions .grow{flex:1}).
           Pousse "Continuer"/"Trouver mes matchs" à DROITE même quand
           "Retour" est caché (étape 1) — avec justify-content:space-between
           seul, un unique bouton visible se retrouverait à GAUCHE. #}
        <div class="mf-actions wiz-actions" id="mf-actions">

            {# Bouton "Retour" : caché à l'étape 1, visible aux étapes 2 et 3 #}
            <button
                type="button"
                class="mf-btn-prev ob-btn-back"
                id="mf-btn-prev"
                aria-controls="mf-step-1 mf-step-2 mf-step-3"
                hidden
            >
                Retour
            </button>

            <span class="grow" aria-hidden="true"></span>

            {# Bouton "Suivant" : visible aux étapes 1 et 2 (géré par JS) #}
            <button
                type="button"
                class="mf-btn-next ob-btn-next"
                id="mf-btn-next"
                aria-controls="mf-step-1 mf-step-2 mf-step-3"
            >
                Continuer
            </button>

            {# Bouton de soumission finale : visible à l'étape 3 (JS),
               ou toujours visible sans JS (fallback). #}
            <button
                type="submit"
                class="mf-btn-submit ob-btn-next"
                id="mf-btn-submit"
                aria-label="Enregistrer mon profil et voir mes matchs"
                hidden
            >
                Trouver mes matchs
            </button>

        </div>

        {#
            FALLBACK SANS JS :
            Sans JS, les fieldsets [hidden] des étapes 2 et 3 restent masqués par
            le navigateur — seule l'étape 1 (disciplines) est visible et soumettable.
            Le message <noscript> informe honnêtement l'utilisateur de cette limite.
        #}
        <noscript>
            <p class="mf-noscript-hint">
                Activez JavaScript pour remplir toutes les étapes. Sans JavaScript, seule la sélection des disciplines (étape 1) est possible.
            </p>
        </noscript>

    </form>

    {# ADR-0033 : la modal "crée ton compte pour aller plus loin" (#mf-signup-cta)
       a été retirée. Elle n'était affichée QUE pour un visiteur non connecté —
       cas qui ne se produit plus jamais pour ce partial (cf. doc-comment en tête
       de fichier). Le markup, son CSS (.mf-signup-cta*) et la logique JS associée
       (showSignupCta/closeSignupCta dans matching-form.js) ont été retirés ensemble. #}

</div>{# /.mf-wrap #}
