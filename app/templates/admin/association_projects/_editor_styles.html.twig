{#
 # admin/association_projects/_editor_styles.html.twig
 #
 # Styles de l'éditeur « Le projet en détail » (js/association-projects-editor.js),
 # dans le thème du back-office (bords francs, bordures 1px --ink). La zone de
 # saisie reprend la mise en page de l'article de la fiche partenaire, pour voir
 # le texte à peu près tel qu'il sera publié.
 #}
<style>
.adm-ap-editor { border: 1px solid var(--ink); background: #fff; }
.adm-ap-editor__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
    padding: 6px;
    border-bottom: 1px solid var(--ink);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 2;
}
.adm-ap-editor__button {
    font-family: var(--body);
    font-size: 12px;
    font-weight: 600;
    padding: 5px 9px;
    min-height: 30px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
}
.adm-ap-editor__button:hover { border-color: var(--ink); }
.adm-ap-editor__button[aria-pressed="true"] { background: var(--ink); color: var(--bg); }
.adm-ap-editor__button:disabled { opacity: .4; cursor: not-allowed; border-color: transparent; }
.adm-ap-editor__button:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
.adm-ap-editor__button.is-bold { font-weight: 800; }
.adm-ap-editor__button.is-italic { font-style: italic; font-family: Georgia, serif; }
.adm-ap-editor__separator { width: 1px; align-self: stretch; margin: 2px 4px; background: var(--line-soft); }
.adm-ap-editor__area {
    min-height: 320px;
    max-height: 70vh;
    overflow-y: auto;
    padding: 16px 18px;
    outline: none;
}
.adm-ap-editor__area:focus-visible { box-shadow: inset 0 0 0 2px var(--ink); }
.adm-ap-editor__status { margin: 0; padding: 0 10px; font-family: var(--body); font-size: 12px; color: var(--ink-mute); min-height: 0; }
.adm-ap-editor__status:not(:empty) { padding: 6px 10px; border-top: 1px solid var(--line-soft); }
.adm-ap-editor__status.is-error { color: var(--danger); font-weight: 600; }

/* Mise en page « article » (reprise de la fiche partenaire, en plus compact). */
.adm-ap-article { font-family: var(--body); font-size: 15px; line-height: 1.6; color: var(--ink); }
.adm-ap-article > :first-child { margin-top: 0; }
.adm-ap-article p { margin: 0 0 12px; }
.adm-ap-article h2 {
    font-family: var(--display, var(--body));
    font-weight: 400;
    font-size: 24px;
    line-height: 1.1;
    text-transform: uppercase;
    margin: 24px 0 10px;
}
.adm-ap-article h3 { font-size: 17px; font-weight: 700; margin: 18px 0 8px; }
.adm-ap-article ul,
.adm-ap-article ol { margin: 0 0 12px; padding-left: 24px; }
.adm-ap-article li { margin-bottom: 4px; }
.adm-ap-article blockquote {
    margin: 16px 0;
    padding: 4px 0 4px 16px;
    border-left: 4px solid var(--accent);
    font-family: var(--serif, Georgia, serif);
    font-size: 17px;
}
.adm-ap-article a { color: var(--ink); text-decoration: underline; }
/* Dans l'éditeur, images limitées en hauteur pour garder le texte lisible (pleine largeur sur la fiche). */
.adm-ap-article img { display: block; width: auto; max-width: 100%; height: auto; max-height: 320px; margin: 8px 0; border: 1px solid var(--line-soft); cursor: pointer; }
.adm-ap-article img:hover { outline: 2px dashed var(--ink-mute); }
</style>
