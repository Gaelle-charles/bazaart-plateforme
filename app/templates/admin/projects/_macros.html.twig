{#
 # _macros.html.twig : petits composants réutilisés dans tout l'Espace projets (ADR-0037).
 #
 # UTILISATION dans un template :
 #   {% import 'admin/projects/_macros.html.twig' as pm %}
 #   {{ pm.icon('plus') }}   {{ pm.avatar(user) }}   {{ pm.due(task) }}
 #
 # Une MACRO Twig est l'équivalent d'une fonction : elle renvoie du HTML à partir
 # de paramètres. Pratique pour ne pas recopier 20 fois le même SVG.
 #}

{#
 # Icônes SVG « trait » (style Feather), 24x24, couleur = currentColor.
 # Pas d'emoji (règle du design Street), pas de police d'icônes externe.
 #}
{% macro icon(name, label = null) %}
    {%- set paths = {
        plus:      '<path d="M12 5v14M5 12h14"/>',
        kanban:    '<rect x="3" y="4" width="5" height="16"/><rect x="10" y="4" width="5" height="10"/><rect x="17" y="4" width="4" height="13"/>',
        list:      '<path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>',
        calendar:  '<rect x="3" y="4" width="18" height="17"/><path d="M16 2v4M8 2v4M3 10h18"/>',
        person:    '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M21.5 20a6.5 6.5 0 0 0-4-6"/>',
        flag:      '<path d="M4 22V4M4 4h13l-2 4 2 4H4"/>',
        search:    '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
        filter:    '<path d="M3 5h18l-7 8v6l-4 2v-8z"/>',
        x:         '<path d="M18 6 6 18M6 6l12 12"/>',
        trash:     '<path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/>',
        edit:      '<path d="M4 20h4L19 9l-4-4L4 16z"/><path d="m13.5 6.5 4 4"/>',
        pin:       '<path d="M9 3h6l-1 6 4 4H6l4-4z"/><path d="M12 13v8"/>',
        check:     '<path d="m5 12 5 5L20 7"/>',
        clock:     '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
        comment:   '<path d="M4 5h16v11H9l-5 4z"/>',
        clip:      '<path d="m21 11-8.5 8.5a5 5 0 0 1-7-7L14 4a3.3 3.3 0 0 1 4.7 4.7L10.2 17a1.7 1.7 0 0 1-2.4-2.4L15.5 7"/>',
        drive:     '<path d="M7 18h10a4 4 0 0 0 .6-7.95A6 6 0 0 0 6.1 9.2 4.5 4.5 0 0 0 7 18z"/>',
        folder:    '<path d="M3 6h6l2 2h10v11H3z"/>',
        doc:       '<path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6M9 13h8M9 17h8"/>',
        sheet:     '<rect x="4" y="3" width="16" height="18"/><path d="M4 9h16M4 15h16M10 3v18"/>',
        slides:    '<rect x="3" y="4" width="18" height="12"/><path d="M12 16v4M8 20h8"/>',
        pdf:       '<path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/><path d="M9 15h6"/>',
        image:     '<rect x="3" y="4" width="18" height="16"/><circle cx="9" cy="10" r="2"/><path d="m21 17-5-5-9 8"/>',
        video:     '<rect x="3" y="5" width="13" height="14"/><path d="m16 10 5-3v10l-5-3"/>',
        audio:     '<path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/>',
        link:      '<path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"/><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/>',
        file:      '<path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6"/>',
        external:  '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><path d="M15 3h6v6M10 14 21 3"/>',
        download:  '<path d="M12 3v12m0 0-4-4m4 4 4-4M4 21h16"/>',
        upload:    '<path d="M12 21V9m0 0-4 4m4-4 4 4M4 3h16"/>',
        left:      '<path d="m15 18-6-6 6-6"/>',
        right:     '<path d="m9 18 6-6-6-6"/>',
        help:      '<circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 .5c0 1.7-2.5 2-2.5 3.5M12 17h.01"/>',
        timeline:  '<path d="M3 6h9M7 12h11M5 18h8"/><path d="M3 3v18"/>',
        grid:      '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>',
        compass:   '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/>',
        note:      '<path d="M4 4h16v11l-5 5H4z"/><path d="M15 20v-5h5"/>',
        archive:   '<rect x="3" y="4" width="18" height="5"/><path d="M5 9v11h14V9M10 13h4"/>',
        subtasks:  '<path d="M9 6h12M9 12h12M9 18h12"/><path d="m3 6 1 1 2-2M3 12l1 1 2-2M3 18l1 1 2-2"/>',
    } -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" {{ label ? ('role="img" aria-label="' ~ label|e('html_attr') ~ '"')|raw : 'aria-hidden="true"' }}>{{ (paths[name] ?? paths.file)|raw }}</svg>
{%- endmacro %}

{#
 # Avatar carré avec initiales, dans la couleur de la membre.
 # size : null (26px) | 'lg' (40px) | 'xs' (20px)
 #}
{% macro avatar(user, size = null) %}
    <span class="pm-avatar{{ size ? ' pm-avatar--' ~ size }}" style="--c: {{ user|pm_color }}" title="{{ user|pm_name }}">{{ user|pm_initials }}</span>
{%- endmacro %}

{# Pile d'avatars (personnes assignées à une tâche) #}
{% macro avatars(users, size = 'xs') %}
    {% if users|length > 0 %}
        <span class="pm-avatars" aria-label="Assignée à {{ users|map(u => u|pm_name)|join(', ') }}">
            {% for u in users %}{{ _self.avatar(u, size) }}{% endfor %}
        </span>
    {% endif %}
{%- endmacro %}

{#
 # Échéance d'une tâche, colorée : rouge si en retard, orange si aujourd'hui / demain.
 #}
{% macro due(task) %}
    {% if task.dueDate %}
        {% set today = pm_today() %}
        {% set overdue = task.isOverdue(today) %}
        {% set soon = not overdue and not task.isDone() and task.dueDate <= today|date_modify('+1 day') %}
        <span class="pm-due{{ overdue ? ' pm-due--overdue' : (soon ? ' pm-due--soon' : '') }}" title="Échéance : {{ task.dueDate|pm_long }}">
            {{ _self.icon('clock') }}{{ task.dueDate|pm_due }}
        </span>
    {% endif %}
{%- endmacro %}

{# Nom de projet précédé de sa couleur (lien vers la fiche projet) #}
{% macro project_chip(project) %}
    {% if project %}
        <a class="pm-chip" href="{{ path('app_admin_pm_project_show', {id: project.id}) }}">
            <span class="pm-dot" style="background: {{ project.color }}"></span><span>{{ project.name }}</span>
        </a>
    {% else %}
        <span class="pm-chip pm-muted"><span class="pm-dot" style="background: transparent; border-style: dashed"></span><span>Sans projet</span></span>
    {% endif %}
{%- endmacro %}

{# Icône de fichier selon sa famille (dossier, doc, pdf…) #}
{% macro file_icon(kind) %}
    <span class="pm-file__icon pm-kind--{{ kind.value }}" title="{{ kind.label() }}">{{ _self.icon(kind.value) }}</span>
{%- endmacro %}
