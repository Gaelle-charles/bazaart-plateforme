<!DOCTYPE html>
<html lang="fr">
{#
    Récap quotidien de l'Espace projets (commande app:projets:rappels, ProjectNotifier::sendDigest).

    Variables : groups {overdue, today, soon} (listes de ProjectTask), today,
                recipientName, spaceUrl, settingsUrl
#}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ton récap Bazaart</title>
</head>
<body style="margin: 0; padding: 0; background-color: #F2EFE6; font-family: Arial, Helvetica, sans-serif; font-size: 16px; color: #0D0D0D;">
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="background-color: #F2EFE6; padding: 24px 0;">
    <tr>
        <td align="center">
            <table role="presentation" cellpadding="0" cellspacing="0" width="600" style="max-width: 600px; width: 100%; background-color: #ffffff; border: 1px solid #0D0D0D;">
                <tr>
                    <td style="background-color: #0D0D0D; padding: 20px 28px;">
                        <span style="font-family: Georgia, serif; font-size: 22px; font-weight: bold; color: #FFCB10; letter-spacing: 2px;">BAZAART</span>
                        <span style="font-family: monospace; font-size: 10px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase; color: #FF6B2C; padding: 3px 8px; border: 1px solid #FF6B2C; margin-left: 10px;">TON RÉCAP</span>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 28px;">
                        <p style="margin: 0 0 6px; font-family: monospace; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: #5b584f;">Bonjour {{ recipientName }} · {{ today|date('d/m/Y') }}</p>
                        <h1 style="margin: 0 0 18px; font-size: 22px; line-height: 1.2; text-transform: uppercase;">Tes tâches du moment</h1>
                        {% set sections = [
                            {key: 'overdue', title: 'En retard', color: '#E5484D'},
                            {key: 'today', title: 'Aujourd\'hui', color: '#FF6B2C'},
                            {key: 'soon', title: 'Dans les 3 prochains jours', color: '#0D0D0D'},
                        ] %}
                        {% for section in sections %}
                            {% set list = groups[section.key] %}
                            {% if list|length > 0 %}
                                <p style="margin: 18px 0 6px; font-family: monospace; font-size: 11px; font-weight: bold; letter-spacing: 0.1em; text-transform: uppercase; color: {{ section.color }};">{{ section.title }} ({{ list|length }})</p>
                                <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border: 1px solid #0D0D0D;">
                                    {% for task in list %}
                                        <tr>
                                            <td style="padding: 10px 12px; border-bottom: 1px solid #e6e2d6; border-left: 5px solid {{ task.project ? task.project.color : '#0D0D0D' }};">
                                                <a href="{{ url('app_admin_pm_task_show', {id: task.id}) }}" style="color: #0D0D0D; font-weight: bold; text-decoration: none;">{{ task.title }}</a><br>
                                                <span style="font-family: monospace; font-size: 12px; color: #5b584f;">{{ task.project ? task.project.name : 'Sans projet' }} · {{ task.priority.label() }}{% if task.dueDate %} · {{ task.dueDate|date('d/m') }}{% endif %}</span>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </table>
                            {% endif %}
                        {% endfor %}
                        <p style="margin: 24px 0 0;"><a href="{{ spaceUrl }}" style="display: inline-block; background-color: #0D0D0D; color: #FFCB10; text-decoration: none; font-weight: bold; padding: 12px 20px;">Ouvrir l'Espace projets</a></p>
                    </td>
                </tr>
                <tr>
                    <td style="padding: 16px 28px; border-top: 1px solid #0D0D0D; font-size: 12px; color: #5b584f;">
                        <a href="{{ settingsUrl }}" style="color: #0D0D0D;">Gérer mes notifications</a>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>
