{% extends 'base_app.html.twig' %}

{#
 # course/show.html.twig — Page d'une formation (design Street, bloc « en avant »).
 #
 # Variables : course (Course), isEnrolled (bool), enrollment (CourseEnrollment|null).
 # Hero : colonne gauche NOIRE (titre/sous-titre/formateur) + panneau droit LIME (stats + CTA),
 #        d'après le bloc « formation en avant » du prototype.
 # Sections suivantes : Description, Aperçu vidéo, Plan de la formation.
 #}

{% block page_title %}{{ course.title|e }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ── HERO « formation en avant » (noir + lime) ──────────────────────────── */
    .cf-show-hero {
        display: grid; grid-template-columns: 1fr 320px;
        border: 1px solid var(--ink); margin-bottom: 32px;
    }
    @media (max-width: 768px) { .cf-show-hero { grid-template-columns: 1fr; } }

    /* Colonne gauche : bloc noir */
    .cf-show-hero__info { background: var(--ink); color: var(--bg); padding: 30px 32px; }
    .cf-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .12em;
        text-transform: uppercase; color: var(--accent); margin-bottom: 16px;
    }
    .cf-eyebrow::before { content: ""; width: 8px; height: 8px; background: var(--accent); display: block; }
    .cf-show-hero__cover { border: 1px solid rgba(242,239,230,.2); margin-bottom: 18px; max-height: 200px; overflow: hidden; }
    .cf-show-hero__cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .cf-show-hero__title {
        font-family: var(--display); font-size: clamp(1.8rem, 4vw, 3rem);
        line-height: .95; text-transform: uppercase; letter-spacing: -.02em; margin: 0 0 14px; color: var(--bg);
    }
    .cf-show-hero__subtitle { font-family: var(--mono); font-size: 13px; line-height: 1.6; color: rgba(242,239,230,.7); margin: 0 0 4px; max-width: 540px; }
    .cf-show-hero__instructor {
        margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(242,239,230,.18);
        font-family: var(--mono); font-size: 12px; color: rgba(242,239,230,.6);
    }
    .cf-show-hero__instructor strong {
        display: block; font-family: var(--display); font-size: 15px; color: var(--accent);
        font-weight: 400; letter-spacing: -.01em; text-transform: uppercase; margin-top: 2px;
    }
    .cf-show-hero__instructor p { margin: 8px 0 0; line-height: 1.5; }

    /* Colonne droite : panneau lime (stats + CTA) */
    .cf-show-hero__aside { background: var(--accent); color: var(--ink); padding: 24px; display: flex; flex-direction: column; }
    .cf-stat { padding: 10px 0; border-bottom: 1px solid rgba(13,13,13,.18); }
    .cf-stat:first-child { padding-top: 0; }
    .cf-stat__value { font-family: var(--display); font-size: 19px; line-height: 1; text-transform: uppercase; letter-spacing: -.01em; }
    .cf-stat__label { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: rgba(13,13,13,.6); margin-top: 4px; }
    .cf-aside-cta { margin-top: 20px; }

    /* Boutons CTA (fond ink sur le panneau lime) */
    .cf-btn {
        display: block; width: 100%; padding: 14px 18px;
        font-family: var(--body); font-size: 13px; font-weight: 700; letter-spacing: .06em;
        text-transform: uppercase; text-align: center; text-decoration: none;
        border: 1px solid var(--ink); background: var(--ink); color: var(--accent);
        cursor: pointer; transition: background var(--transition-fast), color var(--transition-fast);
    }
    .cf-btn:hover { background: var(--bg); color: var(--ink); }
    .cf-btn--outline { background: transparent; color: var(--ink); }
    .cf-btn--outline:hover { background: var(--ink); color: var(--accent); }

    /* Progression (panneau lime) */
    .cf-progress { margin-bottom: 12px; }
    .cf-progress__label { font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; color: rgba(13,13,13,.7); display: flex; justify-content: space-between; margin-bottom: 4px; }
    .cf-progress__bar { height: 6px; background: rgba(13,13,13,.12); border: 1px solid var(--ink); overflow: hidden; }
    .cf-progress__fill { height: 100%; background: var(--ink); transition: width .3s ease; }

    /* ── Sections (description, plan) ───────────────────────────────────────── */
    .cf-section { margin-bottom: 32px; border: 1px solid var(--ink); }
    .cf-section__header { padding: 12px 20px; background: var(--ink); color: var(--bg); }
    .cf-section__title { font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin: 0; }
    .cf-section__body { padding: 20px; line-height: 1.7; font-size: 14px; white-space: pre-line; }

    /* ── Trailer vidéo ──────────────────────────────────────────────────────── */
    .cf-trailer { margin-bottom: 32px; }
    .cf-trailer__embed { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border: 1px solid var(--ink); }
    .cf-trailer__embed iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }

    /* ── Plan de la formation ───────────────────────────────────────────────── */
    .cf-plan { margin-bottom: 32px; border: 1px solid var(--ink); }
    .cf-plan__module { border-bottom: 1px solid var(--line-soft); }
    .cf-plan__module:last-child { border-bottom: none; }
    .cf-plan__module-header { padding: 12px 20px; background: var(--bg-alt); display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line-soft); }
    .cf-plan__module-title { font-family: var(--display); font-size: 13px; font-weight: 400; letter-spacing: -.01em; margin: 0; flex: 1; text-transform: uppercase; }
    .cf-plan__module-count { font-family: var(--mono); font-size: 9px; color: var(--ink-mute); letter-spacing: .05em; }
    .cf-plan__lessons { list-style: none; margin: 0; padding: 0; }
    .cf-plan__lesson { display: flex; align-items: center; gap: 10px; padding: 8px 20px 8px 28px; border-bottom: 1px solid var(--line-soft); font-size: 13px; }
    .cf-plan__lesson:last-child { border-bottom: none; }
    .cf-plan__lesson-icon { flex-shrink: 0; opacity: .35; }
    .cf-plan__lesson-title { flex: 1; color: var(--ink-mute); }
    .cf-plan__lesson--preview .cf-plan__lesson-title { color: var(--ink); }
    .cf-plan__lesson--preview .cf-plan__lesson-icon { opacity: .7; color: var(--ok); }
    .cf-plan__lesson-duration { font-family: var(--mono); font-size: 10px; color: var(--ink-mute); }
</style>
{% endblock %}

{% block content %}

{# ── HERO « formation en avant » ──────────────────────────────────────────── #}
<section class="cf-show-hero" aria-label="Présentation de la formation">

    {# Colonne gauche : bloc noir #}
    <div class="cf-show-hero__info">
        <span class="cf-eyebrow">Formation</span>

        {% if course.coverImage is not null %}
            <div class="cf-show-hero__cover">
                <img src="{{ asset(course.coverImage|e) }}" alt="Couverture : {{ course.title|e }}">
            </div>
        {% endif %}

        <h2 class="cf-show-hero__title">{{ course.title|e }}</h2>

        {% if course.subtitle is not null %}
            <p class="cf-show-hero__subtitle">{{ course.subtitle|e }}</p>
        {% endif %}

        {% if course.instructorName is not null %}
            <div class="cf-show-hero__instructor">
                Formateur·rice
                <strong>{{ course.instructorName|e }}</strong>
                {% if course.instructorBio is not null %}
                    <p>{{ course.instructorBio|e }}</p>
                {% endif %}
            </div>
        {% endif %}
    </div>

    {# Colonne droite : panneau lime (stats + CTA) #}
    <div class="cf-show-hero__aside">

        {% if course.durationMinutesTotal is not null %}
            <div class="cf-stat">
                <div class="cf-stat__value">{{ course.durationMinutesTotal }} min</div>
                <div class="cf-stat__label">Durée totale</div>
            </div>
        {% endif %}

        <div class="cf-stat">
            <div class="cf-stat__value">{{ course.level.label() }}</div>
            <div class="cf-stat__label">Niveau</div>
        </div>

        {% if course.modules|length > 0 %}
            <div class="cf-stat">
                <div class="cf-stat__value">{{ course.modules|length }} module{{ course.modules|length > 1 ? 's' : '' }}</div>
                <div class="cf-stat__label">Programme</div>
            </div>
        {% endif %}

        <div class="cf-stat">
            <div class="cf-stat__value">{{ course.formattedPrice }}</div>
            <div class="cf-stat__label">Tarif</div>
        </div>

        {# ── CTA ── #}
        <div class="cf-aside-cta">
            {% if isEnrolled %}
                {% if enrollment is not null %}
                    <div class="cf-progress">
                        <div class="cf-progress__label">
                            <span>Progression</span>
                            <span>{{ enrollment.progressPercent }}%</span>
                        </div>
                        <div class="cf-progress__bar">
                            <div class="cf-progress__fill" style="width: {{ enrollment.progressPercent }}%"
                                 role="progressbar" aria-valuenow="{{ enrollment.progressPercent }}"
                                 aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                {% endif %}
                <a href="{{ path('app_course_learn', {slug: course.slug}) }}" class="cf-btn cf-btn--outline">
                    ▶ Continuer l'apprentissage
                </a>

            {% elseif app.user %}
                {# Formulaire d'inscription — CSRF validé dans CourseController::enroll() #}
                <form method="POST" action="{{ path('app_course_enroll', {slug: course.slug}) }}"
                      aria-label="S'inscrire à la formation">
                    <input type="hidden" name="_token" value="{{ csrf_token('enroll_' ~ course.id) }}">
                    <button type="submit" class="cf-btn">S'inscrire</button>
                </form>

            {% else %}
                <a href="{{ path('app_login', {_target_path: app.request.uri}) }}" class="cf-btn">
                    Se connecter pour s'inscrire
                </a>
            {% endif %}
        </div>

    </div>

</section>

{# ── DESCRIPTION ──────────────────────────────────────────────────────────── #}
{% if course.description is not null %}
    <section class="cf-section" aria-label="Description de la formation">
        <div class="cf-section__header">
            <h3 class="cf-section__title">Description</h3>
        </div>
        <div class="cf-section__body">{{ course.description|e }}</div>
    </section>
{% endif %}

{# ── APERÇU VIDÉO ─────────────────────────────────────────────────────────── #}
{% if course.trailerVideoUrl is not null %}
    <section class="cf-trailer" aria-label="Vidéo de présentation">
        <div class="cf-section__header" style="border: 1px solid var(--ink); border-bottom: none;">
            <h3 class="cf-section__title">Aperçu de la formation</h3>
        </div>
        <div class="cf-trailer__embed">
            <iframe src="{{ course.trailerVideoUrl|e }}"
                    title="Aperçu : {{ course.title|e }}"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen loading="lazy"></iframe>
        </div>
    </section>
{% endif %}

{# ── PLAN DE LA FORMATION ─────────────────────────────────────────────────── #}
{% if course.modules is not empty %}
    <section class="cf-plan" aria-label="Plan de la formation">
        <div class="cf-section__header">
            <h3 class="cf-section__title">Plan de la formation</h3>
        </div>

        {% for module in course.modules %}
            <div class="cf-plan__module">
                <div class="cf-plan__module-header">
                    <svg viewBox="0 0 24 24" aria-hidden="true"
                         style="width:14px;height:14px;stroke:var(--ink-mute);fill:none;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;">
                        <rect x="3" y="3" width="18" height="18" rx="0"/>
                        <path d="M3 9h18M9 21V9"/>
                    </svg>
                    <h4 class="cf-plan__module-title">{{ module.title|e }}</h4>
                    <span class="cf-plan__module-count">
                        {{ module.lessons|length }} leçon{{ module.lessons|length > 1 ? 's' : '' }}
                    </span>
                </div>

                {% if module.lessons is not empty %}
                    <ul class="cf-plan__lessons">
                        {% for lesson in module.lessons %}
                            <li class="cf-plan__lesson {% if lesson.isFreePreview %}cf-plan__lesson--preview{% endif %}">
                                {% if lesson.isFreePreview %}
                                    <svg class="cf-plan__lesson-icon" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                         aria-label="Aperçu gratuit">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                {% else %}
                                    <svg class="cf-plan__lesson-icon" width="12" height="12" viewBox="0 0 24 24" fill="none"
                                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                         aria-label="Réservé aux inscrits">
                                        <rect x="3" y="11" width="18" height="11"/>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                    </svg>
                                {% endif %}

                                <span class="cf-plan__lesson-title">{{ lesson.title|e }}</span>

                                {% if lesson.durationMinutes is not null %}
                                    <span class="cf-plan__lesson-duration">{{ lesson.durationMinutes }} min</span>
                                {% endif %}

                                {% if lesson.isFreePreview %}
                                    <span style="font-family: var(--mono); font-size: 8px; font-weight: 700;
                                                 letter-spacing: .1em; text-transform: uppercase; padding: 2px 5px;
                                                 background: var(--accent); color: var(--ink); border: 1px solid var(--accent);">
                                        Gratuit
                                    </span>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>
        {% endfor %}
    </section>
{% endif %}

{% endblock %}
