{% extends 'base_app.html.twig' %}

{#
 # course/index.html.twig — Catalogue des formations (design Street, d'après le prototype).
 #
 # Variables : courses (Course[] publiées), totalCourses (int).
 # Préfixe CSS : .cf- (course-formation). border-radius: 0 partout (règle Street).
 #
 # Choix de cadrage V1 :
 #   - Pas de barre de filtres par catégorie (les formations n'ont pas de catégories en base).
 #   - Pas de « places restantes / 40 » (pas de capacité en base).
 #   On affiche uniquement ce dont on dispose réellement (durée, modules, niveau, prix, formateur).
 #}

{% block page_title %}Formations{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ── HERO « SE FORMER. / TRANSMETTRE. » ─────────────────────────────────── */
    .cf-hero { padding: 40px 0 36px; border-bottom: 1px solid var(--ink); }
    .cf-eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--mono); font-size: 11px; font-weight: 700; letter-spacing: .12em;
        text-transform: uppercase; color: var(--ink-mute); margin-bottom: 18px;
    }
    .cf-eyebrow::before { content: ""; width: 8px; height: 8px; background: var(--accent); display: block; }
    .cf-hero__title {
        font-family: var(--display); font-size: clamp(2.6rem, 9vw, 6rem);
        line-height: .9; text-transform: uppercase; letter-spacing: -.02em; margin: 0;
        color: var(--ink);
    }
    .cf-hero__title .accent { color: var(--accent-2); display: block; }
    .cf-hero__subtitle {
        font-family: var(--mono); font-size: 13px; color: var(--ink-mute);
        line-height: 1.6; max-width: 620px; margin: 18px 0 24px;
    }

    /* Bouton signature (effet d'ombre décalée du prototype) */
    .cf-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 12px 18px; border: 1px solid var(--ink);
        font-family: var(--body); font-size: 12px; font-weight: 700;
        letter-spacing: .06em; text-transform: uppercase; text-decoration: none;
        cursor: pointer; border-radius: 0;
        transition: transform .12s, box-shadow .12s, background .12s, color .12s;
    }
    .cf-btn--primary { background: var(--accent); color: var(--ink); }
    .cf-btn--primary:hover { transform: translate(-2px,-2px); box-shadow: 4px 4px 0 var(--ink); }
    .cf-btn--light { background: var(--accent); color: var(--ink); }
    .cf-btn--light:hover { background: var(--bg); color: var(--ink); transform: translate(-2px,-2px); box-shadow: 4px 4px 0 var(--accent); }

    /* ── CATALOGUE ──────────────────────────────────────────────────────────── */
    .cf-catalogue-head {
        display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap;
        margin: 32px 0 16px;
    }
    .cf-catalogue-title { font-family: var(--display); font-size: clamp(1.6rem, 4vw, 2.4rem); text-transform: uppercase; margin: 0; }
    .cf-catalogue-count { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-mute); }

    .cf-grid {
        display: grid; grid-template-columns: repeat(3, 1fr);
        gap: 1px; background: var(--ink); border: 1px solid var(--ink);
    }
    @media (max-width: 960px) { .cf-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 620px) { .cf-grid { grid-template-columns: 1fr; } }

    .cf-card {
        background: var(--bg); display: flex; flex-direction: column;
        text-decoration: none; color: var(--ink); padding: 16px 18px 14px;
        transition: background .12s;
    }
    .cf-card:hover { background: var(--bg-alt); }

    .cf-chips { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .cf-chip {
        font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .1em;
        text-transform: uppercase; padding: 3px 7px; border: 1px solid var(--ink); white-space: nowrap;
    }
    .cf-chip--free  { background: var(--accent); }
    .cf-chip--paid  { background: var(--bg); }
    .cf-chip--level { background: var(--ink); color: var(--bg); }

    .cf-card__title {
        font-family: var(--display); font-size: 17px; line-height: 1.1; text-transform: uppercase;
        margin: 0 0 12px; letter-spacing: -.01em;
    }

    /* Ligne formateur : avatar carré + nom */
    .cf-instructor { display: flex; align-items: center; gap: 8px; margin-bottom: 10px; }
    .cf-instructor__avatar {
        width: 26px; height: 26px; flex-shrink: 0; border: 1px solid var(--ink);
        background: var(--ink); color: var(--accent); object-fit: cover;
        display: flex; align-items: center; justify-content: center;
        font-family: var(--mono); font-size: 9px; font-weight: 700;
    }
    .cf-instructor__name { font-family: var(--mono); font-size: 11px; color: var(--ink-mute); letter-spacing: .03em; }

    .cf-card__desc {
        font-family: var(--body); font-size: 13px; color: var(--ink-mute);
        line-height: 1.5; margin: 0 0 12px;
    }

    .cf-card__meta {
        display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
        margin-top: auto; padding-top: 10px; border-top: 1px solid var(--line-soft);
        font-family: var(--mono); font-size: 10px; letter-spacing: .04em; color: var(--ink-mute);
        text-transform: uppercase;
    }
    .cf-card__price { margin-left: auto; font-weight: 700; color: var(--ink); }

    /* ── État vide ──────────────────────────────────────────────────────────── */
    .cf-empty {
        padding: 50px 24px; text-align: center; border: 1px solid var(--line-soft);
        font-family: var(--mono); font-size: 12px; color: var(--ink-mute); text-transform: uppercase; letter-spacing: .06em;
    }

    /* ── BANDE FINALE « TON SAVOIR A DE LA VALEUR. » ────────────────────────── */
    .cf-cta {
        background: var(--ink); color: var(--bg);
        margin: 44px 0 8px;              /* largeur de contenu (pas de débordement → zéro risque de scroll horizontal) */
        padding: 48px 36px;
        border: 1px solid var(--ink);
    }
    @media (max-width: 700px) { .cf-cta { padding: 32px 20px; } }
    .cf-cta__inner { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: start; }
    @media (max-width: 820px) { .cf-cta__inner { grid-template-columns: 1fr; gap: 28px; } }
    .cf-cta__eyebrow {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .12em;
        text-transform: uppercase; color: rgba(242,239,230,.6); margin-bottom: 16px;
    }
    .cf-cta__eyebrow::before { content: ""; width: 8px; height: 8px; background: var(--accent); display: block; }
    .cf-cta__title {
        font-family: var(--display); font-size: clamp(2rem, 5vw, 3.4rem); line-height: .92;
        text-transform: uppercase; letter-spacing: -.02em; margin: 0 0 18px;
    }
    .cf-cta__title .accent { color: var(--accent-2); display: block; }
    .cf-cta__text { font-family: var(--mono); font-size: 13px; line-height: 1.6; color: rgba(242,239,230,.7); max-width: 460px; margin: 0 0 22px; }

    .cf-points { display: grid; grid-template-columns: 1fr 1fr; gap: 22px 24px; }
    @media (max-width: 480px) { .cf-points { grid-template-columns: 1fr; } }
    .cf-point__title {
        font-family: var(--body); font-size: 12px; font-weight: 700; letter-spacing: .08em;
        text-transform: uppercase; color: var(--accent); margin: 0 0 6px;
        display: flex; align-items: center; gap: 7px;
    }
    .cf-point__title::before { content: ""; width: 7px; height: 7px; background: var(--accent); display: block; }
    .cf-point__text { font-family: var(--mono); font-size: 11px; line-height: 1.5; color: rgba(242,239,230,.65); margin: 0; }
</style>
{% endblock %}

{% block content %}

{# ── HERO ─────────────────────────────────────────────────────────────────── #}
<section class="cf-hero">
    <span class="cf-eyebrow">Formation &amp; transmission</span>
    <h1 class="cf-hero__title">
        Se former.
        <span class="accent">Transmettre.</span>
    </h1>
    <p class="cf-hero__subtitle">
        Des formations montées par Bazaart et des ateliers proposés par les artistes,
        artisans et formateurs de la communauté.
    </p>
    {# Le bouton « Proposer un atelier » mène au formulaire de proposition (ADR-0012) #}
    <a href="{{ path('app_course_proposal_new') }}" class="cf-btn cf-btn--primary">
        ↗ Proposer un atelier
    </a>
</section>

{# ── CATALOGUE ────────────────────────────────────────────────────────────── #}
<div class="cf-catalogue-head">
    <h2 class="cf-catalogue-title">Catalogue</h2>
    <span class="cf-catalogue-count">
        {{ totalCourses }} formation{{ totalCourses > 1 ? 's' : '' }} disponible{{ totalCourses > 1 ? 's' : '' }}
    </span>
</div>

{% if courses is empty %}
    <div class="cf-empty">Aucune formation disponible pour le moment. Reviens bientôt !</div>
{% else %}
    <div class="cf-grid" role="list">
        {% for course in courses %}
            <a href="{{ path('app_course_show', {slug: course.slug}) }}" class="cf-card" role="listitem"
               aria-label="Voir la formation : {{ course.title|e }}">

                {# Chips : niveau + gratuit/payant #}
                <div class="cf-chips">
                    <span class="cf-chip cf-chip--level">{{ course.level.label() }}</span>
                    {% if course.priceInCents is null or course.priceInCents == 0 %}
                        <span class="cf-chip cf-chip--free">Gratuit</span>
                    {% else %}
                        <span class="cf-chip cf-chip--paid">{{ course.formattedPrice }}</span>
                    {% endif %}
                </div>

                <h3 class="cf-card__title">{{ course.title|e }}</h3>

                {% if course.instructorName is not null %}
                    <div class="cf-instructor">
                        {% if course.instructorAvatar is not null %}
                            <img class="cf-instructor__avatar" src="{{ asset(course.instructorAvatar|e) }}" alt="">
                        {% else %}
                            <span class="cf-instructor__avatar" aria-hidden="true">{{ course.instructorName|slice(0, 2)|upper }}</span>
                        {% endif %}
                        <span class="cf-instructor__name">{{ course.instructorName|e }}</span>
                    </div>
                {% endif %}

                {% if course.subtitle is not null %}
                    <p class="cf-card__desc">{{ course.subtitle|e }}</p>
                {% elseif course.description is not null %}
                    <p class="cf-card__desc">{{ course.description|striptags|slice(0, 110)|e }}{% if course.description|striptags|length > 110 %}…{% endif %}</p>
                {% endif %}

                <div class="cf-card__meta">
                    {% if course.durationMinutesTotal is not null %}
                        <span>◷ {{ course.durationMinutesTotal }} min</span>
                    {% endif %}
                    {% if course.modules|length > 0 %}
                        <span>▤ {{ course.modules|length }} module{{ course.modules|length > 1 ? 's' : '' }}</span>
                    {% endif %}
                    <span class="cf-card__price">{{ course.formattedPrice }}</span>
                </div>

            </a>
        {% endfor %}
    </div>
{% endif %}

{# ── BANDE FINALE « TON SAVOIR A DE LA VALEUR. » ──────────────────────────── #}
<section class="cf-cta">
    <div class="cf-cta__inner">
        <div>
            <span class="cf-cta__eyebrow">Pour les artistes, artisans &amp; formateurs</span>
            <h2 class="cf-cta__title">
                Ton savoir
                <span class="accent">a de la valeur.</span>
            </h2>
            <p class="cf-cta__text">
                Propose ton atelier ou ta formation : on s'occupe des inscriptions, des
                paiements et de la logistique. Toi, tu transmets.
            </p>
            <a href="{{ path('app_course_proposal_new') }}" class="cf-btn cf-btn--light">
                ↗ Proposer un atelier
            </a>
        </div>

        <div class="cf-points">
            <div class="cf-point">
                <h3 class="cf-point__title">Rémunéré</h3>
                <p class="cf-point__text">Tu es rétribué·e quand des artistes s'inscrivent à ta formation.</p>
            </div>
            <div class="cf-point">
                <h3 class="cf-point__title">Visible</h3>
                <p class="cf-point__text">Ton atelier est mis en avant auprès de toute la communauté Bazaart.</p>
            </div>
            <div class="cf-point">
                <h3 class="cf-point__title">Sans friction</h3>
                <p class="cf-point__text">Inscriptions, paiements et rappels : on gère tout pour toi.</p>
            </div>
            <div class="cf-point">
                <h3 class="cf-point__title">Encadré</h3>
                <p class="cf-point__text">Un cadre clair et un accompagnement de l'équipe à chaque étape.</p>
            </div>
        </div>
    </div>
</section>

{% endblock %}
