{% extends 'base_app.html.twig' %}

{#
 # article/show.html.twig — Lecture d'un article (thème Street / design ArticleView)
 #
 # Variables transmises par ArticleController::show() :
 #   - article   : Article — l'article a afficher (publie ou brouillon si auteur/admin)
 #   - isPreview : bool — true si l'auteur visualise son propre brouillon
 #
 # Structure :
 #   - Bandeau brouillon si isPreview = true
 #   - Breadcrumb "← Articles"
 #   - En-tete : eyebrow mono + H1 Archivo Black geant + excerpt serif italic
 #   - Image de couverture pleine largeur (ratio 16/9)
 #   - Corps de l'article avec dropcap CSS sur le premier paragraphe
 #   - Actions admin (Modifier / Supprimer)
 #}

{% block title %}{{ article.title }} — Articles — BazaArt{% endblock %}

{#
 # Meta description — utilisee par Google dans les resultats de recherche.
 # On utilise l'excerpt de l'article s'il est renseigne.
 # Si excerpt est null (article sans accroche), le filtre |default bascule
 # sur la description generique de base.html.twig.
 #
 # ⚠️ Contrainte Twig : un {% block %} NE PEUT PAS etre imbrique dans un {% if %}.
 # Il faut mettre le if/else a l'interieur du bloc, pas l'inverse.
 # Twig auto-escape les valeurs dans les attributs HTML -> pas besoin de |e.
 #}
{% block meta_description %}{{ article.excerpt|default('BazaArt, la plateforme des artistes de la diaspora afro-atlantique : opportunites, communaute et formation.') }}{% endblock %}

{#
 # meta_extra : balises specifiques a la fiche article.
 #
 # canonical : indique a Google l'URL de reference pour cet article.
 # Evite le duplicate content si l'article est accessible via plusieurs chemins.
 # url() (vs path()) genere une URL absolue, requise pour canonical et OG.
 #
 # Open Graph (og:*) : metadonnees lues par Facebook, LinkedIn, WhatsApp, Slack...
 # quand un utilisateur partage le lien. Sans ces balises, le reseau social
 # choisit lui-meme titre/image -> resultat souvent mediocre.
 #
 # Twitter Card : metadonnees pour X (ex-Twitter). summary_large_image affiche
 # une grande miniature sous le titre — plus accrocheur qu'un simple resume.
 # Meme si X lit aussi les balises og:*, avoir twitter:* garantit la compatibilite.
 #
 # og:image / twitter:image : on n'injecte l'image que si coverImagePath est
 # defini, pour eviter une URL cassee (image absente = mauvais apercu).
 # absolute_url() prefixe le chemin relatif de l'asset avec le domaine courant.
 #}
{% block meta_extra %}
    {# URL canonique absolue de cet article #}
    {% set articleUrl = url('app_article_show', {slug: article.slug}) %}

    <link rel="canonical" href="{{ articleUrl }}">

    {# ── Open Graph ────────────────────────────────────────────────────────── #}
    <meta property="og:type"        content="article">
    <meta property="og:title"       content="{{ article.title }}">
    <meta property="og:url"         content="{{ articleUrl }}">
    {% if article.excerpt %}
        <meta property="og:description" content="{{ article.excerpt }}">
    {% endif %}
    {% if article.coverImagePath %}
        {#
         # absolute_url() + asset() = URL complete de l'image (ex: https://bazaart.fr/uploads/...).
         # Les reseaux sociaux requierent une URL absolue pour recuperer l'image.
        #}
        <meta property="og:image" content="{{ absolute_url(asset(article.coverImagePath)) }}">
    {% endif %}
    <meta property="og:site_name"   content="BazaArt">
    <meta property="og:locale"      content="fr_FR">

    {# ── Twitter Card ─────────────────────────────────────────────────────── #}
    {# summary_large_image : grande image + titre + description sous le tweet. #}
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="{{ article.title }}">
    {% if article.excerpt %}
        <meta name="twitter:description" content="{{ article.excerpt }}">
    {% endif %}
    {% if article.coverImagePath %}
        <meta name="twitter:image"   content="{{ absolute_url(asset(article.coverImagePath)) }}">
    {% endif %}
{% endblock %}

{% block page_title %}Articles{% endblock %}

{% block stylesheets %}
{{ parent() }}
{# Styles prefixes .art- pour eviter les collisions avec les autres pages #}
<style>

    /* ── Bandeau brouillon ──────────────────────────────────────────────────── */

    /*
     * .art-draft-banner : avertissement visible uniquement en mode apercu.
     * Fond encre (--ink) + texte lime (--accent) = contraste maximal,
     * impossible a rater avant de partager un lien.
     */
    .art-draft-banner {
        background: var(--ink);
        color: var(--accent);
        border-bottom: 1px solid var(--ink);
        padding: 10px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .art-draft-banner a {
        color: var(--accent);
        text-decoration: underline;
        font-size: 11px;
    }

    /* ── Conteneur principal centré ─────────────────────────────────────────── */

    /*
     * .art-container : max-width 880px, centre horizontalement.
     * Padding vertical genereux pour aerer la lecture.
     * Les articles longs se lisent mieux sur une colonne etroite.
     */
    .art-container {
        max-width: 880px;
        margin: 0 auto;
        padding-top: 32px;
        padding-bottom: 64px;
    }

    /* ── Breadcrumb ──────────────────────────────────────────────────────────── */

    /*
     * Bouton "← Articles" style ghost (btn btn-sm btn-ghost du systeme design).
     * Utilise les classes utilitaires existantes plutot que de creer un style sur mesure.
     */

    /* ── Section identite de l'article ─────────────────────────────────────── */

    /*
     * .art-identity : espace entre le breadcrumb et le corps.
     * margin-top 32px pour respirer apres le lien retour.
     */
    .art-identity {
        margin-top: 32px;
    }

    /* Eyebrow : categorie + temps + date en mono discret */
    .art-identity__eyebrow {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin: 0 0 0;
    }

    /*
     * Titre H1 : Archivo Black, tres grand, effet affiche.
     * clamp() : 48px sur mobile, 8vw sur tablette, 80px max sur ecran large.
     * line-height 0.92 : les lignes se serrent pour un bloc typographique fort.
     * margin 16px 0 24px : espace sous l'eyebrow, espace avant l'excerpt.
     */
    .art-identity__title {
        font-family: var(--display);
        font-size: clamp(48px, 8vw, 80px);
        line-height: 0.92;
        letter-spacing: -.02em;
        text-transform: uppercase;
        color: var(--ink);
        margin: 16px 0 24px;
    }

    /* Excerpt / chapeau en Instrument Serif italic */
    .art-identity__excerpt {
        font-family: var(--serif, Georgia, serif);
        font-size: 24px;
        font-style: italic;
        color: var(--ink-mute);
        line-height: 1.4;
        margin: 0;
    }

    /* ── Image de couverture ─────────────────────────────────────────────────── */

    /*
     * .art-cover : image pleine largeur, ratio 16/9 preserve via padding-bottom.
     * position:relative sur le conteneur, position:absolute sur l'image
     * = technique CSS classique pour forcer un ratio sans JS.
     */
    .art-cover {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%; /* ratio 16:9 = 9/16 = 56.25% */
        overflow: hidden;
        margin-top: 32px;
        background: #e0e0e0;
    }

    .art-cover img {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Placeholder si pas d'image de couverture (meme ratio 16/9) */
    .art-cover__placeholder {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #999;
    }

    /* ── Corps de l'article ─────────────────────────────────────────────────── */

    /*
     * .art-content : typographie pour la lecture longue.
     * font-size 17px + line-height 1.65 = standard editorial confortable.
     * Les regles CSS specifiques ci-dessous gèrent :
     *   - dropcap sur le premier paragraphe (::first-letter)
     *   - taille agrandie du premier para
     *   - titres H2/H3 en Archivo Black
     *   - espacement des paragraphes
     *   - gras et italic
     */
    .art-content {
        margin-top: 32px;
        font-size: 17px;
        line-height: 1.65;
        color: var(--ink);
    }

    /*
     * Dropcap : premiere lettre du premier paragraphe agrandie, flottante a gauche.
     * Technique CSS pure — pas de JS. Le float + line-height 0.85 + margin-top negatif
     * centrent visuellement la lettre sur la hauteur des 2-3 premieres lignes.
     * Archivo Black (--display) : corps typographique ideal pour un dropcap fort.
     */
    .art-content > p:first-child::first-letter {
        float: left;
        font-family: var(--display);
        font-size: 88px;
        line-height: 0.85;
        margin-right: 8px;
        margin-top: -4px;
        /* Pas de color specifique : herite de var(--ink) du parent */
    }

    /* Premier paragraphe legerement plus grand pour l'entree en lecture */
    .art-content > p:first-child {
        font-size: 22px;
        line-height: 1.5;
    }

    /* Titres de section dans le corps : Archivo Black, 36px */
    .art-content h2,
    .art-content h3 {
        font-family: var(--display);
        font-size: 36px;
        line-height: 1;
        letter-spacing: -.01em;
        text-transform: uppercase;
        margin-top: 32px;
        margin-bottom: 12px;
        color: var(--ink);
    }

    /* H3 legerement plus petit que H2 */
    .art-content h3 { font-size: 28px; }

    /* Espacement entre les paragraphes */
    .art-content p { margin-bottom: 16px; }

    /* Gras et italic : simples, pas de decoration supplementaire */
    .art-content strong { font-weight: 700; }
    .art-content em { font-style: italic; }

    /* ── Actions admin (Modifier / Supprimer) ────────────────────────────────── */

    /*
     * Affichees au-dessus du titre pour que l'admin les voie immediatement.
     * Margin-bottom separe les actions de la zone identite.
     */
    .art-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--line-soft);
    }

    /* Bouton "Modifier" : ghost avec bordure encre */
    .art-btn-edit {
        display: inline-flex;
        align-items: center;
        height: 32px;
        padding: 0 14px;
        border: 1px solid var(--ink);
        background: transparent;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ink);
        text-decoration: none;
        transition: background var(--transition-fast, .15s), color var(--transition-fast, .15s);
    }
    .art-btn-edit:hover {
        background: var(--ink);
        color: var(--accent);
    }

    /* Bouton "Supprimer" : accent-2 (orange) comme signal de danger */
    .art-btn-delete {
        display: inline-flex;
        align-items: center;
        height: 32px;
        padding: 0 14px;
        border: 1px solid var(--ink);
        background: var(--accent-2);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        cursor: pointer;
        transition: background var(--transition-fast, .15s);
    }
    .art-btn-delete:hover { background: var(--ink); color: var(--accent-2); }

    /* ── Responsive ─────────────────────────────────────────────────────────── */

    @media (max-width: 600px) {
        .art-identity__title { font-size: 42px; }
        .art-identity__excerpt { font-size: 18px; }
        .art-content { font-size: 16px; }
        .art-content > p:first-child { font-size: 18px; }
        .art-content > p:first-child::first-letter { font-size: 64px; }
    }
</style>
{% endblock %}

{% block content %}

{#
 # Banniere brouillon : visible uniquement si l'auteur previsualise son brouillon.
 # isPreview est passe par ArticleController::show() quand l'article n'est pas publie.
 #}
{% if isPreview %}
    <div class="art-draft-banner" role="alert">
        <span>APERCU - Cet article est en brouillon. Non visible par les autres membres.</span>
        <a href="{{ path('app_article_edit', {id: article.id}) }}">Modifier</a>
    </div>
{% endif %}

{# Conteneur principal : max-width 880px, centre horizontalement #}
<div class="art-container">

    {# ── Breadcrumb "← Articles" ─────────────────────────────────────────── #}
    {#
        Lien retour vers la liste, style ghost compact.
        Les classes btn/btn-sm/btn-ghost utilisent le systeme design existant.
    #}
    <a href="{{ path('app_article_index') }}" class="btn btn-sm btn-ghost">
        &larr; Articles
    </a>

    {# ── Actions admin (au-dessus du titre pour visibilite immediate) ───────── #}
    {#
        Decidisions produit V1 : publication reservee aux ROLE_ADMIN uniquement.
        is_granted() est sur meme sans utilisateur connecte (retourne false).
    #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="art-actions" style="margin-top: 24px;">

            <a href="{{ path('app_article_edit', {id: article.id}) }}"
               class="art-btn-edit">
                Modifier
            </a>

            {#
             # Formulaire de suppression en POST (semantique HTTP + protection CSRF).
             # Le token 'article_delete_{id}' est verifie dans ArticleController::delete().
            #}
            <form method="post"
                  action="{{ path('app_article_delete', {id: article.id}) }}"
                  onsubmit="return confirm('Supprimer definitivement cet article ?')">
                <input type="hidden" name="_token"
                       value="{{ csrf_token('article_delete_' ~ article.id) }}">
                <button type="submit" class="art-btn-delete">
                    Supprimer
                </button>
            </form>

        </div>
    {% endif %}

    {# ── Section identite : eyebrow + H1 + excerpt ───────────────────────── #}
    <div class="art-identity">

        {# Eyebrow mono : date de publication. #}
        {# category et readingTime absents de l'entité Article en V1 (prévus V2) #}
        <p class="art-identity__eyebrow">
            {{- article.publishedAt|date("d M Y")|upper -}}
        </p>

        {# H1 en Archivo Black, tres grand, effet affiche #}
        <h1 class="art-identity__title">{{ article.title }}</h1>

        {# Excerpt / chapeau en Instrument Serif italic, si disponible #}
        {% if article.excerpt %}
            <p class="art-identity__excerpt">{{ article.excerpt }}</p>
        {% endif %}

    </div>

    {# ── Image de couverture ─────────────────────────────────────────────── #}
    {#
        Ratio 16/9 impose via padding-bottom:56.25% (technique CSS pure).
        object-fit:cover garantit que l'image remplit le cadre sans deformation.
    #}
    <div class="art-cover">
        {% if article.coverImagePath %}
            <img src="{{ asset(article.coverImagePath) }}"
                 alt="{{ article.title }}">
        {% else %}
            {# Placeholder creme si pas d'image de couverture #}
            <div class="art-cover__placeholder">Image de couverture</div>
        {% endif %}
    </div>

    {# ── Corps de l'article ──────────────────────────────────────────────── #}
    {#
        |raw : le contenu est du HTML genere par l'editeur admin.
        Securite : la publication est reservee aux ROLE_ADMIN (confiance implicite).
        Si la publication s'ouvrait aux utilisateurs, passer par HTMLPurifier avant |raw.
        Le dropcap sur le premier paragraphe est gere integralement en CSS
        via .art-content > p:first-child::first-letter.
    #}
    <div class="art-content">
        {{ article.content|raw }}
    </div>

</div>

{% endblock %}
