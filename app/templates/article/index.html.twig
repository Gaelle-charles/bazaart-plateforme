{% extends 'base_app.html.twig' %}

{#
 # article/index.html.twig — Catalogue des articles (thème Street / design ScreenBlog)
 #
 # Variables transmises par ArticleController::index() :
 #   - articles : Article[] — liste des articles publiés (findPublished(), triés par date desc)
 #
 # Mise en page "ScreenBlog" :
 #   - En-tête impactant avec slogan sur deux lignes en Archivo Black géant
 #   - 1er article en format "à la une" : grille 2 colonnes (texte encré / image)
 #   - Articles suivants en grille 3 colonnes avec séparateurs bord à bord
 #   - Aucune ombre, border-radius 0, palette Street (crème / encre / lime)
 #}

{% block title %}Articles — BazaArt{% endblock %}
{% block page_title %}Articles{% endblock %}

{% block stylesheets %}
{{ parent() }}
{# Styles préfixés .art- pour éviter les collisions avec les autres pages #}
<style>

    /* ── En-tête ScreenBlog ─────────────────────────────────────────────────── */

    /*
     * .art-header : zone titre avec bordure basse épaisse.
     * paddingTop généreux pour un effet "magazine ouvert".
     * La bordure 1px solid var(--ink) souligne le titre sans surcharger.
     */
    .art-header {
        border-bottom: 1px solid var(--ink);
        padding-top: 48px;
        padding-bottom: 32px;
    }

    /* Eyebrow : petit texte mono au-dessus du titre géant */
    .art-header__eyebrow {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin: 0 0 16px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /*
     * Titre en deux lignes : "ON ÉCRIT." / "VOUS LISEZ."
     * clamp() : 80px sur mobile, 11vw sur tablette, 160px max sur grand écran.
     * line-height 0.88 : les lignes se collent pour un effet affiche fort.
     */
    .art-header__title {
        font-family: var(--display);
        font-size: clamp(80px, 11vw, 160px);
        line-height: 0.88;
        text-transform: uppercase;
        color: var(--ink);
        margin: 0;
        letter-spacing: -.03em;
    }

    /* Ligne secondaire du titre (même style, bloc séparé pour la sémantique) */
    .art-header__title span {
        display: block;
    }

    /* Bouton admin "Écrire un article +" positionné en haut à droite */
    .art-header__actions {
        margin-top: 24px;
    }

    /* ── Article à la UNE ───────────────────────────────────────────────────── */

    /*
     * .art-une : grille 2 colonnes asymétrique (texte légèrement plus large).
     * La bordure entourant les deux cellules crée l'encadré "affiche de presse".
     * margin-top 32px : séparation claire avec le header.
     */
    .art-une {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        border: 1px solid var(--ink);
        margin-top: 32px;
        text-decoration: none;
    }

    /*
     * Cellule gauche : fond encre (--ink), texte crème (--bg).
     * C'est le cœur éditorial de la UNE — fort contraste, beaucoup d'espace.
     * display:flex + flex-direction:column + justify-content:space-between
     * → le badge reste en haut, la méta reste en bas.
     */
    .art-une__body {
        background: var(--ink);
        color: var(--bg);
        padding: 40px 36px;
        min-height: 480px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-decoration: none;
    }

    /* Zone haute de la colonne texte : badge + titre + excerpt */
    .art-une__top {}

    /* Badge "À LA UNE" : fond lime (--accent) + texte encre → signature Street */
    .art-une__badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--accent);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        padding: 4px 10px;
    }

    /*
     * Titre de la UNE : très grand, Archivo Black.
     * 64px fixe (pas de clamp) car la colonne est elle-même fluide.
     * line-height 0.92 pour l'effet "bloc typographique".
     */
    .art-une__title {
        font-family: var(--display);
        font-size: 64px;
        line-height: 0.92;
        color: var(--bg);
        margin: 24px 0 0;
        text-transform: uppercase;
        letter-spacing: -.02em;
    }

    /* Excerpt / chapeau en Instrument Serif italic — corps éditorial de la UNE */
    .art-une__excerpt {
        font-family: var(--serif, Georgia, serif);
        font-size: 22px;
        font-style: italic;
        color: rgba(242, 239, 230, 0.8); /* var(--bg) à 80% d'opacité */
        margin-top: 20px;
        line-height: 1.4;
    }

    /* Zone basse : date + catégorie + temps de lecture en mono discret */
    .art-une__meta {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(242, 239, 230, 0.7);
        margin-top: 32px;
    }

    /* Cellule droite : image de couverture pleine cellule */
    .art-une__cover img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        min-height: 480px;
    }

    /* Placeholder si pas d'image de couverture */
    .art-une__placeholder {
        background: var(--line-soft, #e0e0e0);
        min-height: 480px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-mute, #999);
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    /* ── Grille 3 colonnes — articles suivants ──────────────────────────────── */

    /*
     * .art-grid : grille 3 colonnes sans gap (les bordures font office de séparateurs).
     * Bordure gauche, droite et basse sur le conteneur.
     * Chaque carte gère ses propres bordures top/right selon sa position.
     */
    .art-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        border-left: 1px solid var(--ink);
        border-right: 1px solid var(--ink);
        border-bottom: 1px solid var(--ink);
    }

    /*
     * .art-card : lien cliquable — toute la carte est le lien.
     * display:flex + flex-direction:column pour pousser la date en bas.
     */
    .art-card {
        padding: 28px 22px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        text-decoration: none;
        color: var(--ink);
        background: var(--bg);
    }

    /* Miniature de couverture : ratio 3/2 via padding-bottom */
    .art-card__thumb {
        position: relative;
        width: 100%;
        padding-bottom: 66.66%; /* ratio 3:2 */
        overflow: hidden;
        background: var(--line-soft, #e0e0e0);
    }

    .art-card__thumb img {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        object-fit: cover;
        display: block;
    }

    /* Placeholder image dans les cards */
    .art-card__thumb-placeholder {
        position: absolute;
        top: 0; left: 0;
        width: 100%; height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 10px;
        color: var(--ink-mute, #999);
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    /* Catégorie + temps de lecture en mono discret */
    .art-card__meta {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin: 0;
    }

    /* Titre de la carte en Archivo Black 24px */
    .art-card__title {
        font-family: var(--display);
        font-size: 24px;
        line-height: 1;
        letter-spacing: -.01em;
        text-transform: uppercase;
        color: var(--ink);
        margin: 0;
    }

    /* Extrait court en mono */
    .art-card__excerpt {
        font-family: var(--mono);
        font-size: 13px;
        line-height: 1.5;
        color: var(--ink-mute);
        margin: 0;
    }

    /* Date de publication poussée vers le bas (margin-top:auto) */
    .art-card__date {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-top: auto;
    }

    /* ── État vide ───────────────────────────────────────────────────────────── */

    .art-empty {
        border: 1px solid var(--ink);
        padding: 64px 48px;
        text-align: center;
        margin-top: 32px;
    }

    .art-empty__title {
        font-family: var(--display);
        font-size: 28px;
        text-transform: uppercase;
        color: var(--ink);
        margin: 0 0 12px;
    }

    .art-empty__sub {
        font-family: var(--mono);
        font-size: 12px;
        letter-spacing: .08em;
        color: var(--ink-mute);
        margin: 0 0 24px;
    }

    /* ── Bouton admin ────────────────────────────────────────────────────────── */

    .art-btn-new {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: var(--btn-padding, 10px 18px);
        background: var(--btn-primary-bg, var(--accent));
        color: var(--btn-primary-color, var(--ink));
        border: 1px solid var(--ink);
        font-family: var(--mono);
        font-size: var(--btn-font-size, 11px);
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        text-decoration: none;
        border-radius: 0;
        transition: background var(--transition-fast, .15s), color var(--transition-fast, .15s);
    }
    .art-btn-new:hover {
        background: var(--ink);
        color: var(--accent);
    }

    /* ── Responsive ─────────────────────────────────────────────────────────── */

    @media (max-width: 900px) {
        /* La UNE passe en colonne unique : image au-dessus, texte en dessous */
        .art-une {
            grid-template-columns: 1fr;
        }
        .art-une__cover { order: -1; }
        .art-une__cover img,
        .art-une__placeholder { min-height: 240px; }

        /* Grille 3 colonnes -> 2 colonnes sur tablette */
        .art-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 600px) {
        .art-header__title { font-size: clamp(56px, 15vw, 80px); }

        /* Grille 2 -> 1 colonne sur mobile */
        .art-grid { grid-template-columns: 1fr; }

        .art-une__title { font-size: 40px; }
        .art-une__excerpt { font-size: 18px; }
    }
</style>
{% endblock %}

{% block content %}

{# ── En-tête ScreenBlog ──────────────────────────────────────────────────────── #}
<header class="art-header">

    {# Eyebrow : signal éditorial avant le titre géant #}
    <p class="art-header__eyebrow">
        <span aria-hidden="true">&#9632;</span> {# carré plein unicode ■ #}
        Le journal de Bazaart
    </p>

    {# Titre en deux lignes — l'effet typographique principal de ce design #}
    <h1 class="art-header__title">
        <span>On écrit.</span>
        <span>Vous lisez.</span>
    </h1>

    {#
        Bouton "Écrire un article +" visible uniquement pour les admins.
        is_granted('ROLE_ADMIN') utilise la hiérarchie de rôles de security.yaml.
        La publication est admin-only en V1 (décision produit).
    #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="art-header__actions">
            <a href="{{ path('app_article_new') }}" class="art-btn-new">
                + Ecrire un article
            </a>
        </div>
    {% endif %}

</header>

{# ── Contenu ─────────────────────────────────────────────────────────────────── #}

{% if articles|length > 0 %}

    {# ─ Article à la UNE ─────────────────────────────────────────────────────── #}
    {#
        Premier article en format "affiche de presse" :
        grille 2 colonnes avec fond encre à gauche et image à droite.
        Toute la zone gauche est un lien cliquable vers l'article.
    #}
    <div class="art-une">

        {# Colonne gauche : corps éditorial, fond encre #}
        <a href="{{ path('app_article_show', {slug: articles[0].slug}) }}" class="art-une__body">

            {# Partie haute : badge + titre + excerpt #}
            <div class="art-une__top">

                {# Badge "A LA UNE" en lime #}
                <span class="art-une__badge">
                    <span aria-hidden="true">&#9733;</span> {# ★ étoile unicode #}
                    A la une
                </span>

                {# Titre en Archivo Black 64px #}
                <h2 class="art-une__title">{{ articles[0].title }}</h2>

                {# Excerpt (accroche) en Instrument Serif italic, si disponible #}
                {% if articles[0].excerpt|default('') != '' %}
                    <p class="art-une__excerpt">{{ articles[0].excerpt }}</p>
                {% endif %}

            </div>

            {# Partie basse : date de publication #}
            {# readingTime et category absents de l'entité Article en V1 - prévu V2 #}
            <p class="art-une__meta">
                {{ articles[0].publishedAt|date("d M Y")|upper }}
            </p>

        </a>

        {# Colonne droite : image de couverture pleine cellule #}
        <div class="art-une__cover">
            {% if articles[0].coverImagePath %}
                <img src="{{ asset(articles[0].coverImagePath) }}"
                     alt="{{ articles[0].title }}">
            {% else %}
                {# Placeholder hachuré si pas d'image #}
                <div class="art-une__placeholder">
                    Image de couverture
                </div>
            {% endif %}
        </div>

    </div>

    {# ─ Grille 3 colonnes — articles suivants ────────────────────────────────── #}
    {#
        On saute le premier article (déjà affiché en UNE) avec |slice(1).
        Chaque carte est un lien <a> complet pour maximiser la zone cliquable.
    #}
    {% if articles|slice(1)|length > 0 %}
        <div class="art-grid" role="list" aria-label="Autres articles">

            {% for article in articles|slice(1) %}
                {#
                    i = index 0-based à l'intérieur de la grille 3 colonnes.
                    Utilisé pour calculer :
                      - border-right : présente si ce n'est pas la dernière colonne (i % 3 < 2)
                      - border-top : présente à partir de la 2e rangée (i >= 3)
                #}
                {% set i = loop.index0 %}

                <a href="{{ path('app_article_show', {slug: article.slug}) }}"
                   class="art-card"
                   role="listitem"
                   style="
                       {% if (i % 3) < 2 %}border-right: 1px solid var(--ink);{% endif %}
                       {% if i >= 3 %}border-top: 1px solid var(--ink);{% endif %}
                   ">

                    {# Miniature : ratio 3/2 via padding-bottom, position relative #}
                    <div class="art-card__thumb">
                        {% if article.coverImagePath %}
                            <img src="{{ asset(article.coverImagePath) }}"
                                 alt="{{ article.title }}">
                        {% else %}
                            <div class="art-card__thumb-placeholder">
                                Image
                            </div>
                        {% endif %}
                    </div>

                    {# Date de publication en mono (readingTime et category absents de l'entité V1) #}
                    <p class="art-card__meta">
                        {{ article.publishedAt|date("d M Y")|upper }}
                    </p>

                    {# Titre en Archivo Black 24px #}
                    <h3 class="art-card__title">{{ article.title }}</h3>

                    {# Excerpt tronqué à 100 caractères en mono #}
                    <p class="art-card__excerpt">
                        {{- article.excerpt|default('')|slice(0, 100) -}}
                        {%- if article.excerpt|default('')|length > 100 %}...{% endif %}
                    </p>

                    {# Date de publication poussée vers le bas #}
                    <time class="art-card__date"
                          datetime="{{ article.publishedAt|date('Y-m-d') }}">
                        {{ article.publishedAt|date("d M Y") }}
                    </time>

                </a>

            {% endfor %}

        </div>
    {% endif %}

{% else %}

    {# ─ État vide : aucun article publié ─────────────────────────────────────── #}
    <div class="art-empty">
        <p class="art-empty__title">Aucun article pour l'instant</p>
        <p class="art-empty__sub">Les analyses et ressources arrivent bientot</p>
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_article_new') }}" class="art-btn-new">
                Ecrire le premier article
            </a>
        {% endif %}
    </div>

{% endif %}

{% endblock %}
