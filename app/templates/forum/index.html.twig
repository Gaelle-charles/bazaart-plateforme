{% extends 'base_app.html.twig' %}

{% block title %}Forum de la communauté — BazaArt{% endblock %}
{% block page_title %}Forum{% endblock %}

{% block stylesheets %}
{{ parent() }}
{#
    Styles spécifiques à la page index du forum.
    Convention de nommage : préfixe ".fi-" (forum-index) pour éviter
    toute collision avec les classes d'autres pages du module forum.

    Thème Street :
    - Fond principal  : var(--bg)      = #F2EFE6
    - Fond alternatif : var(--bg-alt)  (légèrement plus sombre)
    - Encre           : var(--ink)     = #0D0D0D
    - Encre atténuée  : var(--ink-mute)
    - Séparateur doux : var(--line-soft)
    - Accent lime     : var(--accent)  = #C6F24E
    - Accent orange   : var(--accent-2) = #FF6B2C
    - Display         : var(--display) = "Archivo Black"
    - Corps           : var(--body)    = "Space Grotesk"
    - Monospace       : var(--mono)    = "JetBrains Mono"
    - Border-radius   : 0 partout (style affiche / street art)
    - Pas d'ombres
#}
<style>

    /* ══════════════════════════════════════════════════════════════
       RESET CRITIQUE — attribut HTML `hidden`
       Sans cette règle, `.fi-composer__form-area { display: flex }`
       écrase l'attribut `hidden` (priorité CSS > user-agent stylesheet).
       Résultat sans fix : le formulaire et les boutons "open-only"
       sont toujours visibles, le JS de toggle ne peut pas les cacher.
       `!important` ici est intentionnel et justifié : c'est un reset
       de comportement natif HTML, pas un raccourci.
    ══════════════════════════════════════════════════════════════ */
    [hidden] { display: none !important; }

    /* ══════════════════════════════════════════════════════════════
       RESET ET BASE
       Appliqués à tous les éléments du module .fi-*
    ══════════════════════════════════════════════════════════════ */

    .fi-wrapper {
        /* Conteneur global — pas de padding propre, géré par le layout parent */
        width: 100%;
    }

    /* ══════════════════════════════════════════════════════════════
       EN-TÊTE DE PAGE
       Flex horizontal : grand titre display à gauche, CTAs à droite.
       borderBottom marque la limite avec la tab bar.
    ══════════════════════════════════════════════════════════════ */

    .fi-header {
        border-bottom: 1px solid var(--ink);
        padding: 32px 0 20px;
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
    }

    /* Eyebrow : contexte en mono uppercase avant le titre géant */
    .fi-eyebrow {
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-mute);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Titre principal en Archivo Black — clamp pour s'adapter à la largeur d'écran */
    .fi-title {
        font-family: var(--display);
        font-size: clamp(64px, 9vw, 132px);
        line-height: 0.88;
        margin: 0;
        text-transform: uppercase;
        color: var(--ink);
    }

    /* Groupe de boutons CTA alignés en bas du bloc droit */
    .fi-header__ctas {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
        padding-bottom: 4px; /* aligne visuellement avec la baseline du titre */
    }

    /* ══════════════════════════════════════════════════════════════
       TAB BAR
       Flex horizontal collé, fond --bg-alt, séparateurs fins.
       Le JS vanilla gère uniquement le style de l'onglet actif.
       En V1 : pas de filtrage de contenu, juste un feedback visuel.
    ══════════════════════════════════════════════════════════════ */

    .fi-tabs {
        border-bottom: 1px solid var(--ink);
        background: var(--bg-alt);
        display: flex;
        overflow-x: auto; /* défilement horizontal sur petits écrans */
        scrollbar-width: none; /* Firefox */
        margin-bottom: 0;
    }
    .fi-tabs::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    /* Chaque onglet : bouton plat sans fond par défaut */
    .fi-tab {
        padding: 14px 18px;
        border: none;
        border-right: 1px solid var(--line-soft);
        background: transparent;
        color: var(--ink);
        font-family: var(--body);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background var(--transition-fast), color var(--transition-fast);
    }
    .fi-tab:last-child {
        border-right: none;
    }
    .fi-tab:hover:not(.fi-tab--active) {
        background: var(--ink);
        color: var(--bg);
    }

    /* Onglet actif : fond encre, texte accent lime */
    .fi-tab--active {
        background: var(--ink);
        color: var(--accent);
    }

    /* ══════════════════════════════════════════════════════════════
       GRILLE 3 COLONNES
       .85fr (catégories) | 2.2fr (feed) | .95fr (sidebar)
       Passage en colonne unique sous 900px.
    ══════════════════════════════════════════════════════════════ */

    .fi-grid {
        display: grid;
        grid-template-columns: .85fr 2.2fr .95fr;
        gap: 24px;
        padding-top: 24px;
        padding-bottom: 64px;
        align-items: start; /* les colonnes ne s'étirent pas mutuellement */
    }

    /* ══════════════════════════════════════════════════════════════
       COLONNE GAUCHE — CATEGORIES
       Sticky pour rester visible au scroll.
    ══════════════════════════════════════════════════════════════ */

    .fi-col-cats {
        position: sticky;
        top: 80px;
    }

    /* Boite catégories : bord encre, pas de rayon */
    .fi-cats-box {
        border: 1px solid var(--ink);
        overflow: hidden; /* le header interne sort dans les bords */
    }

    /* En-tête de la boite catégories : fond encre, texte accent mono */
    .fi-cats-box__header {
        padding: 14px 16px;
        background: var(--ink);
        color: var(--accent);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
    }

    /* Chaque lien de catégorie : flex, séparateur bas, hover fond alt */
    .fi-cat-link {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
        border-bottom: 1px solid var(--line-soft);
        background: transparent;
        color: var(--ink);
        text-decoration: none;
        font-size: 13px;
        font-family: var(--body);
        transition: background var(--transition-fast);
    }
    .fi-cat-link:last-child {
        border-bottom: none;
    }
    .fi-cat-link:hover {
        background: var(--bg-alt);
    }

    /* Compteur de threads en mono discret */
    .fi-cat-link__count {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-mute);
        flex-shrink: 0;
        margin-left: 8px;
    }

    /* ══════════════════════════════════════════════════════════════
       COLONNE CENTRALE — FEED DE THREADS
    ══════════════════════════════════════════════════════════════ */

    /* Avatar initiales : carré lime, texte encre, mono gras */
    .fi-composer__avatar {
        width: 36px;
        height: 36px;
        min-width: 36px;
        background: var(--accent);
        color: var(--ink);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 14px;
        font-weight: 700;
    }

    /* Placeholder textuel grisé */
    .fi-composer__placeholder {
        flex: 1;
        font-family: var(--body);
        font-size: 14px;
        color: var(--ink-mute);
    }

    /* Groupe de boutons du compositeur */
    .fi-composer__actions {
        display: flex;
        gap: 8px;
        flex-shrink: 0;
    }

    /* Liste des threads : pas d'espacement entre les cartes */
    .fi-thread-list {
        display: flex;
        flex-direction: column;
    }

    /* Carte thread : lien cliquable, grille 2 colonnes */
    .fi-thread-card {
        display: grid;
        grid-template-columns: 56px 1fr;
        border: 1px solid var(--ink);
        /* On écrase la border-top pour les cartes qui ne sont pas les premières
           → gérée par .fi-thread-card--first en Twig (loop.first) */
        border-top: 0;
        text-decoration: none;
        color: var(--ink);
        transition: background var(--transition-fast);
    }
    /* La première carte garde sa border-top pour fermer le bloc en haut */
    .fi-thread-card--first {
        border-top: 1px solid var(--ink);
    }

    /* Rail de vote à gauche : fond alt, flèches + compteur */
    .fi-thread-card__vote {
        background: var(--bg-alt);
        border-right: 1px solid var(--line-soft);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 14px 0;
        gap: 4px;
    }

    /* Flèches de vote — caractères Unicode */
    .fi-vote-arrow {
        font-size: 12px;
        color: var(--ink-mute);
        line-height: 1;
        user-select: none;
    }
    .fi-vote-arrow--down {
        opacity: .3;
    }

    /* Compteur numérique en Archivo Black */
    .fi-vote-count {
        font-family: var(--display);
        font-size: 18px;
        line-height: 1;
        color: var(--ink);
    }

    /* Contenu principal du thread : méta + titre + extrait */
    .fi-thread-card__body {
        padding: 14px 18px;
        transition: background var(--transition-fast);
    }
    .fi-thread-card:hover .fi-thread-card__body {
        /* Hover uniquement sur la partie textuelle, le rail reste neutre */
        background: var(--bg-alt);
    }

    /* Ligne de méta : auteur, date, badge catégorie — mono discret */
    .fi-thread-card__meta {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
        flex-wrap: wrap;
    }
    .fi-thread-card__meta-item {
        font-family: var(--mono);
        font-size: 10px;
        color: var(--ink-mute);
        letter-spacing: .04em;
    }

    /* Badge catégorie : chip bord encre, mono 9px */
    .fi-cat-chip {
        display: inline-block;
        padding: 2px 7px;
        border: 1px solid var(--ink);
        font-family: var(--mono);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--ink);
        line-height: 1.6;
    }

    /* Titre du thread en Archivo Black */
    .fi-thread-card__title {
        font-family: var(--display);
        font-size: 22px;
        line-height: 1.1;
        margin: 0 0 6px;
        text-transform: none;
        color: var(--ink);
    }

    /* Extrait du contenu : mono discret, tronqué */
    .fi-thread-card__excerpt {
        font-family: var(--mono);
        font-size: 13.5px;
        color: var(--ink-mute);
        margin: 0 0 8px;
        line-height: 1.5;
    }

    /* Vignette d'image jointe dans le feed — petite, bords francs */
    .fi-thread-card__thumb {
        margin: 0 0 10px;
    }
    .fi-thread-card__thumb img {
        display: block;
        max-width: 220px;
        max-height: 140px;
        width: auto;
        height: auto;
        object-fit: cover;
        border: 1px solid var(--ink);
    }

    /* Ligne méta basse : nb réponses, vues */
    .fi-thread-card__stats {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-mute);
    }

    /* Message "état vide" si aucun thread n'est disponible dans aucune catégorie */
    .fi-feed-empty {
        padding: 60px 24px;
        text-align: center;
        border: 1px dashed var(--ink);
        font-family: var(--display);
        font-size: 24px;
        text-transform: uppercase;
        color: var(--ink-mute);
    }

    /* ══════════════════════════════════════════════════════════════
       COLONNE DROITE — SIDEBAR
       Sticky, même offset que la colonne catégories.
    ══════════════════════════════════════════════════════════════ */

    .fi-col-sidebar {
        position: sticky;
        top: 80px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* Bloc "Règle de base" : fond accent lime */
    .fi-sidebar-rule {
        background: var(--accent);
        border: 1px solid var(--ink);
        padding: 16px;
    }
    .fi-sidebar-rule__label {
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--ink);
        margin-bottom: 8px;
    }
    .fi-sidebar-rule__text {
        font-size: 18px;
        font-style: italic;
        color: var(--ink);
        line-height: 1.4;
        margin: 0;
    }

    /* Bloc "Hot du jour" et "Lives à venir" : structure identique */
    .fi-sidebar-block {
        border: 1px solid var(--ink);
        overflow: hidden;
    }
    .fi-sidebar-block__header {
        padding: 12px 16px;
        border-bottom: 1px solid var(--ink);
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
        text-transform: uppercase;
        color: var(--ink);
    }

    /* Chaque item "hot" : lien vers le thread */
    .fi-hot-item {
        display: block;
        padding: 12px 16px;
        border-bottom: 1px solid var(--line-soft);
        text-decoration: none;
        color: var(--ink);
        transition: background var(--transition-fast);
    }
    .fi-hot-item:last-child {
        border-bottom: none;
    }
    .fi-hot-item:hover {
        background: var(--bg-alt);
    }
    .fi-hot-item__title {
        font-family: var(--body);
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 4px;
        line-height: 1.3;
    }
    .fi-hot-item__meta {
        font-family: var(--mono);
        font-size: 10px;
        color: var(--ink-mute);
    }

    /* Placeholder "aucun live" */
    .fi-sidebar-empty {
        padding: 16px;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--ink-mute);
        letter-spacing: .04em;
    }

    /* ══════════════════════════════════════════════════════════════
       COMPOSITEUR — ELEMENTS PARTAGÉS REPLIÉ / ÉTENDU
       .fi-composer__select : select de catégorie dans la barre repliée
       (état replié — la version étendue utilise .fi-composer__cat-select).
    ══════════════════════════════════════════════════════════════ */

    /* Select de catégorie dans la barre repliée */
    .fi-composer__select {
        padding: 6px 10px;
        border: 1px solid var(--ink);
        border-radius: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: var(--mono);
        font-size: 11px;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
    }

    /* ══════════════════════════════════════════════════════════════
       COMPOSITEUR — BARRE SUPERIEURE
       La barre top-bar est toujours visible : avatar + éléments
       qui changent selon l'état replié/étendu du compositeur.
    ══════════════════════════════════════════════════════════════ */

    /*
     * On remplace display:flex sur .fi-composer par un display:block,
     * et on met le flex sur .fi-composer__top-bar pour garder la
     * mise en page en ligne dans l'état replié.
     */
    .fi-composer {
        display: block;    /* override du flex précédent */
        padding: 14px 16px;
        background: var(--bg-alt);
        border: 1px solid var(--ink);
        margin-bottom: 16px;
    }

    /* Ligne horizontale : avatar + placeholder/label + actions */
    .fi-composer__top-bar {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    /* Label affiché en mode étendu à la place du placeholder */
    .fi-composer__open-label {
        flex: 1;
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--ink-mute);
    }

    /* ══════════════════════════════════════════════════════════════
       COMPOSITEUR — ZONE FORMULAIRE (etat etendu)
       Cachée par défaut via l'attribut HTML `hidden`.
       Quand JS retire `hidden`, le display CSS reprend la main.
    ══════════════════════════════════════════════════════════════ */

    /* Conteneur flex colonne du formulaire étendu */
    .fi-composer__form-area {
        display: flex;          /* actif uniquement quand `hidden` est absent */
        flex-direction: column;
        gap: 10px;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid var(--line-soft);
    }

    /* Ligne catégorie + bouton Publier */
    .fi-composer__form-top {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Select catégorie dans le formulaire étendu */
    .fi-composer__cat-select {
        flex: 1;
        padding: 8px 10px;
        border: 1px solid var(--ink);
        border-radius: 0;
        background: #fff;   /* blanc pour se distinguer du fond beige var(--bg) */
        color: var(--ink);
        font-family: var(--mono);
        font-size: 11px;
        appearance: none;
        -webkit-appearance: none;
        cursor: pointer;
    }
    .fi-composer__cat-select:focus {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
    }
    /* Couleur atténuée pour l'option placeholder "Choisissez votre categorie" */
    .fi-composer__cat-select option[value=""] {
        color: var(--ink-mute);
    }

    /* Champ titre — gras, texte encre, fond blanc */
    .fi-composer__input {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid var(--ink);
        border-radius: 0;
        background: #fff;   /* blanc pour se distinguer du fond beige */
        color: var(--ink);
        font-family: var(--body);
        font-size: 15px;
        font-weight: 600;
        box-sizing: border-box;
    }
    .fi-composer__input::placeholder {
        color: var(--ink-mute);
        font-weight: 400;
    }
    .fi-composer__input:focus {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
    }

    /* Zone de texte contenu — fond blanc */
    .fi-composer__textarea {
        width: 100%;
        min-height: 110px;
        padding: 10px 12px;
        border: 1px solid var(--ink);
        border-radius: 0;
        background: #fff;   /* blanc pour se distinguer du fond beige */
        color: var(--ink);
        font-family: var(--body);
        font-size: 14px;
        resize: vertical;
        box-sizing: border-box;
        line-height: 1.6;
    }
    .fi-composer__textarea::placeholder {
        color: var(--ink-mute);
    }
    .fi-composer__textarea:focus {
        outline: 2px solid var(--accent);
        outline-offset: -2px;
    }

    /* Champ image optionnel du compositeur — discret, cohérent avec le thème Street */
    .fi-composer__file-label {
        display: block;
        margin-top: 10px;
        margin-bottom: 6px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--ink-mute);
    }
    .fi-composer__file {
        display: block;
        width: 100%;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--ink);
        background: #fff;
        border: 1px solid var(--ink);
        padding: 8px;
        box-sizing: border-box;
        cursor: pointer;
    }
    .fi-composer__file::file-selector-button {
        font-family: var(--body);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--ink);
        background: var(--accent);
        border: 1px solid var(--ink);
        padding: 6px 12px;
        margin-right: 12px;
        cursor: pointer;
        border-radius: 0;
    }
    .fi-composer__file:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    /* ══════════════════════════════════════════════════════════════
       RESPONSIVE
       Passage en colonne unique sous 900px, 2 colonnes entre 640-900px.
    ══════════════════════════════════════════════════════════════ */

    @media (max-width: 900px) {
        .fi-grid {
            /* Catégories | Feed (on masque la sidebar) */
            grid-template-columns: .9fr 2fr;
        }
        .fi-col-sidebar {
            display: none;
        }
    }

    @media (max-width: 640px) {
        .fi-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 16px;
        }
        .fi-title {
            font-size: clamp(48px, 14vw, 80px);
        }
        .fi-grid {
            grid-template-columns: 1fr;
        }
        .fi-col-cats {
            position: static; /* annule le sticky sur mobile */
        }
    }

</style>
{% endblock %}

{% block content %}

<div class="fi-wrapper">

{# ── EN-TÊTE DE PAGE ──────────────────────────────────────────────────────────
   Flex horizontal : titre display + eyebrow à gauche, boutons CTA à droite.

   NOTE sur la route "Nouveau post" :
   La route app_forum_new_thread requiert un {categorySlug} car la création
   d'un thread est toujours liée à une catégorie. On pointe vers la première
   catégorie active si elle existe. Si le forum est vide, le bouton est absent.

   Convention Twig : on teste `categories|first` pour obtenir la première
   catégorie sans lever d'erreur si le tableau est vide.
#}
<div class="fi-header">

    {# Bloc gauche : eyebrow + titre géant #}
    <div>
        {#
            Eyebrow en mono uppercase — présente le contexte de la page.
            Le carré "■" est un caractère Unicode (U+25A0), pas un ::before CSS,
            pour conserver l'accessibilité des lecteurs d'écran.
        #}
        <div class="fi-eyebrow">
            <span aria-hidden="true">&#9632;</span>
            FORUM COMMUNAUTAIRE
        </div>

        {# Titre principal — Archivo Black, très grand, uppercase via CSS #}
        <h1 class="fi-title">ON SE PARLE.</h1>
    </div>

    {# Bloc droit : boutons d'action principaux #}
    <div class="fi-header__ctas">

        {#
            Bouton "Nouveau post" : actif uniquement si au moins une catégorie existe.
            On prend la première catégorie comme point d'entrée par défaut.
            Si toutes les catégories sont vides, on masque le bouton pour éviter
            une erreur de route (categorySlug manquant).
        #}
        {% if categories is not empty %}
            {% set firstCategory = categories|first %}
            <a href="{{ path('app_forum_new_thread', { categorySlug: firstCategory.slug }) }}"
               class="btn btn-primary">
                Nouveau post
            </a>
        {% endif %}

        {#
            NOTE V1 : le bouton "Programmer un live" a été retiré.
            La fonctionnalité Lives est reportée en V2 (cf. CDC V3 section 4).
        #}

    </div>

</div>{# fin fi-header #}

{# ── TAB BAR ──────────────────────────────────────────────────────────────────
   Barre de filtres horizontale.
   En V1 : le JS active/désactive le style de l'onglet courant,
   mais aucun filtrage de contenu n'est opéré (données statiques).
   L'attribut data-tab permettra d'accrocher du filtrage côté client en V2.
#}
<nav class="fi-tabs" role="tablist" aria-label="Filtres du forum">
    <button class="fi-tab fi-tab--active" role="tab" data-tab="all" aria-selected="true">
        Tout
    </button>
    <button class="fi-tab" role="tab" data-tab="hot" aria-selected="false">
        Hot
    </button>
    <button class="fi-tab" role="tab" data-tab="questions" aria-selected="false">
        Questions
    </button>
    {#
        NOTE V1 : les onglets "Lives en cours" et "Lives programmes" ont été retirés.
        La fonctionnalité Lives est reportée en V2 (cf. CDC V3 section 4).
    #}
    <button class="fi-tab" role="tab" data-tab="discussions" aria-selected="false">
        Discussions
    </button>
</nav>

{# ── GRILLE 3 COLONNES ────────────────────────────────────────────────────────
   .85fr catégories | 2.2fr feed | .95fr sidebar
   Les trois colonnes sont sticky à top: 80px sauf le feed central.
#}
<div class="fi-grid">

    {# ════════════════════════════════════════════════════════════════════════
       COLONNE GAUCHE — LISTE DES CATEGORIES
       Affiche toutes les catégories actives avec leur compteur de threads.
       La liste est sticky pour rester visible lors du scroll du feed.
    ════════════════════════════════════════════════════════════════════════ #}
    <div class="fi-col-cats">
        <div class="fi-cats-box">

            {# En-tête de la boite : fond encre, texte lime #}
            <div class="fi-cats-box__header">CATEGORIES</div>

            {# Cas vide : aucune catégorie configurée par l'admin #}
            {% if categories is empty %}
                <div class="fi-sidebar-empty">
                    Aucune categorie disponible.
                </div>
            {% else %}
                {#
                    Boucle sur toutes les catégories actives.
                    cat.threadsCount → méthode getThreadsCount() de ForumCategory,
                    qui compte les threads via la collection Doctrine (sans requête
                    supplémentaire si la collection est déjà chargée).
                #}
                {% for cat in categories %}
                    <a href="{{ path('app_forum_category', { categorySlug: cat.slug }) }}"
                       class="fi-cat-link"
                       aria-label="{{ cat.name }}, {{ cat.threadsCount }} sujet{{ cat.threadsCount > 1 ? 's' : '' }}">
                        <span class="fi-cat-link__name">{{ cat.name }}</span>
                        <span class="fi-cat-link__count">{{ cat.threadsCount }}</span>
                    </a>
                {% endfor %}
            {% endif %}

        </div>
    </div>{# fin fi-col-cats #}

    {# ════════════════════════════════════════════════════════════════════════
       COLONNE CENTRALE — FEED DE THREADS
       Compositeur en haut (appel à l'action), puis liste des threads récents.

       Source des données :
       Le controller passe `latestThreadsByCategory` (tableau indexé par id
       de catégorie → [threads...]). On "aplatit" (flatten) ici en Twig pour
       obtenir une liste chronologique unifiée.
       La dénomination `flatThreads` est une variable locale Twig.
    ════════════════════════════════════════════════════════════════════════ #}
    <div class="fi-col-feed">

        {# ── Zone compositeur inline ────────────────────────────────────────────
           Deux états gérés par JS vanilla :

           ETAT REPLIÉ (défaut) :
             [Avatar] [Une question, un appel, un partage...]  [Catégorie ▼] [Écrire]
             Les éléments marqués data-hide-when-open sont visibles.

           ETAT ETENDU (après clic) :
             [Avatar] [Nouveau post...]  [Annuler]
             -------------------------------------------------
             [Catégorie ▼]               [Publier]
             [Titre de votre post        ]
             [Développez votre idée...   ]

           Fonctionnement :
             fiComposerOpen()  : ajoute hidden sur les éléments data-hide-when-open,
                                 retire hidden sur les éléments data-show-when-open,
                                 synchronise le select catégorie, met le focus sur titre.
             fiComposerClose() : inverse, reset du formulaire.

           CSRF : même token que newThread() (forum_new_thread).
           Route : POST /forum/nouveau (app_forum_quick_post, sans categorySlug).
        #}
        <div class="fi-composer" id="fi-composer">

            {% if categories is not empty %}

                {# ── Barre horizontale (toujours visible) ──────────────────── #}
                <div class="fi-composer__top-bar">

                    {# Avatar initiales : carré lime, lettre de l'email #}
                    <div class="fi-composer__avatar" aria-hidden="true">
                        {% if app.user %}
                            {#
                                Extrait la première lettre de la partie locale de l'email.
                                Exemple : "gaelle@bazaart.fr" → "G"
                            #}
                            {{ app.user.email|split('@')|first|slice(0,1)|upper }}
                        {% else %}
                            ?
                        {% endif %}
                    </div>

                    {#
                        Placeholder cliquable (état replié uniquement).
                        data-hide-when-open : le JS le masque quand le formulaire s'ouvre.
                        flex:1 via .fi-composer__placeholder pour pousser les actions à droite.
                    #}
                    {#
                        Placeholder texte — cliquable, mais surtout indicatif.
                        Le vrai déclencheur visible est le bouton "Écrire" juste après.
                    #}
                    <button type="button"
                            class="fi-composer__placeholder"
                            data-hide-when-open
                            onclick="fiComposerOpen()"
                            aria-label="Ouvrir le formulaire de creation de post"
                            style="background:none;border:none;text-align:left;padding:0;cursor:pointer;flex:1;">
                        Une question, un appel, un partage...
                    </button>

                    {# Bouton "Écrire" — CTA principal visible en état replié #}
                    <button type="button"
                            class="btn btn-primary btn-sm"
                            data-hide-when-open
                            onclick="fiComposerOpen()">
                        Ecrire
                    </button>

                    {#
                        Libellé + bouton Annuler visibles uniquement en état étendu.
                        hidden par défaut — le JS retire l'attribut au moment de l'ouverture.
                    #}
                    <span class="fi-composer__open-label" data-show-when-open hidden>
                        Nouveau post...
                    </span>
                    <button type="button"
                            class="btn btn-ghost btn-sm"
                            data-show-when-open
                            onclick="fiComposerClose()"
                            hidden
                            aria-label="Fermer le formulaire sans publier">
                        Annuler
                    </button>

                </div>{# fin fi-composer__top-bar #}

                {# ── Formulaire étendu (caché par défaut) ──────────────────── #}
                {#
                    hidden par défaut — affiché par fiComposerOpen() via JS.
                    Action : POST /forum/nouveau (route app_forum_quick_post).
                    La catégorie est transmise par l'id (name="categoryId").
                    Le token CSRF est généré côté Symfony (même intention que newThread).
                #}
                <div class="fi-composer__form-area" data-show-when-open hidden id="fi-composer-form-area">

                    {#
                        enctype="multipart/form-data" : obligatoire pour transmettre le
                        fichier image. C'est le SEUL changement structurel du formulaire ;
                        le JavaScript du compositeur (fiComposerOpen/Close) n'est pas touché
                        — il ne fait que basculer `hidden` et `form.reset()`, ce qui gère
                        nativement un champ fichier. Aucun risque de casse de l'ouverture/fermeture.
                    #}
                    <form method="post"
                          action="{{ path('app_forum_quick_post') }}"
                          id="fi-composer-form"
                          enctype="multipart/form-data">

                        {# Token CSRF — protège contre les faux POST depuis d'autres sites #}
                        <input type="hidden" name="_token" value="{{ csrf_token('forum_new_thread') }}">

                        {# Ligne catégorie + bouton Publier #}
                        <div class="fi-composer__form-top">

                            {#
                                Select catégorie du formulaire réel.
                                Sa valeur est synchronisée depuis fi-composer-cat-quick
                                dans fiComposerOpen() pour garder la sélection cohérente.
                                name="categoryId" : l'ID est envoyé en POST body,
                                résolu dans ForumController::quickPost().
                            #}
                            <select name="categoryId"
                                    id="fi-composer-cat-form"
                                    class="fi-composer__cat-select"
                                    aria-label="Categorie du post"
                                    required>
                                {#
                                    Option par défaut non sélectionnable : guide l'utilisateur
                                    vers le choix de catégorie avant de pouvoir publier.
                                    value="" + disabled + selected = placeholder natif HTML.
                                    required sur le select bloque la soumission si non choisi.
                                #}
                                <option value="" disabled selected>Choisissez votre categorie</option>
                                {% for cat in categories %}
                                    <option value="{{ cat.id }}">{{ cat.name }}</option>
                                {% endfor %}
                            </select>

                            <button type="submit" class="btn btn-primary btn-sm">
                                Publier
                            </button>

                        </div>

                        {# Titre du thread (obligatoire) #}
                        <input type="text"
                               name="title"
                               id="fi-composer-title"
                               class="fi-composer__input"
                               placeholder="Titre de votre post (obligatoire)"
                               maxlength="255"
                               required
                               autocomplete="off">

                        {# Contenu (obligatoire) #}
                        <textarea name="content"
                                  id="fi-composer-content"
                                  class="fi-composer__textarea"
                                  placeholder="Développez votre idée, votre question ou votre annonce..."
                                  required></textarea>

                        {# ── Image (optionnelle) ─────────────────────────────────
                           Même champ que sur la page "Nouveau sujet". name="image" est
                           lu par ForumController::quickPost() ($request->files->get('image')).
                           La validation (type MIME, 5 Mo) est faite côté serveur.
                        #}
                        <label for="fi-composer-image" class="fi-composer__file-label">
                            Image (optionnel) — JPEG, PNG, WebP ou GIF, 5 Mo max
                        </label>
                        <input type="file"
                               name="image"
                               id="fi-composer-image"
                               class="fi-composer__file"
                               accept="image/jpeg,image/png,image/webp,image/gif">

                    </form>

                </div>{# fin fi-composer__form-area #}

                {# ── JS vanilla — ouverture / fermeture du compositeur ───────
                   fiComposerOpen()  : affiche le formulaire, masque le placeholder.
                   fiComposerClose() : inverse, reset du formulaire.
                   Déclaré en window.* pour être appelable depuis les onclick HTML.
                #}
                <script>
                (function () {
                    'use strict';

                    /**
                     * Ouvre le compositeur inline.
                     *
                     * 1. Retire l'attribut `hidden` des éléments [data-show-when-open]
                     *    (libellé "Nouveau post..." + bouton Annuler + zone formulaire).
                     * 2. Ajoute `hidden` sur les éléments [data-hide-when-open]
                     *    (placeholder texte).
                     * 3. Met le focus sur le champ Titre.
                     *
                     * Note : il n'y a plus de quick-select à synchroniser —
                     * la catégorie est choisie une seule fois, dans le formulaire.
                     */
                    window.fiComposerOpen = function () {
                        var composer = document.getElementById('fi-composer');
                        if (!composer) { return; }

                        // Afficher les éléments "open only" (label + annuler + formulaire)
                        composer.querySelectorAll('[data-show-when-open]').forEach(function (el) {
                            el.hidden = false;
                        });

                        // Masquer les éléments "collapsed only" (placeholder)
                        composer.querySelectorAll('[data-hide-when-open]').forEach(function (el) {
                            el.hidden = true;
                        });

                        // Focus sur le champ titre pour que l'utilisateur commence à taper
                        var titleField = document.getElementById('fi-composer-title');
                        if (titleField) {
                            titleField.focus();
                        }
                    };

                    /**
                     * Ferme le compositeur sans soumettre.
                     *
                     * 1. Remet `hidden` sur les éléments [data-show-when-open].
                     * 2. Retire `hidden` des éléments [data-hide-when-open].
                     * 3. Réinitialise le formulaire (vide titre + contenu).
                     */
                    window.fiComposerClose = function () {
                        var composer = document.getElementById('fi-composer');
                        if (!composer) { return; }

                        // Masquer les éléments "open only"
                        composer.querySelectorAll('[data-show-when-open]').forEach(function (el) {
                            el.hidden = true;
                        });

                        // Réafficher les éléments "collapsed only"
                        composer.querySelectorAll('[data-hide-when-open]').forEach(function (el) {
                            el.hidden = false;
                        });

                        // Reset du formulaire : vide les champs pour la prochaine ouverture
                        var form = document.getElementById('fi-composer-form');
                        if (form) {
                            form.reset();
                        }
                    };

                }());
                </script>

            {% else %}

                {# Aucune catégorie configurée par l'admin : compositeur désactivé #}
                <div class="fi-composer__top-bar">
                    <div class="fi-composer__avatar" aria-hidden="true">
                        {% if app.user %}
                            {{ app.user.email|split('@')|first|slice(0,1)|upper }}
                        {% else %}
                            ?
                        {% endif %}
                    </div>
                    <span class="fi-composer__placeholder" style="opacity:.5">
                        Aucune categorie disponible pour l'instant.
                    </span>
                </div>

            {% endif %}

        </div>{# fin fi-composer #}

        {# Liste des threads #}
        <div class="fi-thread-list" role="list">

            {#
                `threads` est passé par ForumController::index() — liste plate des 20
                threads les plus récents, toutes catégories confondues, triés par
                updatedAt DESC (activité récente en tête).

                On l'utilise directement sans reconstruire via `merge` catégorie par
                catégorie. Le tri est désormais garanti par la BDD (ORDER BY updatedAt DESC),
                non plus par l'ordre de parcours des catégories dans la boucle PHP.

                Rétro-compatibilité : si `threads` n'est pas défini (appel legacy ou
                test unitaire sans le controller), on repasse sur un tableau vide.
            #}
            {% set allThreads = threads is defined ? threads : [] %}

            {% if allThreads is empty %}

                {# Etat vide : aucun thread dans aucune catégorie #}
                <div class="fi-feed-empty" role="status">
                    Pas encore de discussion. Soyez le premier !
                </div>

            {% else %}

                {% for thread in allThreads %}

                    {#
                        Chaque carte est un <a> complet cliquable.
                        La grille 2 colonnes (rail de vote | contenu) est gérée par CSS.
                        La border-top n'est ajoutée que sur la toute première carte
                        via la variable Twig `loop.first`.
                    #}
                    <a href="{{ path('app_forum_thread', { categorySlug: thread.category.slug, threadSlug: thread.slug }) }}"
                       class="fi-thread-card{% if loop.first %} fi-thread-card--first{% endif %}"
                       role="listitem"
                       aria-label="{{ thread.title }}">

                        {# Rail gauche : compteur dénormalisé (repliesCount en V1 = activité) #}
                        <div class="fi-thread-card__vote" aria-hidden="true">
                            <span class="fi-vote-arrow">&#9650;</span>
                            <span class="fi-vote-count">{{ thread.repliesCount }}</span>
                            <span class="fi-vote-arrow fi-vote-arrow--down">&#9660;</span>
                        </div>

                        {# Contenu principal du thread #}
                        <div class="fi-thread-card__body">

                            {# Ligne de méta : auteur, date, badge catégorie #}
                            <div class="fi-thread-card__meta">
                                {#
                                    Nom d'affichage : partie locale de l'email (avant @).
                                    Ex : "gaelle@bazaart.fr" → "gaelle"
                                    En V1, les profils n'ont pas forcément de username distinct.
                                #}
                                <span class="fi-thread-card__meta-item">
                                    {{ thread.author.email|split('@')|first }}
                                </span>

                                {# Séparateur visuel #}
                                <span class="fi-thread-card__meta-item" aria-hidden="true">·</span>

                                {# Date de création du thread #}
                                <span class="fi-thread-card__meta-item">
                                    {{ thread.createdAt|date('d M Y') }}
                                </span>

                                {# Badge catégorie : chip bord encre #}
                                <span class="fi-cat-chip">{{ thread.category.name }}</span>

                                {# Indicateur épinglé si applicable #}
                                {% if thread.isPinned %}
                                    <span class="fi-cat-chip" title="Epingle" aria-label="Epingle">
                                        EPINGLE
                                    </span>
                                {% endif %}

                                {# Indicateur verrouillé si applicable #}
                                {% if thread.isLocked %}
                                    <span class="fi-cat-chip" title="Verrouille" aria-label="Verrouille">
                                        FERME
                                    </span>
                                {% endif %}
                            </div>

                            {# Titre en Archivo Black #}
                            <h2 class="fi-thread-card__title">{{ thread.title }}</h2>

                            {#
                                Extrait du contenu tronqué à 120 caractères.
                                thread.content → getContent() de ForumThread (champ 'content', type text).
                                On utilise le filtre Twig |slice pour tronquer proprement.
                            #}
                            {% if thread.content %}
                                {#
                                    |striptags avant |slice : si le contenu contient du HTML
                                    (éditeur riche), tronquer à 120 caractères sans enlever les tags
                                    risque de couper en milieu de balise → markup malformé.
                                    striptags produit du texte brut propre avant la troncature.
                                #}
                                <p class="fi-thread-card__excerpt">
                                    {{- thread.content|striptags|slice(0, 120) -}}
                                    {%- if thread.content|striptags|length > 120 %}...{% endif %}
                                </p>
                            {% endif %}

                            {# Vignette si le sujet a une image jointe (servie par PHP, cf. ADR-0011) #}
                            {% if thread.imagePath %}
                                <div class="fi-thread-card__thumb">
                                    <img src="{{ path('app_forum_image', {type: 'thread', id: thread.id}) }}"
                                         alt="" loading="lazy">
                                </div>
                            {% endif %}

                            {# Méta basse : réponses et vues #}
                            <div class="fi-thread-card__stats">
                                {{ thread.repliesCount }} reponse{{ thread.repliesCount > 1 ? 's' : '' }}
                                ·
                                {{ thread.viewsCount }} vue{{ thread.viewsCount > 1 ? 's' : '' }}
                            </div>

                        </div>{# fin fi-thread-card__body #}

                    </a>{# fin fi-thread-card #}

                {% endfor %}{# fin for thread in allThreads #}

            {% endif %}

        </div>{# fin fi-thread-list #}

    </div>{# fin fi-col-feed #}

    {# ════════════════════════════════════════════════════════════════════════
       COLONNE DROITE — SIDEBAR
       1. Regle de base (fond accent lime)
       2. Hot du jour (4 premiers threads du feed)
       3. Lives a venir (si la variable upcomingLives est définie)
    ════════════════════════════════════════════════════════════════════════ #}
    <div class="fi-col-sidebar">

        {# ── 1. Règle de base ── #}
        <div class="fi-sidebar-rule">
            <div class="fi-sidebar-rule__label">REGLE DE BASE</div>
            <p class="fi-sidebar-rule__text">
                Pas de pub deguisee. Pas de spam. On reste entre nous.
            </p>
        </div>

        {# ── 2. Hot du jour ── #}
        <div class="fi-sidebar-block">
            <div class="fi-sidebar-block__header">HOT DU JOUR</div>

            {#
                On affiche les 4 premiers threads toutes catégories confondues.
                "Hot" en V1 = les premiers chargés (tri par date/activité géré
                par le repository). Pas de score de "hotness" distinct en V1.
                En V2 : ajouter un champ `hotScore` ou trier par
                (repliesCount * 2 + viewsCount) sur 24h.

                On réutilise `allThreads` construit dans la colonne centrale
                (variable Twig disponible dans le même block {% content %}).
                |slice(0, 4) extrait les 4 premiers éléments.
            #}
            {% if allThreads is defined and allThreads is not empty %}
                {% for thread in allThreads|slice(0, 4) %}
                    <a href="{{ path('app_forum_thread', { categorySlug: thread.category.slug, threadSlug: thread.slug }) }}"
                       class="fi-hot-item">
                        <div class="fi-hot-item__title">{{ thread.title }}</div>
                        <div class="fi-hot-item__meta">
                            {{ thread.repliesCount }} reponse{{ thread.repliesCount > 1 ? 's' : '' }}
                        </div>
                    </a>
                {% endfor %}
            {% else %}
                <div class="fi-sidebar-empty">
                    Aucune discussion pour l'instant.
                </div>
            {% endif %}

        </div>{# fin fi-sidebar-block hot #}

        {#
            NOTE V1 : le bloc "LIVES A VENIR" a été retiré de la sidebar.
            La fonctionnalité Lives est reportée en V2 (cf. CDC V3 section 4).
        #}

    </div>{# fin fi-col-sidebar #}

</div>{# fin fi-grid #}

</div>{# fin fi-wrapper #}

{# ── JS VANILLA — GESTION DES ONGLETS ─────────────────────────────────────────
   Comportement : cliquer sur un onglet le marque comme actif (fond encre,
   texte accent) et retire la classe active des autres.
   En V1 : aucun filtrage de contenu — uniquement le feedback visuel.
   En V2 : brancher du filtrage AJAX ou Turbo Frames ici.
#}
<script>
    (function () {
        // On cible tous les boutons de la tab bar
        const tabs = document.querySelectorAll('.fi-tab');

        tabs.forEach(function (tab) {
            tab.addEventListener('click', function () {
                // Retire la classe active + met aria-selected=false sur tous les onglets
                tabs.forEach(function (t) {
                    t.classList.remove('fi-tab--active');
                    t.setAttribute('aria-selected', 'false');
                });

                // Marque l'onglet cliqué comme actif
                tab.classList.add('fi-tab--active');
                tab.setAttribute('aria-selected', 'true');

                // En V1 : log uniquement (aucun filtrage)
                // En V2 : déclencher ici un filtre AJAX ou Turbo Frame
                // console.debug('[Forum] Onglet actif :', tab.dataset.tab);
            });
        });
    })();
</script>

{% endblock %}
