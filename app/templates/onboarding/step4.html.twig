{% extends 'base_app.html.twig' %}

{#
 # onboarding/step4.html.twig — Étape 4 : Statut juridique (Lot A matching)
 #
 # Variables transmises par OnboardingController::step4() :
 #   - legal_status_options  : LegalStatus[]   — tous les cas de l'enum
 #   - selected_legal_status : LegalStatus|null — valeur déjà choisie (retour en arrière)
 #
 # Cette étape est la DERNIÈRE du parcours d'onboarding.
 # Le statut juridique est OPTIONNEL : l'artiste peut finaliser sans le choisir.
 #
 # Changement Lot A : l'ancienne étape 4 "alertes ressources" est supprimée.
 # Les alertes deviendront un opt-in avec consentement dans le module matching (Lot C).
#}

{% block title %}Ton statut juridique — Étape 4{% endblock %}
{% block page_title %}Finalisation{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.ob-wrap { max-width: 620px; margin: 40px auto; padding: 0 16px; }

/* Progression */
.ob-progress { display: flex; align-items: center; gap: 6px; margin-bottom: 36px; }
.ob-step-dot { width: 28px; height: 4px; background: var(--line-soft, #ddd); }
.ob-step-dot--active { background: var(--accent); }
.ob-step-dot--done { background: var(--ink); }
.ob-progress__label {
    font-family: var(--mono); font-size: 10px; font-weight: 700;
    letter-spacing: .10em; text-transform: uppercase; color: var(--ink-mute); margin-left: 8px;
}

/* Titre */
.ob-title {
    font-family: var(--display); font-size: clamp(24px, 4vw, 38px); font-weight: 400;
    text-transform: uppercase; letter-spacing: -.02em; line-height: .95;
    color: var(--ink); margin: 0 0 8px;
}
.ob-title .it {
    font-family: var(--serif); font-style: italic;
    text-transform: none; font-weight: 400; color: var(--accent-2, #FF6B2C);
}
.ob-subtitle { font-size: 14px; color: var(--ink-mute); margin: 0 0 32px; line-height: 1.5; }

/* Liste des options de statut (radio buttons stylisés) */
.ob-options { display: flex; flex-direction: column; gap: 0; margin-bottom: 24px; }

.ob-option-item input[type="radio"] {
    position: absolute; opacity: 0; width: 0; height: 0;
}
.ob-option-item label {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 16px 20px;
    border: 1px solid var(--line-soft);
    border-bottom: none;
    cursor: pointer; font-size: 14px; color: var(--ink); line-height: 1.4;
    transition: background .10s;
}
.ob-option-item:last-child label { border-bottom: 1px solid var(--line-soft); }
.ob-option-item label:hover { background: var(--bg-alt); }
.ob-option-item input:checked + label {
    background: var(--accent); border-color: var(--ink); font-weight: 600;
}

/* Radio visuel personnalisé (cercle) */
.ob-radio-visual {
    width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px;
    border: 2px solid var(--ink); border-radius: 50%; background: var(--bg);
    display: flex; align-items: center; justify-content: center;
}
.ob-radio-dot {
    display: none; width: 8px; height: 8px;
    background: var(--ink); border-radius: 50%;
}
.ob-option-item input:checked + label .ob-radio-dot { display: block; }
.ob-option-item input:checked + label .ob-radio-visual { background: var(--bg); }

/* Bouton "passer" (skip) — discret */
.ob-skip-link {
    display: block; text-align: center; margin-bottom: 16px;
    font-family: var(--mono); font-size: 11px; color: var(--ink-mute);
    text-decoration: underline; cursor: pointer;
    background: none; border: none; padding: 0; width: 100%;
    letter-spacing: .04em; text-transform: uppercase;
}
.ob-skip-link:hover { color: var(--ink); }

/* Bouton de finalisation (style distinct = action principale) */
.ob-btn-finish {
    font-family: var(--display); font-size: 14px; font-weight: 400;
    text-transform: uppercase; letter-spacing: .06em;
    padding: 16px 40px; background: var(--accent); color: var(--ink);
    border: 2px solid var(--ink); cursor: pointer; border-radius: 0;
    transition: background .12s, color .12s; flex: 1; text-align: center;
}
.ob-btn-finish:hover { background: var(--ink); color: var(--accent); }

/* Bouton retour */
.ob-btn-back {
    font-family: var(--mono); font-size: 11px; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    padding: 12px 20px; background: transparent; color: var(--ink-mute);
    border: 1px solid var(--line-soft); cursor: pointer; border-radius: 0;
    text-decoration: none; transition: border-color .12s, color .12s;
}
.ob-btn-back:hover { color: var(--ink); border-color: var(--ink); }

.ob-actions {
    display: flex; align-items: center; justify-content: space-between;
    gap: 12px; margin-top: 24px;
}

/* Note finale */
.ob-final-note {
    text-align: center; margin-top: 20px; padding: 18px;
    background: var(--bg-alt); border: 1px solid var(--line-soft);
    font-size: 13px; color: var(--ink-mute); line-height: 1.6;
}

/* Badge optionnel */
.ob-optional-badge {
    display: inline-block;
    font-family: var(--mono); font-size: 9px; font-weight: 700;
    letter-spacing: .08em; text-transform: uppercase;
    background: var(--bg-alt); border: 1px solid var(--line-soft);
    color: var(--ink-mute); padding: 2px 7px; vertical-align: middle;
    margin-left: 8px;
}
</style>
{% endblock %}

{% block content %}
<div class="ob-wrap">

    {# Progression — étape 4 active (dernière) #}
    <div class="ob-progress" aria-label="Étape 4 sur 4, dernière étape">
        <div class="ob-step-dot ob-step-dot--done" title="Étape 1 : Type de compte"></div>
        <div class="ob-step-dot ob-step-dot--done" title="Étape 2 : Profil"></div>
        <div class="ob-step-dot ob-step-dot--done" title="Étape 3 : Que recherches-tu ?"></div>
        <div class="ob-step-dot ob-step-dot--active" title="Étape 4 : Statut juridique"></div>
        <span class="ob-progress__label">Étape 4 / 4</span>
    </div>

    <h1 class="ob-title">
        Ton <span class="it">statut</span>
        <span class="ob-optional-badge">optionnel</span>
    </h1>
    <p class="ob-subtitle">
        Ton statut juridique nous permet de te proposer les opportunites auxquelles tu es eligible
        (certaines bourses ou residences sont reservees a un statut precis).
        Tu peux passer cette etape et la renseigner plus tard.
    </p>

    <form method="POST" action="{{ path('app_onboarding_step4') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('onboarding_step4') }}">

        {#
            Inclusion du partial réutilisable legalStatus.
            field_prefix vide → IDs "ls_{value}" (comportement historique conservé).
            show_skip_note: false → la note "optionnel" est dans le sous-titre plus haut.
        #}
        {% include 'matching/_step_legal_status.html.twig' with {
            legal_status_options:  legal_status_options,
            selected_legal_status: selected_legal_status,
            field_prefix:          '',
            show_skip_note:        false
        } %}

        {# ── Navigation ────────────────────────────────────────────────── #}
        <div class="ob-actions">
            <a href="{{ path('app_onboarding_step3') }}" class="ob-btn-back">
                Retour
            </a>
            <button type="submit" class="ob-btn-finish">
                Finaliser mon profil
            </button>
        </div>

        {#
          Lien "passer cette etape" — réinitialise le champ radio avant de soumettre.
          Implémenté en JS natif : on décoche tous les radios puis on soumet le formulaire.
          Cela envoie un POST sans valeur legal_status, ce qui sera traité comme null
          dans OnboardingStep4MatchingDTO::fromRequest() (statut non renseigné = OK).
        #}
        <button type="button" class="ob-skip-link" id="btn-skip-step4">
            Passer cette etape (je ne sais pas encore)
        </button>

    </form>

    <div class="ob-final-note">
        C'est la derniere etape. Tu pourras renseigner ou modifier ton statut juridique
        a tout moment depuis ton espace personnel.
    </div>

</div>

{% block javascripts %}
{{ parent() }}
<script>
(function () {
    'use strict';

    // Bouton "passer cette étape" : décoche les radios et soumet le formulaire.
    // On obtient ainsi un POST avec legal_status vide → null en PHP → stocké null en BDD.
    var btnSkip = document.getElementById('btn-skip-step4');

    if (!btnSkip) {
        return;
    }

    btnSkip.addEventListener('click', function () {
        // Décocher tous les radios du groupe legal_status
        var radios = document.querySelectorAll('input[name="legal_status"]');
        radios.forEach(function (radio) {
            radio.checked = false;
        });

        // Soumettre le formulaire sans valeur sélectionnée
        // Le formulaire parent du bouton est la balise <form> englobante
        var form = btnSkip.closest('form');
        if (form) {
            form.submit();
        }
    });
}());
</script>
{% endblock %}
{% endblock %}
