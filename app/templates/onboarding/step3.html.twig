{% extends 'base_app.html.twig' %}

{#
 # onboarding/step3.html.twig — Étape 3 : Que recherches-tu ?
 #
 # Variables transmises par OnboardingController::step3() :
 #   - looking_for_options : ArtistLookingFor[]  — tous les cas de l'enum
 #   - selected_values     : string[]             — valeurs déjà cochées (retour arrière)
 #   - looking_for_other   : string|null          — texte libre déjà saisi
 #   - error               : string|null          — message d'erreur
 #
 # L'option "Autre" ouvre un champ texte via JavaScript (JS natif, sans framework).
#}

{% block title %}Que recherches-tu ? — Étape 3{% endblock %}
{% block page_title %}Tes objectifs{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.ob-wrap { max-width: 620px; margin: 40px auto; padding: 0 16px; }

/* Progression */
.ob-progress { display: flex; align-items: center; gap: 6px; margin-bottom: 36px; }
.ob-step-dot { width: 28px; height: 4px; background: var(--line-soft, #ddd); }
.ob-step-dot--active { background: var(--accent); }
.ob-step-dot--done { background: var(--ink); }
.ob-progress__label {
    font-family: var(--mono); font-size: 10px; font-weight: 700;
    letter-spacing: .10em; text-transform: uppercase; color: var(--ink-mute); margin-left: 8px;
}

/* Titre */
.ob-title {
    font-family: var(--display); font-size: clamp(24px, 4vw, 38px); font-weight: 400;
    text-transform: uppercase; letter-spacing: -.02em; line-height: .95;
    color: var(--ink); margin: 0 0 8px;
}
.ob-title .it {
    font-family: var(--serif); font-style: italic;
    text-transform: none; font-weight: 400; color: var(--accent-2, #FF6B2C);
}
.ob-subtitle { font-size: 14px; color: var(--ink-mute); margin: 0 0 32px; line-height: 1.5; }

/* Liste des options */
.ob-options { display: flex; flex-direction: column; gap: 0; margin-bottom: 24px; }

.ob-option-item input[type="checkbox"] {
    position: absolute; opacity: 0; width: 0; height: 0;
}
.ob-option-item label {
    display: flex; align-items: flex-start; gap: 14px;
    padding: 18px 20px;
    border: 1px solid var(--line-soft);
    border-bottom: none;
    cursor: pointer; font-size: 14px; color: var(--ink); line-height: 1.4;
    transition: background .10s;
}
.ob-option-item:last-child label { border-bottom: 1px solid var(--line-soft); }
.ob-option-item label:hover { background: var(--bg-alt); }

.ob-option-item input:checked + label {
    background: var(--accent); border-color: var(--ink); font-weight: 600;
}

/* Case visuelle à gauche */
.ob-checkbox-visual {
    width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px;
    border: 2px solid var(--ink); background: var(--bg);
    display: flex; align-items: center; justify-content: center;
    transition: background .10s;
}
.ob-option-item input:checked + label .ob-checkbox-visual {
    background: var(--ink);
}
.ob-check-icon { display: none; }
.ob-option-item input:checked + label .ob-check-icon { display: block; }

/* Champ libre "Autre" — caché par défaut, affiché par JS */
#autre-field {
    display: none;
    margin-top: 12px;
    border-left: 3px solid var(--accent);
    padding-left: 16px;
}
#autre-field.visible { display: block; }

.ob-input {
    width: 100%; box-sizing: border-box;
    border: 1px solid var(--ink); background: var(--bg);
    color: var(--ink); font-family: var(--body); font-size: 14px;
    padding: 10px 12px; border-radius: 0;
}
.ob-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px rgba(255, 203, 16,.3); }

.ob-label {
    display: block; font-family: var(--mono); font-size: 10px; font-weight: 700;
    letter-spacing: .10em; text-transform: uppercase; color: var(--ink-mute); margin-bottom: 6px;
}

/* Actions */
.ob-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.ob-btn-back {
    font-family: var(--mono); font-size: 11px; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    padding: 12px 20px; background: transparent; color: var(--ink-mute);
    border: 1px solid var(--line-soft); cursor: pointer; border-radius: 0;
    text-decoration: none; transition: border-color .12s, color .12s;
}
.ob-btn-back:hover { color: var(--ink); border-color: var(--ink); }
.ob-btn-next {
    font-family: var(--display); font-size: 13px; font-weight: 400;
    text-transform: uppercase; letter-spacing: .04em;
    padding: 14px 40px; background: var(--ink); color: var(--bg);
    border: 1px solid var(--ink); cursor: pointer; border-radius: 0;
    transition: background .12s, color .12s; flex: 1; text-align: center;
}
.ob-btn-next:hover { background: var(--accent); color: var(--ink); }

.ob-error {
    background: #fff0f0; border: 1px solid #c00; color: #c00;
    padding: 10px 14px; font-size: 13px; margin-bottom: 20px; border-radius: 0;
}
</style>
{% endblock %}

{% block content %}
<div class="ob-wrap">

    {# Progression — 4 étapes ; étape 3 active #}
    <div class="ob-progress" aria-label="Étape 3 sur 4">
        <div class="ob-step-dot ob-step-dot--done" title="Étape 1 : Type de compte"></div>
        <div class="ob-step-dot ob-step-dot--done" title="Étape 2 : Profil"></div>
        <div class="ob-step-dot ob-step-dot--active" title="Étape 3 : Que recherches-tu ?"></div>
        <div class="ob-step-dot" title="Étape 4 : Statut juridique"></div>
        <span class="ob-progress__label">Étape 3 / 4</span>
    </div>

    <h1 class="ob-title">Que <span class="it">recherches-tu</span> ?</h1>
    <p class="ob-subtitle">
        Coche tout ce qui correspond a tes besoins.
        Ces informations permettront de personnaliser les opportunites qui te sont proposees.
    </p>

    {% if error %}
        <div class="ob-error" role="alert">{{ error }}</div>
    {% endif %}

    <form method="POST" action="{{ path('app_onboarding_step3') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('onboarding_step3') }}">

        {#
            Inclusion du partial réutilisable lookingFor.
            field_prefix vide → les ids générés sont "lf_{value}" et "autre-field",
            identiques aux ids historiques (rétrocompatibilité JS onboarding/step3).
        #}
        {% include 'matching/_step_looking_for.html.twig' with {
            looking_for_options: looking_for_options,
            selected_values:     selected_values,
            looking_for_other:   looking_for_other,
            field_prefix:        ''
        } %}

        <div class="ob-actions" style="margin-top: 32px;">
            <a href="{{ path('app_onboarding_step2') }}" class="ob-btn-back">Retour</a>
            <button type="submit" class="ob-btn-next">Continuer</button>
        </div>

    </form>
</div>

{#
 # Script JS natif : afficher/masquer le champ "Autre" selon la case cochée.
 # On écoute l'événement 'change' sur la case "autre" et on toggle la classe
 # 'visible' sur le div #autre-field.
 # Aucune dépendance externe — JS pur (<script> dans le block, pas dans le <head>).
#}
{% block javascripts %}
{{ parent() }}
<script>
(function () {
    'use strict';

    /*
     * Script d'onboarding step3 — Toggle du champ "Autre"
     *
     * Le partial matching/_step_looking_for.html.twig utilise les classes
     * .mf-cb-autre, .mf-autre-field et .mf-other-input pour rendre ce toggle
     * réutilisable (indépendant des IDs qui varient selon le field_prefix).
     *
     * Ici, field_prefix est vide → les IDs sont "lf_autre", "autre-field",
     * "looking_for_other" (comportement historique conservé).
     * On cible par classe pour la cohérence avec le formulaire home.
     */

    // On cherche par classe dans ce formulaire (compatibilité avec le partial)
    var form = document.querySelector('form[action*="onboarding"]') || document.forms[0];
    if (!form) { return; }

    var cbAutre    = form.querySelector('.mf-cb-autre');
    var autreField = form.querySelector('.mf-autre-field');
    var autreInput = form.querySelector('.mf-other-input');

    if (!cbAutre || !autreField) {
        return; // Sécurité : éléments absents
    }

    function toggleAutreField() {
        if (cbAutre.checked) {
            autreField.classList.add('visible');
            if (autreInput) { autreInput.setAttribute('required', 'required'); }
        } else {
            autreField.classList.remove('visible');
            if (autreInput) {
                autreInput.removeAttribute('required');
                autreInput.value = '';
            }
        }
    }

    cbAutre.addEventListener('change', toggleAutreField);

    // Initialisation au chargement (pré-remplissage si case déjà cochée)
    toggleAutreField();
}());
</script>
{% endblock %}
{% endblock %}
