{#
 # _partials/bottom_nav.html.twig — Barre de navigation basse (mobile) pour utilisateur connecté
 #
 # Affichée sur TOUTES les pages de la plateforme (sauf dashboard et admin, qui
 # ont déjà leur propre barre) dès que l'utilisateur est connecté.
 #
 # Inclus via {% block bottom_nav %} dans base.html.twig.
 #   - base_dashboard.html.twig neutralise ce block (il a déjà sa .sd-side).
 #   - base_admin.html.twig le neutralise aussi (back-office).
 #
 # Pattern "bottom tab bar" (iOS/Android) : visible UNIQUEMENT en mobile (< 768px).
 # Sur desktop, la navigation principale (top nav) suffit → la barre est masquée.
 #
 # Cohérence visuelle avec la barre basse du dashboard (.sd-side mobile) :
 #   fond --ink, 60px de haut, icône au-dessus d'un label court, indicateur actif doré.
 #}
{% set route = app.request.attributes.get('_route') %}

{#
    Barre du bas IDENTIQUE à la sidebar du dashboard : MÊMES 9 onglets, MÊME ordre,
    MÊMES icônes. Objectif : une seule et unique navigation (plus de "deux navbars
    différentes"). La barre défile horizontalement si les onglets dépassent.
#}
<nav class="ubn" aria-label="Navigation rapide">

    {# 1. Tableau de bord — app_dashboard (redirige les admins vers leur dashboard) #}
    <a href="{{ path('app_dashboard') }}"
       class="ubn__link {{ route == 'app_dashboard' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 11 12 4l9 7v9h-6v-6h-6v6H3z"/>
        </svg>
        Espace
    </a>

    {# 2. Profil public artiste #}
    <a href="{{ path('app_artist_profile_show') }}"
       class="ubn__link {{ route == 'app_artist_profile_show' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="8" r="4"/>
            <path d="M4 21a8 8 0 0 1 16 0"/>
        </svg>
        Profil
    </a>

    {# 3. Messagerie privée #}
    <a href="{{ path('app_messaging_index') }}"
       class="ubn__link {{ route starts with 'app_messaging_' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M22 11.4a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L4 21l1.9-5.7a8.5 8.5 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9 8.5 8.5 0 0 1 8.5 8.5z"/>
        </svg>
        Messages
    </a>

    {# 4. Opportunités (ressources publiées) #}
    <a href="{{ path('app_resource_index') }}"
       class="ubn__link {{ route starts with 'app_resource' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18z"/>
        </svg>
        Opps
    </a>

    {# 5. Forum communautaire #}
    <a href="{{ path('app_forum_index') }}"
       class="ubn__link {{ route starts with 'app_forum_' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
        </svg>
        Forum
    </a>

    {# 6. Articles & Blog #}
    <a href="{{ path('app_article_index') }}"
       class="ubn__link {{ route starts with 'app_article_' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>
        Articles
    </a>

    {# 7. Notifications — badge de non-lus (même fonction Twig que la sidebar dashboard) #}
    {% set ubnUnread = unread_notifications_count() %}
    <a href="{{ path('app_notification_index') }}"
       class="ubn__link {{ route == 'app_notification_index' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 8a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6"/>
            <path d="M10 18a2 2 0 0 0 4 0"/>
        </svg>
        Notifs
        {% if ubnUnread > 0 %}
            <span class="ubn__badge" aria-label="{{ ubnUnread }} notification(s) non lue(s)">
                {{ ubnUnread > 9 ? '9+' : ubnUnread }}
            </span>
        {% endif %}
    </a>

    {# 8. Mes données (RGPD) #}
    <a href="{{ path('app_rgpd_index') }}"
       class="ubn__link {{ route starts with 'app_rgpd_' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        Donn&eacute;es
    </a>

    {# 9. Paramètres — édition du profil artiste #}
    <a href="{{ path('app_artist_profile_edit') }}"
       class="ubn__link {{ route == 'app_artist_profile_edit' ? 'ubn__link--active' : '' }}">
        <svg class="ubn__icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
        </svg>
        R&eacute;glages
    </a>

</nav>

{#
    CSS scoppé (.ubn-*). Placé dans le partial pour n'être chargé QUE lorsque la
    barre est rendue (utilisateur connecté, hors dashboard/admin). Cohérent avec
    le reste du code (styles inline déjà utilisés partout, CSP les autorise).
#}
<style>
    /* Masquée par défaut (desktop) : la top nav suffit sur grand écran. */
    .ubn { display: none; }

    @media (max-width: 767px) {
        /* Barre fixe en bas de l'écran, façon bottom tab bar mobile. */
        .ubn {
            display: flex;
            position: fixed;
            left: 0;
            right: 0;
            bottom: 0;
            z-index: 900;
            height: 60px;
            background: var(--ink, #0D0D0D);
            border-top: 1px solid rgba(242, 239, 230, .2);
            overflow-x: auto;
            overflow-y: hidden;
        }
        /* Chaque onglet : icône au-dessus d'un label court. */
        .ubn__link {
            flex: 1 0 auto;
            min-width: 64px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            padding: 6px 8px;
            color: var(--bg, #F2EFE6);
            text-decoration: none;
            font-size: 9px;
            letter-spacing: .03em;
            white-space: nowrap;
            border-top: 2px solid transparent;
            position: relative;
        }
        .ubn__icon {
            width: 20px;
            height: 20px;
            fill: none;
            stroke: currentColor;
            stroke-width: 1.6;
            stroke-linecap: round;
            stroke-linejoin: round;
        }
        /* Onglet actif : texte + indicateur haut en jaune doré (charte). */
        .ubn__link--active {
            color: var(--accent, #FFCB10);
            border-top-color: var(--accent, #FFCB10);
        }
        /* Badge de notifications non lues (orange charte). */
        .ubn__badge {
            position: absolute;
            top: 5px;
            right: 14px;
            min-width: 15px;
            height: 15px;
            padding: 0 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--accent-2, #FF6B2C);
            color: #fff;
            font-size: 8px;
            font-weight: 700;
            border-radius: 8px;
            line-height: 1;
        }
        /* On réserve la hauteur de la barre en bas du contenu (anti-recouvrement). */
        body {
            padding-bottom: 60px;
        }
    }
</style>
